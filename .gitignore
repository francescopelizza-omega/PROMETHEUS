__pycache__/
*.py[cod]
.venv/
venv/
# `env/` unanchored also swallowed studio/packages/ui/src/env/ — 10 real source files,
# which made a fresh clone fail to typecheck. Anchor it: a stray root-level virtualenv is
# ignored, nested `.venv`/`venv` are covered above, and source dirs named `env` are safe.
/env/
node_modules/
dist/
build/
# electron-builder's buildResources (icons, entitlements, the afterPack + notarize hooks)
# live in a dir literally named `build/`. Without these a packaged app has no icon, no
# entitlements, and no exec bit on the node-pty spawn-helper ("No terminal backend").
!studio/apps/desktop/build/
out/
.next/
.turbo/
.cache/
.parcel-cache/
coverage/
*.so
*.log
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
.idea/

# scan reports go stale and are regenerated by scripts/secret-scan.sh — the CONFIG
# (.gitleaks.toml) is the durable artifact, not the output.
/.security/

# --- internal working documents: never in the published repo ------------------
# Plans, audits and diagnostic reports are notes to ourselves. They name internal
# paths, unfixed defects and release timing — useful here, a liability in public.
# Root-anchored so product docs (README.md, studio/*/README.md, PRIVACY.md,
# python/sidecar/CONTRACT.md) are untouched. New working notes: name them
# `<TOPIC>-PLAN.md` / `<TOPIC>-REPORT.md` / `<TOPIC>-AUDIT.md` at the root, or drop
# them in /notes/, and they stay out automatically.
/*-PLAN.md
/*-REPORT.md
/*-AUDIT.md
/*-NOTES.md
/DEPLOYMENT-PLAN.md
/SLASH-COMMANDS-REPORT.md
/notes/
/all_wrongs_*.md
# Design/GUI-redesign handoff notes: internal reasoning, exact token values, and (in the
# bundled reference-prototype.html mockups) placeholder demo data that has named other,
# unrelated private projects. Never in the published repo — mirrored to ALPHA_local_only
# instead of deleted, since the content itself has ongoing value as design reference.
/handoff*/
studio/notes.txt
# NOT ignored, deliberately: THIRD-PARTY-NOTICES.md. It is a redistribution
# obligation under Apache-2.0 §4(d) and the PSF license of the bundled CPython —
# it must ship WITH the code, not be stripped from it.

# working notes / debug leftovers that have no business in a public repo
curl.trace
resume.txt

# runtime session logs from running/testing the desktop app locally — regenerated on
# every run, not source; a real `.prometheus/` PROJECT config (settings.json, command/,
# agents/) would be a deliberate, separate thing this rule does not need to hide since
# none exists in this repo today.
studio/**/.prometheus/

# Claude Code runtime state (never commit)
.claude/scheduled_tasks.lock
.claude/*.lock

# --- local-only (kept on disk, never in remote) ---
/MDS/
/AI_SKILLS_WONDERLAND/
.claude/
.cursor/
.windsurf/
.clinerules/
.opencode/
.junie/
.agents/
/docs/plan/
/docs/interface/

# 2-second RAM trace written by handoffs/ram-2sec-log.sh — machine-local evidence,
# regenerated per session, never published.
/2_sec_ram_log.md
