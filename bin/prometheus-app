#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Francesco Pelizza
# prometheus-app — launch Prometheus Studio, the Electron desktop app.
#
# Resolution order (first hit wins), so the command means the same thing whether the
# user installed a release or is working in a checkout:
#
#   1. $PROMETHEUS_APP            — an explicit app bundle / AppImage / executable
#   2. an INSTALLED app           — /Applications, ~/Applications, /opt, PATH
#   3. a LOCAL BUILD              — <checkout>/studio/apps/desktop/release/...
#   4. the dev server             — electron-vite preview, when the sources are present
#
# Usage:
#   prometheus-app [--where] [--build] [--dev] [--wait] [-- <args passed to the app>]
#
#   --where   print the resolved app path and exit (nothing is launched)
#   --build   build/package the desktop app from source first
#   --dev     skip the packaged app and run the dev server directly
#   --wait    stay in the foreground until the app exits (macOS: `open -W`)
set -eu

# ── resolve this script's real directory (see bin/prometheus for the why) ─────
self=$0
hops=0
while [ -L "$self" ]; do
  hops=$((hops + 1))
  if [ "$hops" -gt 40 ]; then
    echo "prometheus-app: symlink loop while resolving $0" >&2
    exit 1
  fi
  target=$(readlink "$self")
  case $target in
  /*) self=$target ;;
  *) self=$(dirname -- "$self")/$target ;;
  esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
ROOT=$(CDPATH= cd -- "$BIN_DIR/.." && pwd -P)
DESKTOP=$ROOT/studio/apps/desktop

WHERE=0
BUILD=0
DEV=0
WAIT=0
while [ $# -gt 0 ]; do
  case $1 in
  --where) WHERE=1 ;;
  --build) BUILD=1 ;;
  --dev) DEV=1 ;;
  --wait | -W) WAIT=1 ;;
  --) shift; break ;;
  -h | --help)
    # the header comment verbatim, stopping at the first line of actual code
    sed -n '2,${/^[^#]/q; s/^# \{0,1\}//p;}' "$self"
    exit 0
    ;;
  *) break ;;
  esac
  shift
done

have_sources() { [ -f "$DESKTOP/package.json" ]; }

die() {
  echo "prometheus-app: $1" >&2
  exit "${2:-1}"
}

# ── build from source ─────────────────────────────────────────────────────────
if [ "$BUILD" -eq 1 ]; then
  have_sources || die "--build needs the sources; $DESKTOP not found"
  command -v pnpm >/dev/null 2>&1 || corepack enable >/dev/null 2>&1 || true
  command -v pnpm >/dev/null 2>&1 || die "pnpm not found — run \`corepack enable\` (Node >= 20)"
  echo "prometheus-app: packaging Prometheus Studio (this takes a few minutes)…"
  # `package` stages the engine + the relocatable CPython, then runs electron-builder.
  ( cd "$ROOT/studio" && pnpm install && pnpm run package )
fi

# ── find an app to launch ─────────────────────────────────────────────────────
APP=""
try() { [ -z "$APP" ] && [ -e "$1" ] && APP=$1; return 0; }

if [ "$DEV" -eq 0 ]; then
  # explicit `if` rather than `[ … ] && try …`: a failing left operand makes the whole
  # AND-list nonzero, and `set -e` handling of that differs between bash and dash.
  if [ -n "${PROMETHEUS_APP:-}" ]; then try "$PROMETHEUS_APP"; fi

  case $(uname -s) in
  Darwin)
    try "/Applications/Prometheus Studio.app"
    try "$HOME/Applications/Prometheus Studio.app"
    # local electron-builder output — arch-specific dir first, then the universal one
    for d in mac-arm64 mac-x64 mac mac-universal; do
      try "$DESKTOP/release/$d/Prometheus Studio.app"
    done
    ;;
  Linux)
    try "$HOME/.local/bin/Prometheus Studio.AppImage"
    try "/opt/Prometheus Studio/prometheus-studio"
    try "/usr/bin/prometheus-studio"
    if [ -z "$APP" ] && command -v prometheus-studio >/dev/null 2>&1; then
      APP=$(command -v prometheus-studio)
    fi
    for f in "$DESKTOP/release"/*.AppImage; do try "$f"; done
    try "$DESKTOP/release/linux-unpacked/prometheus-studio"
    ;;
  esac
fi

if [ "$WHERE" -eq 1 ]; then
  if [ -n "$APP" ]; then
    printf '%s\n' "$APP"
    exit 0
  fi
  if have_sources; then
    echo "(no packaged app; dev server available at $DESKTOP)"
    exit 0
  fi
  die "no Prometheus Studio app found" 1
fi

# ── launch ────────────────────────────────────────────────────────────────────
if [ -n "$APP" ]; then
  case $APP in
  *.app)
    # macOS bundle: `open` detaches by default; --wait blocks until it quits.
    if [ "$WAIT" -eq 1 ]; then
      exec open -W -a "$APP" ${1+--args "$@"}
    fi
    exec open -a "$APP" ${1+--args "$@"}
    ;;
  *)
    [ -x "$APP" ] || die "$APP is not executable"
    exec "$APP" "$@"
    ;;
  esac
fi

# ── the dev server: EXPLICIT (--dev) only ─────────────────────────────────────
# It used to start automatically whenever no packaged app was found. That was wrong twice
# over: `prometheus-app` is the "open the app" command, and `pnpm dev` is a four-layer
# toolchain (pnpm → turbo → electron-vite → Electron + esbuild + helpers, ~7 processes)
# that a user who typed "open the app" never asked for. Worse, closing the Electron window
# does not stop the layers above it — an instance was found still running hours later.
if [ "$DEV" -eq 1 ]; then
  have_sources || die "--dev needs the sources; $DESKTOP not found"
  command -v pnpm >/dev/null 2>&1 || corepack enable >/dev/null 2>&1 || true
  command -v pnpm >/dev/null 2>&1 || die "pnpm not found — run \`corepack enable\` (Node >= 20)"
  echo "prometheus-app: starting the Electron dev server (Ctrl-C stops the whole tree)." >&2

  # Job control puts the child in its own process group — necessary but NOT sufficient:
  # turbo starts each task in a FRESH process group of its own, so signalling the top
  # group reaches pnpm and turbo and misses electron-vite and Electron entirely (measured:
  # pnpm/turbo in pgid A, electron-vite/Electron in pgid B). So we walk the actual process
  # TREE as well, and snapshot it BEFORE signalling — once a parent dies its children are
  # reparented to init and become unfindable by a ppid walk.
  set -m
  sh -c 'cd "$1/studio" && exec pnpm dev' _ "$ROOT" &
  DEV_PID=$!

  # print $1 and every descendant, depth-first
  descendants() {
    printf '%s\n' "$1"
    for _c in $(pgrep -P "$1" 2>/dev/null); do descendants "$_c"; done
  }

  stop_dev() {
    [ -n "${DEV_PID:-}" ] || return 0
    _pids=$(descendants "$DEV_PID" 2>/dev/null | awk '!seen[$0]++')
    _pgid=$(ps -o pgid= -p "$DEV_PID" 2>/dev/null | tr -d ' ')
    # the group first (catches anything spawned after the snapshot), then the tree
    if [ -n "$_pgid" ] && [ "$_pgid" -gt 1 ] 2>/dev/null; then
      kill -TERM "-$_pgid" 2>/dev/null || true
    fi
    for _p in $_pids; do
      [ "$_p" -gt 1 ] 2>/dev/null && kill -TERM "$_p" 2>/dev/null
    done
    # a dev server flushing to disk deserves a moment; a hung one does not get to stay
    sleep 2
    for _p in $_pids; do
      if [ "$_p" -gt 1 ] 2>/dev/null && kill -0 "$_p" 2>/dev/null; then
        kill -KILL "$_p" 2>/dev/null
      fi
    done
    DEV_PID=""
  }

  trap 'stop_dev; exit 130' INT TERM HUP
  wait "$DEV_PID"
  status=$?
  stop_dev # `pnpm dev` can return while the layers it started keep running
  exit "$status"
fi

if have_sources; then
  cat >&2 <<EOF
prometheus-app: Prometheus Studio has not been built yet.

  build it (once, a few minutes)   prometheus-app --build
  or run it from source            prometheus-app --dev
EOF
  exit 1
fi

cat >&2 <<EOF
prometheus-app: Prometheus Studio is not installed.

  build it from a checkout   prometheus-app --build
  or point at an app bundle  PROMETHEUS_APP="/path/to/Prometheus Studio.app" prometheus-app
EOF
exit 1
