#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Francesco Pelizza
# prometheus — launcher for the Prometheus CLI / interactive TUI.
#
# Resolves the checkout from its OWN location (following symlinks), so this file works
# whether it is run in place, symlinked into ~/.local/bin, or copied by install.sh.
# It pins the engine to the checkout it belongs to — a `prometheus` on PATH must never
# drive a prometheus.py from some other tree — while leaving an explicit PROMETHEUS_PY
# / NEMESIS_BIN in the environment untouched.
#
# Environment:
#   PROMETHEUS_NODE       node binary to use (default: the first usable one found)
#   PROMETHEUS_PY         engine script      (default: <checkout>/prometheus.py)
#   NEMESIS_BIN           security scanner   (default: <checkout>/nemesis)
#   PROMETHEUS_CLI_JS     CLI bundle         (default: <checkout>/studio/apps/cli/dist/bin.js)
#                         pinning this also opts out of the staleness check below —
#                         an explicit bundle path is trusted as-is.
#   PROMETHEUS_SKIP_BUILD set (to anything) to skip the staleness check and always
#                         launch whatever dist/bin.js currently is, even if stale.
#
# Set BY this launcher, never by the user:
#   PROMETHEUS_LAUNCH_ERASE_ROWS  after a successful rebuild on a terminal, how many screen
#                         rows the rebuild log took. The CLI erases exactly those rows at its
#                         first visible write (studio/apps/cli/src/launch-noise.ts), so the log
#                         is shown while it matters and gone once the session is up.
set -eu

# Only THIS launch's own log may ever be erased — never act on a value inherited from a parent.
unset PROMETHEUS_LAUNCH_ERASE_ROWS

# The CLI declares engines.node ">=22.6" (apps/cli/package.json) and install.sh enforces the same;
# this used to accept 20, so a launcher could start a node the build itself refused.
MIN_NODE_MAJOR=22
MIN_NODE_MINOR=6

# ── resolve this script's real directory ──────────────────────────────────────
# POSIX only: macOS `readlink` has no -f, and `realpath` is not guaranteed present.
self=$0
# 40 hops is far beyond any legitimate symlink chain; the bound stops a symlink LOOP
# from hanging the launcher forever.
hops=0
while [ -L "$self" ]; do
  hops=$((hops + 1))
  if [ "$hops" -gt 40 ]; then
    echo "prometheus: symlink loop while resolving $0" >&2
    exit 1
  fi
  target=$(readlink "$self")
  case $target in
  /*) self=$target ;;
  *) self=$(dirname -- "$self")/$target ;;
  esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
ROOT=$(CDPATH= cd -- "$BIN_DIR/.." && pwd -P)

# ── the private toolchain install.sh may have provisioned ─────────────────────
# install.sh writes <checkout>/.prometheus-toolchain (toolchain=, python=, node= lines); it is read
# line by line here, never sourced. Without it, the default Prometheus home. This replaces a guess
# at "$ROOT/../toolchain" — a directory outside both the checkout and the Prometheus home, so for
# a checkout under ~/src it executed whatever ~/src/toolchain/pnpm/bin/pnpm happened to be.
TC=${PROMETHEUS_TOOLCHAIN:-}
INST_PY=""
if [ -f "$ROOT/.prometheus-toolchain" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
    toolchain=/*) [ -n "$TC" ] || TC=${line#toolchain=} ;;
    python=/*) INST_PY=${line#python=} ;;
    esac
  done <"$ROOT/.prometheus-toolchain"
fi
[ -n "$TC" ] || TC=${PROMETHEUS_HOME:-$HOME/.prometheus}/toolchain

# ── locate node ───────────────────────────────────────────────────────────────
# The FIRST node that meets the floor, not the first node found: a too-old node on PATH used to
# end the launch even when the private toolchain (or Homebrew) had a good one. A Finder/Dock-
# launched terminal gets a minimal PATH, hence the well-known roots after PATH.
node_ok() {
  v=$("$1" --version 2>/dev/null </dev/null) || return 1
  v=${v#v}
  major=${v%%.*} rest=${v#*.}
  minor=${rest%%.*}
  case $major$minor in '' | *[!0-9]*) return 1 ;; esac
  [ "$major" -gt "$MIN_NODE_MAJOR" ] || { [ "$major" -eq "$MIN_NODE_MAJOR" ] && [ "$minor" -ge "$MIN_NODE_MINOR" ]; }
}

find_node() {
  if [ -n "${PROMETHEUS_NODE:-}" ]; then
    printf '%s\n' "$PROMETHEUS_NODE"
    return 0
  fi
  path_node=$(command -v node 2>/dev/null || true)
  for candidate in \
    "$path_node" \
    "$TC/node/bin/node" \
    /opt/homebrew/bin/node \
    /opt/homebrew/opt/node@22/bin/node \
    /usr/local/bin/node \
    /usr/bin/node \
    "$HOME/.volta/bin/node" \
    "$HOME/.local/share/fnm/aliases/default/bin/node" \
    "${NVM_DIR:-$HOME/.nvm}/versions/node"/*/bin/node; do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    node_ok "$candidate" || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

NODE=$(find_node) || {
  cat >&2 <<EOF
prometheus: Node.js >= $MIN_NODE_MAJOR.$MIN_NODE_MINOR is required and none was found.

  install it        re-run install.sh — it downloads a private Node.js when none fits
  or point at one   PROMETHEUS_NODE=/path/to/node prometheus ...
EOF
  exit 127
}

# Give the CLI the toolchain install.sh provisioned. APPENDED, so it only fills gaps: anything the
# user installed still wins (the agent's grep/glob spawn `rg` by bare name; the engine and nemesis
# run `python3` through PATH). Two exceptions go in FRONT, because the system copy they replaced
# was missing or unusable when install.sh chose them: the private python, and a private node.
for dir in "$TC/rg" "$TC/node/bin" "$TC/python/bin"; do
  [ -d "$dir" ] || continue
  case :$PATH: in *":$dir:"*) ;; *) PATH=$PATH:$dir ;; esac
done
case $INST_PY in "$TC"/*) [ -x "$INST_PY" ] && PATH=${INST_PY%/*}:$PATH ;; esac
case $NODE in "$TC"/*) PATH=${NODE%/*}:$PATH ;; esac
export PATH

# ── locate the CLI bundle, rebuilding it first if the sources moved on ────────
# dist/bin.js is a bundled build artifact (git-ignored, not the TS source), produced
# by `prepack` (tsc -b + esbuild) inlining the @prometheus/* workspace deps it uses.
# A checkout with edited sources and a stale bundle would otherwise silently run old
# code — see the four dirs below, which are exactly what `prepack` bundles into it.
CLI_JS=${PROMETHEUS_CLI_JS:-$ROOT/studio/apps/cli/dist/bin.js}

# true (0) if $CLI_JS is missing or any file under the bundled source trees is newer.
# `-print -quit` stops at the first hit instead of walking the rest of the tree.
bundle_is_stale() {
  [ -f "$CLI_JS" ] || return 0
  for src_dir in \
    "$ROOT/studio/apps/cli/src" \
    "$ROOT/studio/packages/core/src" \
    "$ROOT/studio/packages/engine-bridge/src" \
    "$ROOT/studio/packages/ui/src"; do
    [ -d "$src_dir" ] || continue
    [ -n "$(find "$src_dir" -type f -newer "$CLI_JS" -print -quit 2>/dev/null)" ] && return 0
  done
  return 1
}

# The pnpm for a rebuild: the private copy install.sh keeps in the toolchain when no installed pnpm
# fitted, else the one on PATH. Never `corepack enable` — this used to run it, silently, on every stale launch:
# corepack writes its shims next to the node binary, which is /usr/bin on a distro or NodeSource
# node (EACCES for a normal user), and wherever it CAN write it replaces the global pnpm and yarn.
find_pnpm() {
  if [ -x "$TC/pnpm/bin/pnpm" ]; then
    printf '%s\n' "$TC/pnpm/bin/pnpm"
    return 0
  fi
  command -v pnpm 2>/dev/null
}

# Dependencies are refreshed when they are missing OR older than the lockfile — after a `git pull`
# that changed it. Rebuilding against the old node_modules fails, then falls back to the stale
# bundle: exactly what happened when @types/node became a declared dependency (2026-10-03), where
# the old tree compiled only because of a leftover directory a clean clone never has. Filtered and
# frozen, like install.sh: the CLI's packages only, and never a different tree than the lockfile.
rebuild_cli() {
  (
    # The node chosen above runs the build too (pnpm, tsc and esbuild are `#!/usr/bin/env node`
    # scripts), not whichever node is first on PATH; and prepack calls `pnpm run bundle` itself.
    PATH=${NODE%/*}:$PATH
    case $PNPM in "$TC"/*) PATH=${PNPM%/*}:$PATH ;; esac
    export PATH
    cd "$ROOT/studio" \
      && { { [ -f node_modules/.modules.yaml ] && ! [ pnpm-lock.yaml -nt node_modules/.modules.yaml ]; } \
        || "$PNPM" install --filter "@prometheus/cli..." --frozen-lockfile; } \
      && "$PNPM" --filter @prometheus/cli run prepack
  ) </dev/null
}

# Passes the rebuild log through UNCHANGED while counting the terminal rows it occupies (long
# lines wrap; wide glyphs such as ⚡ take two cells), then writes the count to the file named by
# its argument. A heredoc with a quoted delimiter, so the shell touches none of it.
ROW_COUNTER=$(
  cat <<'JS'
const fs = require("fs");
const out = process.stdout;
const cols = (out.isTTY && out.columns) || Number(process.env.COLUMNS) || 80;
const ESC = /\x1b\[[0-?]*[ -\/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]/g;
function cells(cp) {
  if (cp === 0x200d || (cp >= 0x300 && cp <= 0x36f) || (cp >= 0xfe00 && cp <= 0xfe0f)) return 0;
  if ((cp >= 0x1100 && cp <= 0x115f) || (cp >= 0x2600 && cp <= 0x27bf) ||
      (cp >= 0x2e80 && cp <= 0xa4cf) || (cp >= 0xac00 && cp <= 0xd7a3) ||
      (cp >= 0xf900 && cp <= 0xfaff) || (cp >= 0xfe30 && cp <= 0xfe4f) ||
      (cp >= 0xff00 && cp <= 0xff60) || (cp >= 0xffe0 && cp <= 0xffe6) ||
      (cp >= 0x1f300 && cp <= 0x1faff) || (cp >= 0x20000 && cp <= 0x3fffd)) return 2;
  return 1;
}
function rowsOf(line) {
  const trimmed = line.replace(/\r+$/, "");
  const shown = trimmed.slice(trimmed.lastIndexOf("\r") + 1).replace(ESC, "");
  let w = 0;
  for (const ch of shown) w += ch === "\t" ? 8 - (w % 8) : cells(ch.codePointAt(0));
  return Math.max(1, Math.ceil(w / cols));
}
let rows = 0;
let buf = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (d) => {
  buf += d;
  let nl = buf.indexOf("\n");
  while (nl !== -1) {
    const line = buf.slice(0, nl);
    buf = buf.slice(nl + 1);
    out.write(`${line}\n`);
    rows += rowsOf(line);
    nl = buf.indexOf("\n");
  }
});
process.stdin.on("end", () => {
  if (buf) {
    out.write(`${buf}\n`);
    rows += rowsOf(buf);
  }
  try {
    fs.writeFileSync(process.argv[1], String(rows));
  } catch {}
});
JS
)

# Skipped when PROMETHEUS_CLI_JS pins an explicit bundle (nothing to compare it
# against), when PROMETHEUS_SKIP_BUILD is set, or when this isn't a source checkout
# at all (a published npm install ships dist/bin.js with no src/ next to it).
if [ -z "${PROMETHEUS_CLI_JS:-}" ] && [ -z "${PROMETHEUS_SKIP_BUILD:-}" ] \
  && [ -d "$ROOT/studio/apps/cli/src" ] && bundle_is_stale; then
  if ! PNPM=$(find_pnpm); then
    echo "prometheus: source changed since the last build — rebuilding…" >&2
    echo "prometheus: pnpm not found — skipping rebuild (re-run \"$ROOT/install.sh\" --from-local \"$ROOT\", which installs it)." >&2
  elif [ -t 2 ] && tidy=$(mktemp -d "${TMPDIR:-/tmp}/prometheus-launch.XXXXXX" 2>/dev/null); then
    # On a terminal: show the log live AND count its rows, so the CLI can wipe exactly those
    # rows once it is up — above a running session the log is only noise. Only a SUCCESSFUL
    # rebuild is wiped: a failure's log is the one record of why, so it stays on screen.
    {
      echo "prometheus: source changed since the last build — rebuilding…"
      if rebuild_cli 2>&1; then
        echo "prometheus: rebuild done."
        : >"$tidy/ok"
      else
        if [ -f "$CLI_JS" ]; then echo "prometheus: rebuild failed — launching the existing build instead."; else echo "prometheus: rebuild failed, and there is no earlier build to fall back to."; fi
      fi
    } | "$NODE" -e "$ROW_COUNTER" "$tidy/rows" >&2 || true
    if [ -f "$tidy/ok" ] && [ -s "$tidy/rows" ]; then
      PROMETHEUS_LAUNCH_ERASE_ROWS=$(cat "$tidy/rows")
      export PROMETHEUS_LAUNCH_ERASE_ROWS
    fi
    rm -rf "$tidy"
  else
    # Not a terminal (captured, CI): the log goes out plain and is never erased.
    echo "prometheus: source changed since the last build — rebuilding…" >&2
    if rebuild_cli >&2; then
      echo "prometheus: rebuild done." >&2
    else
      if [ -f "$CLI_JS" ]; then
        echo "prometheus: rebuild failed — launching the existing build instead." >&2
      else
        echo "prometheus: rebuild failed, and there is no earlier build to fall back to." >&2
      fi
    fi
  fi
fi

if [ ! -f "$CLI_JS" ]; then
  cat >&2 <<EOF
prometheus: the CLI bundle is missing.

  expected  $CLI_JS

  build it  "$ROOT/install.sh" --from-local "$ROOT"
  or        cd "$ROOT/studio" && pnpm install --filter "@prometheus/cli..." --frozen-lockfile && pnpm --filter @prometheus/cli run prepack
EOF
  exit 1
fi

# ── pin the engine to THIS checkout (an explicit env value still wins) ─────────
if [ -z "${PROMETHEUS_PY:-}" ] && [ -f "$ROOT/prometheus.py" ]; then
  PROMETHEUS_PY=$ROOT/prometheus.py
  export PROMETHEUS_PY
fi
if [ -z "${NEMESIS_BIN:-}" ] && [ -x "$ROOT/nemesis" ]; then
  NEMESIS_BIN=$ROOT/nemesis
  export NEMESIS_BIN
fi

exec "$NODE" "$CLI_JS" "$@"
