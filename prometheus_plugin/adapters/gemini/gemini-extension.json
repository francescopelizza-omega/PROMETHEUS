{
  "name": "prometheus",
  "version": "1.0.0",
  "description": "Prometheus MCP tools for Gemini CLI \u2014 scan/install/audit AI-agent plugins",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "prometheus": {
      "command": "npx",
      "args": [
        "-y",
        "@prometheus-plugin/mcp"
      ],
      "cwd": "${extensionPath}",
      "timeout": 600000
    }
  }
}
