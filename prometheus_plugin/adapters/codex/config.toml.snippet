# Merge this block into ~/.codex/config.toml
# (the table name is plural snake_case: [mcp_servers.<name>]; stdio is the default,
#  so no `type` field is needed). CLI equivalent:
#   codex mcp add prometheus --env PROMETHEUS_PY=/ABS/PATH/TO/prometheus.py -- npx -y @prometheus-plugin/mcp

[mcp_servers.prometheus]
command = "npx"
args = ["-y", "@prometheus-plugin/mcp"]
env = { PROMETHEUS_PY = "/ABS/PATH/TO/prometheus.py" }
startup_timeout_sec = 30
tool_timeout_sec = 600
