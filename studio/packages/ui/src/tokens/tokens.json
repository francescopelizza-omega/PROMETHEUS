{
  "$schema": "prometheus-tokens/1",
  "themes": {
    "dark": {
      "bg-app": "#0b0d10",
      "bg-surface": "#121519",
      "bg-surface-2": "#171b21",
      "bg-inset": "#07090b",
      "border-subtle": "#232932",
      "border-strong": "#313844",
      "text-primary": "#f7f8fa",
      "text-secondary": "#9aa4b2",
      "text-disabled": "#5b6675",
      "brand": "#a855f7",
      "brand-fg": "#f7f8fa",
      "accent": "#22d3ee",
      "focus-ring": "#22d3ee",
      "ok": "#22c55e",
      "warn": "#f59e0b",
      "danger": "#ef4444",
      "info": "#06b6d4",
      "selection": "#083e48"
    },
    "light": {
      "bg-app": "#f7f8fa",
      "bg-surface": "#ffffff",
      "bg-surface-2": "#f7f8fa",
      "bg-inset": "#e9ecf1",
      "border-subtle": "#cfd5de",
      "border-strong": "#aab2c0",
      "text-primary": "#0b0d10",
      "text-secondary": "#5b6675",
      "text-disabled": "#9aa4b2",
      "brand": "#8b3ad6",
      "brand-fg": "#f7f8fa",
      "accent": "#0894ad",
      "focus-ring": "#0894ad",
      "ok": "#179c4a",
      "warn": "#a35c08",
      "danger": "#cf2727",
      "info": "#0894ad",
      "selection": "#c2f6ff"
    },
    "high-contrast": {
      "bg-app": "#000000",
      "bg-surface": "#000000",
      "bg-surface-2": "#0a0a0a",
      "bg-inset": "#000000",
      "border-subtle": "#ffffff",
      "border-strong": "#ffffff",
      "text-primary": "#ffffff",
      "text-secondary": "#e6e6e6",
      "text-disabled": "#bdbdbd",
      "brand": "#c08cff",
      "brand-fg": "#000000",
      "accent": "#5cdff5",
      "focus-ring": "#5cdff5",
      "ok": "#5fd98c",
      "warn": "#fbbf4a",
      "danger": "#fa6b6b",
      "info": "#5cdff5",
      "selection": "#0a525f"
    }
  },
  "space": {
    "0": "0px",
    "1": "2px",
    "2": "4px",
    "3": "6px",
    "4": "8px",
    "6": "12px",
    "8": "16px",
    "10": "20px",
    "12": "24px",
    "16": "32px",
    "20": "40px",
    "24": "48px",
    "32": "64px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "xl": "14px",
    "full": "9999px"
  },
  "elevation": {
    "e0": "none",
    "e1": "0 0 0 1px var(--border-subtle)",
    "e2": "0 0 0 1px var(--border-subtle), 0 8px 24px rgba(0, 0, 0, 0.35)",
    "e3": "0 0 0 1px var(--border-strong), 0 16px 48px rgba(0, 0, 0, 0.5)"
  },
  "density": {
    "comfortable": {
      "row-h": "36px",
      "pad-y": "8px"
    },
    "compact": {
      "row-h": "28px",
      "pad-y": "4px"
    }
  },
  "typography": {
    "fontUi": "\"Inter var\", -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "fontMono": "\"JetBrains Mono\", \"SF Mono\", \"Cascadia Code\", ui-monospace, monospace",
    "fontBrand": "\"Inter var\", -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "brandLetterSpacing": "-0.01em",
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "scale": {
      "display": {
        "size": "1.75rem",
        "line": "2.1"
      },
      "h1": {
        "size": "1.375rem",
        "line": "1.7"
      },
      "h2": {
        "size": "1.125rem",
        "line": "1.6"
      },
      "body": {
        "size": "0.9375rem",
        "line": "1.5"
      },
      "small": {
        "size": "0.8125rem",
        "line": "1.4"
      },
      "code": {
        "size": "0.875rem",
        "line": "1.5"
      }
    }
  }
}
