# dev-logged tee output
.dev-logs/

# Playwright e2e (APP-069): per-run artifacts + report — NOT the committed baselines
# under e2e/__screenshots__/ (those ARE the visual-regression source of truth).
apps/desktop/e2e/.artifacts/
# shots.spec.ts writes full-window PNGs for eyeballing a redesign against its reference.
# They are working artifacts, not baselines — regenerate them, never review a diff of them.
apps/desktop/e2e/.shots/
apps/desktop/playwright-report/
apps/desktop/test-results/

# VS Code extension: the throwaway VS Code build @vscode/test-electron downloads (~900MB
# unpacked) and the packaged extension artifact. `out/` is already covered above.
apps/vscode-extension/.vscode-test/
apps/vscode-extension/*.vsix
