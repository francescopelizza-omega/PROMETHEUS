<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  entitlements.mac.plist — hardened-runtime entitlements (file 10 §2).

  disable-library-validation is the load-bearing one: without it a hardened-runtime
  app cannot exec a Python interpreter we shipped that Apple did not sign as part of
  our team. We sign the bundled python (§4.1), but its own dylibs (libcrypto, …) are
  Python's, so library validation must be relaxed. network.client is needed because
  the engine downloads models/repos and `nemesis update` pulls feeds. This is a real
  attack-surface tradeoff, documented in the security review with file 03.

  com.apple.security.cs.allow-dyld-environment-variables was REMOVED (security review
  S10). It let DYLD_INSERT_LIBRARIES / DYLD_LIBRARY_PATH inject a library into the signed,
  hardened app from the environment — and nothing needs it: the bundled CPython is
  relocatable (@rpath / @executable_path), and every child env Prometheus builds strips
  DYLD_* anyway (engine-bridge safe-env). Do not restore it to make a dylib load; fix the
  dylib's install name instead.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
