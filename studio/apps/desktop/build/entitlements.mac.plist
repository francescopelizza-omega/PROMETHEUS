<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  entitlements.mac.plist — hardened-runtime entitlements (file 10 §2).

  disable-library-validation is the load-bearing one: without it a hardened-runtime
  app cannot exec a Python interpreter we shipped that Apple did not sign as part of
  our team. We sign the bundled python (§4.1), but its own dylibs (libcrypto, …) are
  Python's, so library validation must be relaxed. network.client is needed because
  the engine downloads models/repos and `nemesis update` pulls feeds. This is a real
  attack-surface tradeoff, documented in the security review with file 03.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
