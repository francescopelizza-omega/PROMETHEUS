{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "references": [
    { "path": "../../packages/engine-bridge" },
    { "path": "../../packages/core" },
    { "path": "../../packages/ui" }
  ],
  "include": ["src/**/*", "electron.vite.config.ts"],
  "exclude": [
    "out",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__test-doubles__/**"
  ]
}
