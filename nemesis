# literal path (this block loads before _NEMESIS_HOME is defined); == _NEMESIS_HOME/…
_TRUSTED_DOMAINS_FILE = os.path.join(os.path.expanduser("~"), ".nemesis", "trusted_domains.txt")


def _trusted_domain_set(extra: Iterable[str] = ()) -> set[str]:
    """Builtin official-doc domains + ~/.nemesis/trusted_domains.txt + caller extras."""
    out = set(_BUILTIN_TRUSTED_DOMAINS)
    out.update(_load_set(_TRUSTED_DOMAINS_FILE))
    out.update(d.strip().lower().lstrip(".") for d in extra if d and d.strip())
    return out


def _is_trusted_host(host: str, trusted: set[str]) -> bool:
    """True if host equals or is a sub-domain of a trusted registrable domain."""
    if not host:
        return False
    h = host.lower().rstrip(".")
    return any(h == d or h.endswith("." + d) for d in trusted)


def _decode_obf_match(tag: str, m: "re.Match") -> str:
    """Decode a single obfuscation-primitive match (mirrors _deobf_variants, per-span)."""
    try:
        if tag in ("charcode", "numarray"):
            return _nums_to_text(m.group(1))
        if tag in ("hexesc", "uniesc"):
            return m.group(0).encode("ascii").decode("unicode_escape")
        if tag == "chrjoin":
            return _nums_to_text(re.sub(r"chr\(|\)|\+", " ", m.group(0)))
    except (ValueError, UnicodeDecodeError):
        return ""
    return ""


def _defang_spans(text: str, scope: str, keep_trusted: bool = False,
                  extra_keep: Iterable[str] = ()) -> tuple[list[tuple[int, int, str, str]], list[dict]]:
    """Return (spans, kept). spans = [(start, end, kind, original)] to neutralise;
    kept = trusted literal URLs spared when keep_trusted. Obfuscated/encoded URLs are
    never spared (an official link is never hidden in a blob)."""
    spans: list[tuple[int, int, str, str]] = []
    kept: list[dict] = []
    trusted = _trusted_domain_set(extra_keep) if keep_trusted else set()

    # 1) literal http(s) URLs (trim trailing punctuation, like extraction)
    for m in _URL_SCAN_RX.finditer(text):
        stripped = m.group(0).rstrip(".,;:)\"']}")
        if not stripped:
            continue
        if keep_trusted:
            host = _url_host(stripped)
            if _is_trusted_host(host, trusted):
                kept.append({"url": stripped[:200], "host": host,
                             "line": text.count("\n", 0, m.start()) + 1})
                continue
        s = m.start()
        spans.append((s, s + len(stripped), "url", stripped[:120]))

    # 2) obfuscation primitives whose decode yields a URL / scheme fragment
    for rx, tag in ((_CHARCODE_RX, "charcode"), (_NUMARR_RX, "numarray"),
                    (_HEXESC_RX, "hexesc"), (_UNIESC_RX, "uniesc"),
                    (_CHRJOIN_RX, "chrjoin")):
        for m in rx.finditer(text):
            dec = _decode_obf_match(tag, m)
            # DESTRUCTIVE rewrite: require a REAL decoded URL, NOT the ultra-loose
            # opaque-scheme heuristic (which matches an "h..t..t..p" run in random bytes
            # and would wipe a benign obfuscated literal). Opaque-scheme stays a REPORT
            # signal in the scan path only.
            if dec and _URL_SCAN_RX.search(dec):
                spans.append((m.start(), m.end(), f"obf-{tag}", m.group(0)[:120]))

    # 3) base64 / hex blobs that decode to a REAL URL (incl. CLI-041 short-b64 via the shared path)
    for rx, dec_fn, tag in ((_B64_TXT_RX, lambda s: base64.b64decode(s, validate=True), "b64"),
                            (_B64_SHORT_RX, _short_b64_decode, "b64s"),
                            (_HEX_TXT_RX, binascii.unhexlify, "hex")):
        for m in rx.finditer(text):
            try:
                data = dec_fn(m.group(0))
            except (binascii.Error, ValueError):
                continue
            if not data or len(data) > _DECODE_MAX_BYTES:
                continue
            sdec = _maybe_decompress(data).decode("utf-8", "replace")
            # require a real URL (see above) — never destroy a blob on the opaque heuristic.
            if _URL_SCAN_RX.search(sdec):
                spans.append((m.start(), m.end(), f"blob-{tag}", m.group(0)[:80]))

    # 4) scope=all: bare IOC domains / IPs (only feed-flagged, to spare legit config)
    if scope == "all":
        for m in _HOST_SCAN_RX.finditer(text):
            host = m.group(0).lower().rstrip(".")
            if host in DOMAIN_BLOCKLIST and host not in ALLOWLIST:
                if keep_trusted and _is_trusted_host(host, trusted):
                    kept.append({"url": host, "host": host,
                                 "line": text.count("\n", 0, m.start()) + 1})
                    continue
                spans.append((m.start(), m.start() + len(m.group(0).rstrip(".")), "ioc-domain", host[:120]))
        for m in _IPV4_SCAN_RX.finditer(text):
            ip = m.group(0)
            if (ip in IP_BLOCKLIST or _ip_in_cidr(ip)) and ip not in ALLOWLIST:
                spans.append((m.start(), m.end(), "ioc-ip", ip))
    return spans, kept


def _merge_spans(spans: list[tuple[int, int, str, str]]) -> list[tuple[int, int]]:
    ordered = sorted({(s, e) for s, e, _k, _o in spans})
    merged: list[tuple[int, int]] = []
    for s, e in ordered:
        if merged and s <= merged[-1][1]:
            merged[-1] = (merged[-1][0], max(merged[-1][1], e))
        else:
            merged.append((s, e))
    return merged


def _defang_text(text: str, mode: str, scope: str, keep_trusted: bool = False,
                 extra_keep: Iterable[str] = ()) -> tuple[str, list[dict], list[dict]]:
    """Return (new_text, neutralizations, kept). `star` stars every URL char (keeps
    the line); `remove` drops every line a URL touches. With keep_trusted, literal
    URLs on official-doc domains are spared (and listed in `kept`). Idempotent."""
    spans, kept = _defang_spans(text, scope, keep_trusted, extra_keep)
    if not spans:
        return text, [], kept
    neut = [{"line": text.count("\n", 0, s) + 1, "kind": k, "original": o}
            for s, _e, k, o in spans]
    def _star(t: str, merged_spans: list[tuple[int, int]]) -> str:
        out: list[str] = []
        prev = 0
        for s, e in merged_spans:
            out.append(t[prev:s])
            out.append("".join(c if c in "\r\n" else _DEFANG_STAR for c in t[s:e]))
            prev = e
        out.append(t[prev:])
        return "".join(out)

    if mode == "remove":
        # Only literal-URL / IOC spans cause WHOLE-LINE deletion. Obfuscated / blob spans
        # are neutralised INLINE (starred) instead — a multi-line blob must not delete the
        # unrelated lines it happens to straddle. Starring preserves the line structure, so
        # the kill-line numbers (from the original offsets) still map correctly afterward.
        line_kill = [t for t in spans if t[2] == "url" or t[2].startswith("ioc-")]
        inline = [t for t in spans if not (t[2] == "url" or t[2].startswith("ioc-"))]
        starred = _star(text, _merge_spans(inline)) if inline else text
        kill_lines: set[int] = set()
        for s, e in _merge_spans(line_kill):
            for ln in range(text.count("\n", 0, s) + 1, text.count("\n", 0, e) + 2):
                kill_lines.add(ln)
        kept_text = [ln for i, ln in enumerate(starred.split("\n"), start=1)
                     if i not in kill_lines]
        return "\n".join(kept_text), neut, kept
    # star mode — replace each URL char with '*' (newlines preserved)
    return _star(text, _merge_spans(spans)), neut, kept


# CLI-076: dry-run preview diff budgets — stored (JSON envelope) vs rendered (terminal).
_DEFANG_DIFF_BUDGET = 200   # max diff lines STORED per file (bounds the --json envelope)
_DEFANG_DIFF_RENDER = 60    # max diff lines PRINTED per file before a "… N more" tail


def _defang_diff(old: str, new: str, path: str, budget: int = _DEFANG_DIFF_BUDGET) -> list[str]:
    """A unified diff (old→new) for the dry-run PREVIEW — stdlib difflib only. Lines carry NO
    trailing newline (`lineterm=''`, over `splitlines()`), so each is a clean, renderable list
    item. Capped to `budget` lines with an explicit '… N more' tail so a huge rewrite can't bloat
    the JSON envelope. The diff is computed from the SAME decoded `old`/`new` defang_path holds —
    never a naive re-read — so a non-UTF-8 file shows no phantom changes."""
    lines = list(difflib.unified_diff(
        old.splitlines(), new.splitlines(),
        fromfile=path, tofile=path + " (defanged)", lineterm=""))
    if len(lines) > budget:
        extra = len(lines) - budget
        lines = lines[:budget] + [f"… {extra} more diff line(s) (truncated)"]
    return lines


def defang_path(path: str, mode: str = "star", scope: str = "urls",
                dry_run: bool = False, keep_trusted: bool = False,
                extra_keep: Iterable[str] = ()) -> dict:
    """Neutralise every URL in one text file (original → <path>.nemesis.bak). With
    keep_trusted, literal URLs on official-doc domains are spared + listed in 'kept'."""
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError as e:
        return {"path": path, "changed": False, "error": str(e)}
    if b"\x00" in raw[:4096]:
        # rewriting a binary would corrupt it; URLs in binaries → quarantine, not defang
        return {"path": path, "changed": False, "binary": True, "count": 0}
    try:
        text = raw.decode("utf-8")
        codec = "utf-8"
    except UnicodeDecodeError:
        text = raw.decode("latin-1")
        codec = "latin-1"
    new_text, neut, kept = _defang_text(text, mode, scope, keep_trusted, extra_keep)
    if not neut or new_text == text:
        return {"path": path, "changed": False, "count": 0,
                "kept": kept[:50], "kept_count": len(kept)}
    if not dry_run:
        _backup(path)
        # ATOMIC: write a temp file in the same dir then os.replace() it onto the target,
        # so a crash between backup and write can never leave the target truncated/empty
        # (the original is in .nemesis.bak, but the live file must stay consistent too).
        try:
            d = os.path.dirname(os.path.abspath(path)) or "."
            fd, tmp = tempfile.mkstemp(dir=d, prefix=".nemesis-defang-", suffix=".tmp")
            try:
                with os.fdopen(fd, "w", encoding=codec) as fh:
                    fh.write(new_text)
                os.replace(tmp, path)
            except OSError:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
                raise
        except OSError as e:
            return {"path": path, "changed": False, "error": str(e)}
    out = {"path": path, "changed": True, "count": len(neut), "mode": mode,
           "scope": scope, "backup": path + ".nemesis.bak",
           "neutralized": neut[:50], "kept": kept[:50], "kept_count": len(kept)}
    # CLI-076: on a dry run surface the exact rewrite as a unified diff (the diff material is the
    # already-computed new_text — nothing written to disk). Additive key; real-run dicts omit it.
    if dry_run:
        out["diff"] = _defang_diff(text, new_text, path)
    return out


def defang_tree(root: str, mode: str = "star", scope: str = "urls",
                dry_run: bool = False, keep_trusted: bool = False,
                extra_keep: Iterable[str] = ()) -> dict:
    """Walk a file or directory and defang every text file. Skips .nemesis.bak and
    .git object stores (reuses the Scanner walk + skip rules)."""
    results: list[dict] = []
    sc = Scanner()
    # A symlink as the explicit target would otherwise bypass the _iter_files symlink
    # guard and make defang follow it — mutating the link TARGET (outside the tree) and
    # writing the .bak next to the link. Refuse it.
    if os.path.islink(root):
        return {"root": root, "mode": mode, "scope": scope, "dry_run": dry_run,
                "keep_trusted": keep_trusted, "files_changed": 0, "urls_neutralized": 0,
                "urls_kept_trusted": 0, "binaries_skipped": 0,
                "files": [{"path": root, "changed": False,
                           "error": "refusing to defang a symlink (would mutate its target)"}]}
    if os.path.isfile(root):
        files = [root]
    else:
        files = list(sc._iter_files(root))
    total_urls = 0
    total_kept = 0
    changed = 0
    binaries = 0
    for fp in files:
        r = defang_path(fp, mode=mode, scope=scope, dry_run=dry_run,
                        keep_trusted=keep_trusted, extra_keep=extra_keep)
        total_kept += r.get("kept_count", 0)
        if r.get("binary"):
            binaries += 1
            if r.get("count", 0):  # binary with URLs in strings — flag it
                results.append(r)
            continue
        if r.get("changed"):
            changed += 1
            total_urls += r.get("count", 0)
            results.append(r)
        elif r.get("error"):
            results.append(r)
        elif r.get("kept_count"):
            results.append(r)   # nothing wiped but trusted URLs were spared — surface them
    return {"root": root, "mode": mode, "scope": scope, "dry_run": dry_run,
            "keep_trusted": keep_trusted,
            "files_changed": changed, "urls_neutralized": total_urls,
            "urls_kept_trusted": total_kept, "binaries_skipped": binaries,
            "files": results}


def _manifest_path(qdir: str) -> str:
    return os.path.join(qdir, "manifest.jsonl")


def _append_manifest(qdir: str, rec: dict) -> None:
    with open(_manifest_path(qdir), "a", encoding="utf-8") as fh:
        fh.write(json.dumps(rec) + "\n")


def restore(qdir: str, qid: str) -> int:
    """Restore a quarantined file by id (or 'all'). Erased files have no vault
    copy and cannot be restored — their records are listed and skipped."""
    mpath = _manifest_path(qdir)
    if not os.path.exists(mpath):
        print(_c("no quarantine manifest found", _SEV_COLOR["HIGH"]))
        return 2
    records = [json.loads(l) for l in open(mpath, encoding="utf-8") if l.strip()]
    targets = records if qid == "all" else [r for r in records if r["id"] == qid]
    if not targets:
        print(f"no quarantine record matches id {qid!r}")
        return 2
    n = 0
    for rec in targets:
        if rec.get("kind") == "erased" or not rec.get("vault_file"):
            print(_c(f"  {rec['id']}: erased permanently — cannot restore "
                     f"({rec['original_path']})", _DIM))
            continue
        dest = rec["original_path"]
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with gzip.open(rec["vault_file"], "rb") as src, open(dest, "wb") as dst:
            shutil.copyfileobj(src, dst)
        print(f"restored {dest}")
        n += 1
    print(_c(f"\nrestored {n} file(s)", _BOLD))
    return 0


def list_quarantine(qdir: str) -> int:
    """Print the quarantine/erase manifest of a vault directory."""
    mpath = _manifest_path(qdir)
    if not os.path.exists(mpath):
        print(_c(f"no quarantine manifest in {qdir}", _DIM))
        return 0
    records = [json.loads(l) for l in open(mpath, encoding="utf-8") if l.strip()]
    if not records:
        print(_c("manifest is empty", _DIM))
        return 0
    print(_c(f"  {len(records)} record(s) in {qdir}", _BOLD))
    for rec in records:
        kind = rec.get("kind", "quarantined")
        when = rec.get("quarantined_at") or rec.get("erased_at") or "?"
        print(f"  {rec['id']}  [{kind}]  {rec['original_path']}")
        print(_c(f"      {when}  rules: {','.join(rec.get('rules', []))}", _DIM))
    return 0


# --------------------------------------------------------------------------- #
# Per-finding ignore store (operator-accepted findings)
# --------------------------------------------------------------------------- #
# A reviewed finding the user chose to ignore is persisted here and suppressed on
# every later scan/gate run. The fingerprint pins rule + file name + offending
# content, so it survives a file move but re-fires if the flagged content changes.
def _ignores_path() -> str:
    return os.path.join(_NEMESIS_HOME, "ignores.json")


def _finding_fingerprint(f: Finding) -> str:
    base = os.path.basename(f.path.split("!", 1)[0])
    member = f.path.split("!", 1)[1] if "!" in f.path else ""
    snip = hashlib.sha256((f.snippet or "").strip()
                          .encode("utf-8", "replace")).hexdigest()[:16]
    return f"{f.rule.rid}|{base}|{member}|{snip}"


def _load_ignores() -> dict:
    try:
        with open(_ignores_path(), encoding="utf-8") as fh:
            data = json.load(fh)
        if isinstance(data, dict) and isinstance(data.get("entries"), list):
            return data
    except (OSError, json.JSONDecodeError):
        pass
    return {"version": 1, "entries": []}


def _save_ignores(data: dict) -> None:
    os.makedirs(_NEMESIS_HOME, exist_ok=True)
    tmp = _ignores_path() + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, _ignores_path())


def add_ignores(findings: Iterable[Finding]) -> int:
    data = _load_ignores()
    have = {e.get("fp") for e in data["entries"]}
    added = 0
    for f in findings:
        fp = _finding_fingerprint(f)
        if fp in have:
            continue
        data["entries"].append({
            "fp": fp, "rule": f.rule.rid, "path": f.path, "line": f.line,
            "snippet": (f.snippet or "")[:80],
            "added_at": datetime.now(timezone.utc).isoformat(),
        })
        have.add(fp)
        added += 1
    if added:
        _save_ignores(data)
    return added


def filter_ignored(findings: list[Finding]) -> tuple[list[Finding], int]:
    """Drop findings whose fingerprint is in the persistent ignore store."""
    entries = _load_ignores()["entries"]
    if not entries:
        return findings, 0
    fps = {e.get("fp") for e in entries}
    kept = [f for f in findings if _finding_fingerprint(f) not in fps]
    return kept, len(findings) - len(kept)


