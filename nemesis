def print_report(findings: list[Finding], scanner: Scanner, root: str, elapsed: float) -> None:
    counts = {s: 0 for s in SEVERITIES}
    for f in findings:
        counts[f.rule.severity] += 1

    print(_c(f"\n  nemesis v{__version__}", _BOLD) + _c(f"  ·  target: {root}", _DIM))
    print(_c("  " + "─" * 64, _DIM))

    if not findings:
        print(_c("  ✓ no known threat patterns matched", _SEV_COLOR["LOW"]))
    else:
        cur = None
        for f in findings:
            if f.rule.severity != cur:
                cur = f.rule.severity
                print()
            loc = f"{_rel(f.path, root)}:{f.line}:{f.column}"
            print(f"  {_sev(f.rule.severity)} {_c(f.rule.rid, _DIM)} {_BOLD if _USE_COLOR else ''}{f.rule.name}{_RESET if _USE_COLOR else ''}")
            print(f"      {_c(loc, _SEV_COLOR['LOW'])}")
            if f.snippet:
                print(f"      {_DIM if _USE_COLOR else ''}{f.snippet}{_RESET if _USE_COLOR else ''}")
            print(f"      fix: {f.rule.remediation}")

    print(_c("\n  " + "─" * 64, _DIM))
    summary = "  ".join(
        _c(f"{counts[s]} {s.lower()}", _SEV_COLOR[s]) for s in SEVERITIES if counts[s]
    ) or _c("0 findings", _SEV_COLOR["LOW"])
    print(f"  {summary}")
    print(_c(
        f"  {scanner.files_scanned} files · {scanner.bytes_scanned/1e6:.1f} MB · "
        f"{elapsed:.2f}s · {len(scanner.errors)} read errors",
        _DIM))


def _rel(path: str, root: str) -> str:
    try:
        return os.path.relpath(path, root if os.path.isdir(root) else os.path.dirname(root))
    except ValueError:
        return path


def write_json(findings: list[Finding], scanner: Scanner, root: str, out: str) -> None:
    doc = {
        "tool": "nemesis",
        "version": __version__,
        "scanned_at": datetime.now(timezone.utc).isoformat(),
        "target": os.path.abspath(root),
        "files_scanned": scanner.files_scanned,
        "bytes_scanned": scanner.bytes_scanned,
        "read_errors": scanner.errors,
        "summary": {s: sum(1 for f in findings if f.rule.severity == s) for s in SEVERITIES},
        "findings": [f.to_dict() for f in findings],
    }
    with open(out, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, indent=2)
    print(_c(f"  json report -> {out}", _DIM))


