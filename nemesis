# CIDR/range IOC blocklist (FireHOL netsets, Spamhaus DROP). Parsed networks; an
# exact-IP miss falls through to a containment check here. Kept small + memoized.
IP_CIDR_BLOCKLIST: list = []            # list[ipaddress.IPv4Network|IPv6Network]
_IP_CIDR_MEMO: dict[str, bool] = {}
KEV_SET: set[str] = set()               # CISA Known-Exploited CVE ids (kev.txt)


def _ip_in_cidr(ip: str) -> bool:
    """True iff `ip` falls inside any IP_CIDR_BLOCKLIST network. Memoized; fail-safe
    (a malformed literal is simply not-blocked here — the exact set already missed)."""
    if not IP_CIDR_BLOCKLIST:
        return False
    hit = _IP_CIDR_MEMO.get(ip)
    if hit is not None:
        return hit
    try:
        addr = ipaddress.ip_address(ip)
        hit = any(addr in net for net in IP_CIDR_BLOCKLIST)
    except ValueError:
        hit = False
    if len(_IP_CIDR_MEMO) < 4096:
        _IP_CIDR_MEMO[ip] = hit
    return hit

