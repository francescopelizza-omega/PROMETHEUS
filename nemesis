# --------------------------------------------------------------------------- #
# Remote repo ingestion (scan a GitHub URL / owner/repo)
# --------------------------------------------------------------------------- #
# nemesis can scan a repo it does not have on disk: it fetches a snapshot into a
# temp dir, scans it, then deletes it. Fetch == download + checkout only; repo
# code is never executed. git is used with hardened config (no submodule
# recursion, no ext::/file:: transports, hooks neutralised); if git is absent we
# fall back to GitHub's codeload tarball via stdlib.
_REPO_URL_RX = re.compile(r"^(https?://|git://|ssh://|git@)", re.IGNORECASE)
_OWNER_REPO_RX = re.compile(r"^[A-Za-z0-9][\w.-]*/[A-Za-z0-9][\w.-]*$")
# host-prefixed shorthand: gitlab:owner/repo, codeberg:owner/repo, …
_FORGE_HOSTS = {"github": "github.com", "gitlab": "gitlab.com",
                "bitbucket": "bitbucket.org", "codeberg": "codeberg.org"}
_FORGE_SHORT_RX = re.compile(
    r"^(github|gitlab|bitbucket|codeberg):([A-Za-z0-9][\w.-]*/[A-Za-z0-9][\w.-]*)$",
    re.IGNORECASE)


def _looks_like_repo(spec: str) -> bool:
    if os.path.exists(spec):
        return False
    return bool(_REPO_URL_RX.match(spec) or spec.endswith(".git")
                or _OWNER_REPO_RX.match(spec) or _FORGE_SHORT_RX.match(spec))


_RAW_URL_EXTS = (".zip", ".jar", ".whl", ".egg", ".tar", ".tgz", ".gz", ".bz2",
                 ".xz", ".tbz2", ".txz", ".rar", ".7z", ".sh", ".bash", ".py",
                 ".pl", ".rb", ".js", ".ps1", ".run", ".bin", ".appimage",
                 ".deb", ".rpm", ".pkg", ".dmg", ".exe", ".msi", ".apk")


def _classify_remote(spec: str) -> str:
    """'repo' (clone/tarball flow) or 'raw' (direct file download flow).
    A https URL pointing at a file — release asset, install.sh, any download —
    is fetched as a single file and scanned. Ambiguous deep https paths try the
    repo flow first; materialize_target falls back to a raw fetch on failure."""
    if _FORGE_SHORT_RX.match(spec) or _OWNER_REPO_RX.match(spec):
        return "repo"
    if spec.endswith(".git") or spec.startswith(("git://", "ssh://", "git@")):
        return "repo"
    try:
        u = urllib.parse.urlparse(spec)
    except ValueError:
        return "repo"
    if u.scheme not in ("http", "https"):
        return "repo"
    parts = [p for p in u.path.split("/") if p]
    host = u.netloc.lower().split("@")[-1].split(":")[0]
    if host in _FORGE_HOSTS.values() and len(parts) == 2:
        return "repo"                       # forge owner/repo, even dotted (next.js)
    if parts and parts[-1].lower().endswith(_RAW_URL_EXTS):
        return "raw"
    if len(parts) <= 1:
        return "raw"                        # bare host / single segment: not a repo
    return "repo"


def _normalize_repo_url(spec: str) -> tuple[str, str]:
    m = _FORGE_SHORT_RX.match(spec)
    if m:
        host = _FORGE_HOSTS[m.group(1).lower()]
        return f"https://{host}/{m.group(2)}.git", spec
    if _OWNER_REPO_RX.match(spec) and not _REPO_URL_RX.match(spec):
        return f"https://github.com/{spec}.git", spec
    return spec, spec


def _clone_repo(url: str, ref: Optional[str] = None) -> str:
    tmp = tempfile.mkdtemp(prefix="nemesis_clone_")
    cmd = ["git",
           "-c", "protocol.ext.allow=never",
           "-c", "protocol.file.allow=never",
           "-c", "core.fsmonitor=",
           "-c", "core.hooksPath=/dev/null",
           "clone", "--depth", "1", "--no-tags", "--quiet"]
    if ref:
        cmd += ["--branch", ref]
    cmd += ["--", url, tmp]
    env = dict(os.environ,
               GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="true",
               GIT_LFS_SKIP_SMUDGE="1", GIT_CONFIG_NOSYSTEM="1")
    try:
        proc = subprocess.run(cmd, env=env, timeout=300,
                              stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except (OSError, subprocess.SubprocessError) as e:
        shutil.rmtree(tmp, ignore_errors=True)
        raise RuntimeError(f"git clone failed: {e}") from e
    if proc.returncode != 0:
        shutil.rmtree(tmp, ignore_errors=True)
        msg = (proc.stderr or b"").decode("utf-8", "replace").strip()
        raise RuntimeError(msg[:300] or "git clone failed")
    return tmp


def _safe_extract_tar(tf: tarfile.TarFile, dest: str,
                      max_bytes: int = 2_000_000_000) -> None:
    base = os.path.realpath(dest)
    total = 0
    for m in tf.getmembers():
        if m.issym() or m.islnk():          # skip links — symlink-traversal guard
            continue
        if not (m.isfile() or m.isdir()):
            continue
        target = os.path.realpath(os.path.join(dest, m.name))
        if target != base and not target.startswith(base + os.sep):
            raise RuntimeError(f"unsafe path in archive: {m.name}")
        total += m.size
        if total > max_bytes:
            raise RuntimeError("archive exceeds extraction cap (zip-bomb guard)")
        tf.extract(m, dest)


def _fetch_forge_tarball(url: str, ref: Optional[str] = None) -> str:
    """git-less snapshot download via each forge's stdlib-reachable tarball API.
    Supports github.com, gitlab.com, codeberg.org (gitea), bitbucket.org."""
    m = re.search(r"(github\.com|gitlab\.com|codeberg\.org|bitbucket\.org)"
                  r"[:/]+(.+?)(?:\.git)?/?$", url, re.IGNORECASE)
    if not m:
        raise RuntimeError("tarball fallback supports github/gitlab/codeberg/"
                           "bitbucket URLs only")
    host = m.group(1).lower()
    path = m.group(2)
    if "/" not in path:
        raise RuntimeError(f"cannot parse owner/repo from {url}")
    owner, repo = path.split("/", 1)
    repo = repo.split("/")[0]
    branch = ref
    if host == "github.com":
        if not branch:
            meta = json.loads(_http_fetch(
                f"https://api.github.com/repos/{owner}/{repo}",
                {"Accept": "application/vnd.github+json"}, 8 << 20).decode("utf-8", "replace"))
            branch = meta.get("default_branch", "main")
        tar_url = f"https://codeload.github.com/{owner}/{repo}/tar.gz/{urllib.parse.quote(branch)}"
    elif host == "gitlab.com":
        proj = urllib.parse.quote(f"{owner}/{repo}", safe="")
        if not branch:
            meta = json.loads(_http_fetch(
                f"https://gitlab.com/api/v4/projects/{proj}", {}, 8 << 20)
                .decode("utf-8", "replace"))
            branch = meta.get("default_branch", "main")
        b = urllib.parse.quote(branch)
        tar_url = (f"https://gitlab.com/{owner}/{repo}/-/archive/{b}/"
                   f"{repo}-{b}.tar.gz")
    elif host == "codeberg.org":
        if not branch:
            meta = json.loads(_http_fetch(
                f"https://codeberg.org/api/v1/repos/{owner}/{repo}", {}, 8 << 20)
                .decode("utf-8", "replace"))
            branch = meta.get("default_branch", "main")
        tar_url = (f"https://codeberg.org/{owner}/{repo}/archive/"
                   f"{urllib.parse.quote(branch)}.tar.gz")
    else:  # bitbucket.org
        if not branch:
            meta = json.loads(_http_fetch(
                f"https://api.bitbucket.org/2.0/repositories/{owner}/{repo}",
                {}, 8 << 20).decode("utf-8", "replace"))
            branch = (meta.get("mainbranch") or {}).get("name", "main")
        tar_url = (f"https://bitbucket.org/{owner}/{repo}/get/"
                   f"{urllib.parse.quote(branch)}.tar.gz")
    blob = _http_fetch(tar_url, {}, 512 * 1024 * 1024)
    tmp = tempfile.mkdtemp(prefix="nemesis_clone_")
    try:
        with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as tf:
            _safe_extract_tar(tf, tmp)
    except Exception:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    return tmp


_RAW_FETCH_CAP = 512 * 1024 * 1024


def _fetch_raw_url(url: str) -> str:
    """Download a direct file URL (HTTPS only, size-capped) into a temp dir and
    return the file path. The bytes are scanned exactly like a local file —
    archive, script, or binary — and never executed."""
    blob = _http_fetch(url, {}, _RAW_FETCH_CAP)
    name = os.path.basename(urllib.parse.urlparse(url).path) or "download"
    name = re.sub(r"[^A-Za-z0-9._-]", "_", name)[:120] or "download"
    tmp = tempfile.mkdtemp(prefix="nemesis_fetch_")
    p = os.path.join(tmp, name)
    with open(p, "wb") as fh:
        fh.write(blob)
    return p


def _materialize_stdin() -> str:
    """Read stdin (capped) into a temp file so `nemesis gate -` can scan text
    another tool pipes in — shell installer bodies, compose files, …"""
    data = sys.stdin.buffer.read(64 * 1024 * 1024 + 1)
    if len(data) > 64 * 1024 * 1024:
        raise RuntimeError("stdin exceeds 64 MB cap")
    tmp = tempfile.mkdtemp(prefix="nemesis_stdin_")
    p = os.path.join(tmp, "stdin")
    with open(p, "wb") as fh:
        fh.write(data)
    return p


def materialize_target(spec: str, ref: Optional[str] = None, keep: bool = False):
    """Return (scan_path, cleanup_fn, label, is_remote). Local paths pass through.
    Remote specs: repo-shaped → hardened shallow clone, else forge tarball, else
    (https) raw file download. '-' reads stdin."""
    if spec == "-":
        p = _materialize_stdin()
        return p, (lambda: shutil.rmtree(os.path.dirname(p), ignore_errors=True)
                   if not keep else None), "<stdin>", True
    if not _looks_like_repo(spec):
        return spec, (lambda: None), spec, False
    url, label = _normalize_repo_url(spec)
    errors: list[str] = []
    tmp: Optional[str] = None
    flavor = _classify_remote(spec)
    if flavor == "repo":
        if shutil.which("git"):
            try:
                tmp = _clone_repo(url, ref)
            except RuntimeError as e:
                errors.append(f"git: {e}")
        if tmp is None:
            try:
                tmp = _fetch_forge_tarball(url, ref)
            except (urllib.error.URLError, RuntimeError, OSError,
                    tarfile.TarError, ValueError) as e:
                errors.append(f"tarball: {e}")
    if tmp is None and url.lower().startswith("https://"):
        try:
            tmp = _fetch_raw_url(url)
        except (urllib.error.URLError, RuntimeError, OSError, ValueError) as e:
            errors.append(f"raw: {e}")
    if tmp is None:
        raise RuntimeError("could not fetch target — " + " | ".join(errors)
                           + ("" if url.lower().startswith("https://")
                              else " (raw downloads are HTTPS-only)"))

    def cleanup() -> None:
        if not keep:
            shutil.rmtree(tmp if os.path.isdir(tmp) else os.path.dirname(tmp),
                          ignore_errors=True)

    return tmp, cleanup, label, True


# --------------------------------------------------------------------------- #
# Interactive mode: per-threat remediation prompt + filesystem browser
# --------------------------------------------------------------------------- #
_ACTION_HELP = """\
  actions for this file:
    n  neutralize — comment out the flagged line(s), keep a .bak (reversible)
    q  quarantine — gzip the whole file into the vault, remove original (restorable)
    e  erase      — permanently delete the file (NOT restorable)
    i  ignore     — accept these findings; never report them again (persisted)
    s  skip       — do nothing now
    a  auto       — apply each rule's recommended action
    capital letter (N/Q/E/I/S/A) applies the choice to ALL remaining files
    ?  show this help"""


def _render_finding(f: Finding, root: str) -> None:
    loc = f"{_rel(f.path, root)}:{f.line}:{f.column}"
    print(f"    {_sev(f.rule.severity)} {_c(f.rule.rid, _DIM)} "
          f"{_BOLD if _USE_COLOR else ''}{f.rule.name}{_RESET if _USE_COLOR else ''}")
    print(f"        {_c(loc, _SEV_COLOR['LOW'])}")
    if f.snippet:
        print(f"        {_c(f.snippet, _DIM)}")
    print(f"        {_c('recommended: ' + f.rule.action + ' — ' + f.rule.remediation, _DIM)}")


def interactive_remediate(scanner: "Scanner", root: str, findings: list[Finding],
                          qdir: str, input_fn=input) -> dict:
    """Walk the user through every threatened file and apply their decisions.
    Findings inside archives (path contains '!') cannot be fixed member-by-member
    in place — they are listed, and the user may quarantine/erase/ignore/skip the
    archive as a whole."""
    on_disk: dict[str, list[Finding]] = {}
    for f in findings:
        real = os.path.join(root, f.path.split("!", 1)[0]) if "!" in f.path else f.path
        on_disk.setdefault(real, []).append(f)

    print(_c(f"\n  interactive remediation — {len(findings)} finding(s) in "
             f"{len(on_disk)} file(s)", _BOLD))
    print(_c("  every action asks you first; nothing is touched on skip/ignore.", _DIM))

    decisions: dict[tuple, str] = {}
    to_ignore: list[Finding] = []
    synthetic: list[Finding] = []
    bulk: Optional[str] = None
    act_names = {"n": "neutralize", "q": "quarantine", "e": "erase",
                 "i": "ignore", "s": "skip", "a": "auto"}

    for idx, (path, items) in enumerate(on_disk.items(), 1):
        worst = min(items, key=lambda f: _SEV_RANK[f.rule.severity]).rule.severity
        in_archive = any("!" in f.path for f in items)
        print(f"\n  [{idx}/{len(on_disk)}] {_sev(worst)} "
              f"{_BOLD if _USE_COLOR else ''}{_rel(path, root)}{_RESET if _USE_COLOR else ''}"
              + (_c("  (threat inside archive — file-level actions only)", _DIM)
                 if in_archive else ""))
        for f in items:
            _render_finding(f, root)

        choice = None
        if bulk:
            choice = bulk
        else:
            while choice is None:
                try:
                    raw = input_fn("  action [n/q/e/i/s/a, ?=help]: ").strip()
                except (EOFError, KeyboardInterrupt):
                    print(_c("\n  stopped — remaining files skipped", _DIM))
                    bulk = "s"
                    choice = "s"
                    break
                if raw == "?":
                    print(_ACTION_HELP)
                    continue
                low = raw.lower()
                if low in act_names:
                    if raw.isupper():
                        bulk = low
                    choice = low
                else:
                    print(_c("  n, q, e, i, s, a or ? — capital letter = all remaining",
                             _DIM))

        if choice == "e":
            try:
                sure = input_fn(f"  really erase {path} permanently? "
                                f"This cannot be undone. Type yes to confirm: ").strip()
            except (EOFError, KeyboardInterrupt):
                sure = ""
            if sure.lower() != "yes":
                print(_c("  not confirmed — skipping file", _DIM))
                choice = "s"

        if choice == "i":
            to_ignore.extend(items)
        if choice == "a":
            continue                       # rule defaults: leave undecided
        action = {"n": "neutralize", "q": "quarantine", "e": "erase",
                  "i": "skip", "s": "skip"}[choice]
        if in_archive:
            if action == "neutralize":
                print(_c("  cannot neutralize a single line inside an archive — "
                         "skipping (quarantine or erase the archive instead)", _DIM))
                action = "skip"
            # member findings carry logical 'arc!member' paths that do not exist
            # on disk — act on the archive file itself instead
            for f in items:
                decisions[(f.path, f.rule.rid, f.line)] = "skip"
            if action in ("quarantine", "erase"):
                outer = [f for f in items if f.path == path]
                if outer:
                    for f in outer:
                        decisions[(f.path, f.rule.rid, f.line)] = action
                else:
                    sf = Finding(path, 1, 1, items[0].rule,
                                 "archive with flagged members")
                    synthetic.append(sf)
                    decisions[(sf.path, sf.rule.rid, sf.line)] = action
        else:
            for f in items:
                decisions[(f.path, f.rule.rid, f.line)] = action

    rem = Remediator(qdir, dry_run=False)
    rem.apply_decisions(list(findings) + synthetic, decisions)
    n_ign = add_ignores(to_ignore) if to_ignore else 0

    print(_c("\n  remediation: ", _BOLD) + _c("APPLIED", _SEV_COLOR["HIGH"]))
    print(_c(f"    neutralized: {len(rem.neutralized)} line(s)  ·  "
             f"quarantined: {len(rem.quarantined)}  ·  erased: {len(rem.erased)}  ·  "
             f"ignored: {n_ign}  ·  untouched: {len(rem.skipped)}", _DIM))
    if rem.quarantined:
        print(_c(f"    vault: {qdir}  (undo: nemesis restore all --quarantine-dir "
                 f"{qdir})", _DIM))
    if n_ign:
        print(_c("    review ignores anytime: nemesis ignore --list", _DIM))
    return {"neutralized": len(rem.neutralized), "quarantined": len(rem.quarantined),
            "erased": len(rem.erased), "ignored": n_ign, "skipped": len(rem.skipped)}


def cmd_ui(args) -> int:
    """Terminal file browser: walk the filesystem from cwd, pick a target, scan it
    recursively, then hand findings to the interactive remediation loop."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("nemesis ui needs an interactive terminal", file=sys.stderr)
        return 2
    cur = os.path.abspath(os.path.expanduser(getattr(args, "start", None) or os.getcwd()))
    target: Optional[str] = None
    if os.path.isfile(cur):
        target = cur
    filt = ""
    while target is None:
        try:
            entries = sorted(os.scandir(cur),
                             key=lambda e: (not e.is_dir(follow_symlinks=False),
                                            e.name.lower()))
        except OSError as e:
            print(_c(f"  cannot open {cur}: {e}", _SEV_COLOR["HIGH"]))
            cur = os.path.dirname(cur) or os.path.sep
            continue
        if filt:
            entries = [e for e in entries if filt.lower() in e.name.lower()]
        print(_c(f"\n  nemesis v{__version__} — browse & scan", _BOLD))
        print(_c(f"  {cur}" + (f"   (filter: {filt!r})" if filt else ""), _DIM))
        shown = entries[:60]
        for i, e in enumerate(shown, 1):
            is_dir = e.is_dir(follow_symlinks=False)
            mark = "/" if is_dir else (
                "  [archive]" if e.name.lower().endswith(_TREE_ARCHIVE_EXTS) else "")
            print(f"   {i:>3}  {e.name}{mark}")
        if len(entries) > len(shown):
            print(_c(f"   … {len(entries) - len(shown)} more — narrow with /text", _DIM))
        if not entries:
            print(_c("   (empty)", _DIM))
        print(_c("  number=open · s=scan this dir · ..=up · /text=filter · "
                 "path=jump · q=quit", _DIM))
        try:
            raw = input("  > ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if raw.lower() == "q":
            return 0
        if raw == "" or raw.lower() == "s":
            target = cur
            break
        if raw == "..":
            cur, filt = os.path.dirname(cur) or os.path.sep, ""
            continue
        if raw.startswith("/"):
            filt = raw[1:]
            continue
        if raw.isdigit() and 1 <= int(raw) <= len(shown):
            e = shown[int(raw) - 1]
            if e.is_dir(follow_symlinks=False):
                cur, filt = e.path, ""
            else:
                target = e.path
            continue
        p = os.path.abspath(os.path.expanduser(raw))
        if os.path.isdir(p):
            cur, filt = p, ""
        elif os.path.isfile(p):
            target = p
        else:
            print(_c(f"  no such path: {raw}", _DIM))

    ns = argparse.Namespace(
        path=target, interactive=True, gate=False,
        db_dir=getattr(args, "db_dir", _DEFAULT_DB_DIR),
        no_feeds=getattr(args, "no_feeds", False),
        exclude=getattr(args, "exclude", []) or [],
        no_ext_engines=getattr(args, "no_ext_engines", False),
        timeout=getattr(args, "timeout", 0),
    )
    return _scan_with_timeout(ns)


def cmd_ignore(args) -> int:
    """List / edit the persistent per-finding ignore store."""
    data = _load_ignores()
    entries = data["entries"]
    if getattr(args, "clear", False):
        if not entries:
            print(_c("  ignore list is already empty", _DIM))
            return 0
        _save_ignores({"version": 1, "entries": []})
        print(_c(f"  cleared {len(entries)} ignored finding(s)", _BOLD))
        return 0
    n = getattr(args, "remove", None)
    if n is not None:
        if not 1 <= n <= len(entries):
            print(f"no entry #{n} (1..{len(entries)})", file=sys.stderr)
            return 2
        gone = entries.pop(n - 1)
        _save_ignores(data)
        print(_c(f"  removed #{n}: {gone.get('rule')} @ {gone.get('path')}", _BOLD))
        return 0
    if not entries:
        print(_c("  no ignored findings — add them from the interactive prompt "
                 "([i]gnore)", _DIM))
        return 0
    print(_c(f"  {len(entries)} ignored finding(s)  ·  {_ignores_path()}", _BOLD))
    for i, e in enumerate(entries, 1):
        print(f"  {i:>3}  {e.get('rule')}  {e.get('path')}:{e.get('line')}")
        snip = e.get("snippet")
        if snip:
            print(_c(f"       {snip}", _DIM))
        print(_c(f"       since {e.get('added_at', '?')}", _DIM))
    print(_c("  remove one: nemesis ignore --remove N   ·   all: --clear", _DIM))
    return 0


