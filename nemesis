}


# -- db file IO ------------------------------------------------------------- #
def _load_set(path: str) -> set:
    if not os.path.exists(path):
        return set()
    with open(path, encoding="utf-8") as fh:
        return {ln.strip() for ln in fh if ln.strip() and not ln.startswith("#")}


def _merge_lines(path: str, items: Iterable[str]) -> int:
    existing = _load_set(path)
    before = len(existing)
    existing |= {i.strip() for i in items if i.strip()}
    with open(path, "w", encoding="utf-8") as fh:
        for i in sorted(existing):
            fh.write(i + "\n")
    return len(existing) - before


def _manifest_file(db_dir: str) -> str:
    return os.path.join(db_dir, "manifest.json")


def _read_manifest(db_dir: str) -> dict:
    p = _manifest_file(db_dir)
    if os.path.exists(p):
        try:
            with open(p, encoding="utf-8") as fh:
                return json.load(fh)
        except (OSError, json.JSONDecodeError):
            return {}
    return {}


def _write_manifest(db_dir: str, m: dict) -> None:
    with open(_manifest_file(db_dir), "w", encoding="utf-8") as fh:
        json.dump(m, fh, indent=2)
        fh.write("\n")


def _is_fresh(rec: dict, ttl: int) -> bool:
    try:
        dt = datetime.fromisoformat(rec.get("fetched_at", ""))
    except ValueError:
        return False
    return (datetime.now(timezone.utc) - dt).total_seconds() < ttl


_DB_STALE_DAYS = 14


def _db_health(db_dir: str) -> dict:
    """Seeded/staleness summary of the loaded signature DB, for warnings and the
    verdict provenance. A scan with an empty DB still runs (regex/AST/heuristics)
    but silently loses the hash/IOC/ndb/CVE layers — consumers must see that."""
    seeded = bool(HASH_BLOCKLIST or HASH_BLOCKLIST_SHA1 or HASH_BLOCKLIST_MD5
                  or URL_BLOCKLIST or DOMAIN_BLOCKLIST or IP_BLOCKLIST
                  or IP_CIDR_BLOCKLIST or _NDB_SIGS or OSV_DIR)
    age_days = None
    for rec in _read_manifest(db_dir).values():
        try:
            dt = datetime.fromisoformat(rec.get("fetched_at", ""))
        except (ValueError, AttributeError):
            continue
        d = (datetime.now(timezone.utc) - dt).total_seconds() / 86400
        age_days = d if age_days is None else min(age_days, d)
    return {"seeded": seeded, "age_days": round(age_days, 1) if age_days is not None else None,
            "stale": seeded and (age_days is None or age_days > _DB_STALE_DAYS)}


def load_db(db_dir: str) -> None:
    """Populate the in-memory blocklists from the cached signature DB."""
    if not os.path.isdir(db_dir):
        return
    HASH_BLOCKLIST.update(_load_set(os.path.join(db_dir, _DB_FILES["sha256"])))
    HASH_BLOCKLIST_SHA1.update(_load_set(os.path.join(db_dir, _DB_FILES["sha1"])))
    HASH_BLOCKLIST_MD5.update(_load_set(os.path.join(db_dir, _DB_FILES["md5"])))
    URL_BLOCKLIST.update(_load_set(os.path.join(db_dir, _DB_FILES["url"])))
    DOMAIN_BLOCKLIST.update(_load_set(os.path.join(db_dir, _DB_FILES["domain"])))
    IP_BLOCKLIST.update(_load_set(os.path.join(db_dir, _DB_FILES["ip"])))
    # CIDR/range IOCs (FireHOL/Spamhaus) → parsed networks for containment matching.
    _IP_CIDR_MEMO.clear()
    for c in _load_set(os.path.join(db_dir, _DB_FILES["ipcidr"])):
        try:
            IP_CIDR_BLOCKLIST.append(ipaddress.ip_network(c, strict=False))
        except ValueError:
            continue
    KEV_SET.update(_load_set(os.path.join(db_dir, _DB_FILES["kev"])))
    ALLOWLIST.update(_load_set(os.path.join(db_dir, "allowlist.txt")))
    ALLOWLIST.update(load_config().get("allowlist", []) or [])
    global OSV_DIR, _LOADED_DB_SIG
    osv = os.path.join(db_dir, "osv")
    OSV_DIR = osv if os.path.isdir(osv) else None
    _OSV_CACHE.clear()
    load_ndb(os.path.join(db_dir, _DB_FILES["ndb"]))   # compile ClamAV body sigs (P4)
    # Stat-fingerprint of everything just loaded — keys the verdict cache, so any
    # feed update / allowlist edit / OSV rebuild invalidates cached verdicts.
    h = hashlib.sha256()
    paths = [os.path.join(db_dir, f) for f in _DB_FILES.values()]
    paths += [os.path.join(db_dir, "allowlist.txt"), _CONFIG_PATH]
    if OSV_DIR:
        try:
            paths += [os.path.join(OSV_DIR, fn) for fn in sorted(os.listdir(OSV_DIR))]
        except OSError:
            pass
    for p in paths:
        try:
            st = os.stat(p)
            h.update(f"{p}|{st.st_size}|{int(st.st_mtime)};".encode())
        except OSError:
            h.update(f"{p}|absent;".encode())
    _LOADED_DB_SIG = h.hexdigest()[:16]
    # Pre-CVSS OSV index (built before v1.8.0) → severities are GHSA labels only.
    if OSV_DIR and not os.path.exists(os.path.join(OSV_DIR, "_meta.json")):
        try:
            has_idx = any(fn.endswith(".json") for fn in os.listdir(OSV_DIR))
        except OSError:
            has_idx = False
        if has_idx:
            print(_c("  note: OSV index predates CVSS-vector severities — rebuild "
                     "with: nemesis update --feed osv --force", _DIM), file=sys.stderr)


def update_feeds(db_dir: str, only: Optional[list[str]] = None,
                 force: bool = False, list_only: bool = False,
                 include_optin: bool = False,
                 ecosystems: Optional[list[str]] = None) -> int:
    authkey, _src = resolve_authkey()
    os.makedirs(db_dir, exist_ok=True)
    manifest = _read_manifest(db_dir)

    if list_only:
        print(_c(f"\n  nemesis feeds  ·  db: {db_dir}", _BOLD))
        print(_c("  " + "─" * 64, _DIM))
        for f in FEEDS:
            rec = manifest.get(f.name, {})
            when = rec.get("fetched_at", "never")
            n = sum(rec.get("counts", {}).values()) if rec else 0
            state = "on" if f.enabled else "opt-in"
            auth = "auth" if f.requires_auth else "open"
            print(f"  {f.name:<16} [{state}/{auth}]  last={when}  items={n}")
            print(_c(f"      {f.license}  ·  {f.note}", _DIM))
        print(_c("\n  " + _ATTRIBUTION, _DIM))
        return 0

    if only:
        unknown = set(only) - {f.name for f in FEEDS}
        if unknown:
            print(_c(f"unknown feed(s): {sorted(unknown)}", _SEV_COLOR["HIGH"]),
                  file=sys.stderr)
            return 2
    # config overrides: {"feeds": {"<name>": {"enabled": bool, "ttl": secs}}}
    feeds_cfg = (load_config().get("feeds") or {})

    def _enabled(f: Feed) -> bool:
        ov = feeds_cfg.get(f.name, {})
        return bool(ov.get("enabled", f.enabled))

    def _ttl(f: Feed) -> int:
        ov = feeds_cfg.get(f.name, {})
        try:
            return int(ov.get("ttl", f.ttl))
        except (TypeError, ValueError):
            return f.ttl

    if only:
        selected = [f for f in FEEDS if f.name in only]
    elif include_optin:
        selected = list(FEEDS)
    else:
        selected = [f for f in FEEDS if _enabled(f)]
    if not selected:
        print("no feeds selected", file=sys.stderr)
        return 2

    rc = 0
    print(_c(f"\n  nemesis update  ·  db: {db_dir}", _BOLD))
    for feed in selected:
        if feed.requires_auth and not authkey:
            print(_c(f"  skip {feed.name}: needs an abuse.ch Auth-Key — set env "
                     f"NEMESIS_ABUSECH_AUTHKEY or config 'abusech_authkey' "
                     f"(register free at https://auth.abuse.ch/)",
                     _SEV_COLOR["MEDIUM"]))
            rc = max(rc, 1)
            continue
        prev = manifest.get(feed.name)
        if prev and not force and _is_fresh(prev, _ttl(feed)):
            print(_c(f"  fresh {feed.name}: within TTL, skipped (--force to refresh)",
                     _DIM))
            continue
        if feed.handler == "yarahub":   # ruleset file, not line sets
            try:
                blob = _http_fetch(feed.url, {}, feed.size_cap)
                ydir = os.path.join(db_dir, "yara")
                os.makedirs(ydir, exist_ok=True)
                n_rules = 0
                parts: list[bytes] = []
                with zipfile.ZipFile(io.BytesIO(blob)) as z:
                    for nm in z.namelist():
                        if nm.endswith((".yar", ".yara")) and not nm.endswith("/"):
                            data = z.read(nm)
                            parts.append(b"// ---- %s ----\n" % nm.encode() + data + b"\n")
                            n_rules += data.count(b"rule ")
                with open(os.path.join(ydir, "yarahub.yar"), "wb") as fh:
                    fh.write(b"".join(parts))
                manifest[feed.name] = {
                    "source": feed.url, "license": feed.license,
                    "fetched_at": datetime.now(timezone.utc).isoformat(),
                    "counts": {"yara_rules": n_rules},
                    "payload_sha256": hashlib.sha256(blob).hexdigest(),
                    "payload_bytes": len(blob),
                }
                print(_c(f"  ok   yarahub: ~{n_rules} rules -> {ydir}/yarahub.yar",
                         _SEV_COLOR["LOW"]))
            except (urllib.error.URLError, urllib.error.HTTPError, RuntimeError,
                    OSError, ValueError, zipfile.BadZipFile) as e:
                print(_c(f"  FAIL {feed.name}: {e}", _SEV_COLOR["HIGH"]))
                rc = max(rc, 1)
            continue
        if feed.handler == "osv":  # SCA advisories → on-disk index, not line sets
            try:
                counts = _update_osv(db_dir, ecosystems=tuple(ecosystems)
                                     if ecosystems else _OSV_DEFAULT_ECOS)
            except (urllib.error.URLError, urllib.error.HTTPError, RuntimeError,
                    OSError, ValueError, zipfile.BadZipFile) as e:
                print(_c(f"  FAIL {feed.name}: {e}", _SEV_COLOR["HIGH"]))
                rc = max(rc, 1)
                continue
            manifest[feed.name] = {
                "source": feed.url, "license": feed.license,
                "fetched_at": datetime.now(timezone.utc).isoformat(), "counts": counts,
            }
            print(_c(f"  ok   osv: {sum(counts.values())} advisories "
                     f"({', '.join(f'{k}={v}' for k, v in counts.items())})", _SEV_COLOR["LOW"]))
            continue
        try:
            buckets = _FEED_HANDLERS[feed.handler](feed, authkey)
        except (urllib.error.URLError, urllib.error.HTTPError, RuntimeError,
                OSError, ValueError, json.JSONDecodeError) as e:
            print(_c(f"  FAIL {feed.name}: {e}", _SEV_COLOR["HIGH"]))
            rc = max(rc, 1)
            continue
        counts = {}
        added_total = 0
        for kind, items in buckets.items():
            if not items:
                continue
            added = _merge_lines(os.path.join(db_dir, _DB_FILES[kind]), items)
            counts[kind] = len(items)
            added_total += added
        manifest[feed.name] = {
            "source": feed.url,
            "license": feed.license,
            "fetched_at": datetime.now(timezone.utc).isoformat(),
            "counts": counts,
            # integrity: what the merged DB files look like after this feed ran
            "db_files": {
                _DB_FILES[k]: {"bytes": os.path.getsize(os.path.join(db_dir, _DB_FILES[k])),
                               "sha256": _sha256_file(os.path.join(db_dir, _DB_FILES[k]))}
                for k in counts if os.path.exists(os.path.join(db_dir, _DB_FILES[k]))
            },
        }
        detail = ", ".join(f"{k}={v}" for k, v in counts.items()) or "none"
        print(_c(f"  ok   {feed.name}: +{added_total} new of {sum(counts.values())} "
                 f"fetched indicators ({detail})", _SEV_COLOR["LOW"]))
    _write_manifest(db_dir, manifest)
    print(_c("\n  " + _ATTRIBUTION, _DIM))
    return rc


