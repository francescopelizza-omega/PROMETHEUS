def load_config() -> dict:
    if os.path.exists(_CONFIG_PATH):
        try:
            with open(_CONFIG_PATH, encoding="utf-8") as fh:
                return json.load(fh)
        except (OSError, json.JSONDecodeError):
            return {}
    return {}


def save_config(cfg: dict) -> None:
    """Persist config to ~/.nemesis/config.json with 0600 perms (holds a secret)."""
    os.makedirs(_NEMESIS_HOME, exist_ok=True)
    tmp = _CONFIG_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")
    try:
        os.chmod(tmp, 0o600)
    except OSError:
        pass
    os.replace(tmp, _CONFIG_PATH)


def resolve_authkey() -> tuple[str, str]:
    """Return (key, source). Precedence: env > config.json > hard-coded constant."""
    env = os.environ.get(_AUTHKEY_ENV, "").strip()
    if env:
        return env, f"env {_AUTHKEY_ENV}"
    cfg = load_config().get("abusech_authkey", "")
    if cfg:
        return cfg.strip(), "config.json"
    if _HARDCODED_AUTHKEY:
        return _HARDCODED_AUTHKEY.strip(), "hard-coded constant"
    return "", "none"


def _shell_rc_path() -> str:
    """The login shell rc file to persist the export into (macOS vs Linux)."""
    if sys.platform == "darwin":
        return os.path.join(os.path.expanduser("~"), ".zprofile")
    return os.path.join(os.path.expanduser("~"), ".bashrc")


_RC_MARKER = "# >>> nemesis abuse.ch Auth-Key >>>"
_RC_END = "# <<< nemesis abuse.ch Auth-Key <<<"


def _write_shell_rc(key: str) -> str:
    """Idempotently add/replace the export block in the user's shell rc. Returns path."""
    rc = _shell_rc_path()
    block = f'{_RC_MARKER}\nexport {_AUTHKEY_ENV}="{key}"\n{_RC_END}\n'
    try:
        with open(rc, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        text = ""
    if _RC_MARKER in text and _RC_END in text:
        pre = text[: text.index(_RC_MARKER)]
        post = text[text.index(_RC_END) + len(_RC_END):].lstrip("\n")
        text = pre + block + post
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += block
    with open(rc, "w", encoding="utf-8") as fh:
        fh.write(text)
    return rc


# -- network (HTTPS-only, size-capped, SSRF-guarded) ----------------------- #
def _resolve_is_internal(host: str) -> bool:
    """True if `host` resolves to ANY private/loopback/link-local/reserved address
    (SSRF guard). Fail-closed: an unresolvable host is treated as internal."""
    if not host:
        return True
    try:
        infos = socket.getaddrinfo(host, None)
    except (socket.gaierror, OSError, UnicodeError):
        return True
    for info in infos:
        try:
            ip = ipaddress.ip_address(info[4][0])
        except ValueError:
            return True
        if (ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved
                or ip.is_multicast or ip.is_unspecified):
            return True
    return False


class _NoInternalRedirect(urllib.request.HTTPRedirectHandler):
    """Reject any redirect that is non-HTTPS or points at an internal address — a
    feed host that 302s to https://169.254.169.254/… would otherwise reach cloud
    metadata while still 'HTTPS' (SSRF via redirect)."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # type: ignore[override]
        if not newurl.lower().startswith("https://"):
            raise RuntimeError(f"refusing non-HTTPS redirect: {newurl}")
        if _resolve_is_internal(urllib.parse.urlsplit(newurl).hostname or ""):
            raise RuntimeError(f"refusing redirect to an internal address: {newurl}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def _http_fetch(url: str, headers: dict, size_cap: int,
                data: Optional[bytes] = None, timeout: int = 60) -> bytes:
    if not url.lower().startswith("https://"):
        raise RuntimeError(f"refusing non-HTTPS feed URL: {url}")
    if _resolve_is_internal(urllib.parse.urlsplit(url).hostname or ""):
        raise RuntimeError(f"refusing feed URL that resolves to an internal address: {url}")
    hdrs = {"User-Agent": f"nemesis/{__version__}"}
    hdrs.update(headers or {})
    req = urllib.request.Request(
        url, data=data, headers=hdrs,
        method="POST" if data is not None else "GET")
    opener = urllib.request.build_opener(_NoInternalRedirect())
    with opener.open(req, timeout=timeout) as resp:  # nosec - HTTPS + SSRF guard enforced
        if not resp.geturl().lower().startswith("https://"):
            raise RuntimeError(f"feed redirected to non-HTTPS URL: {resp.geturl()}")
        buf = bytearray()
        while True:
            chunk = resp.read(1 << 16)
            if not chunk:
                break
            buf.extend(chunk)
            if len(buf) > size_cap:
                raise RuntimeError(
                    f"feed exceeds size cap ({size_cap} bytes): {url}")
        return bytes(buf)


# -- ClamAV CVD: 512-byte ASCII header + gzip'd tar of the DB files --------- #
def _unpack_cvd(blob: bytes, max_bytes: int = 1_500_000_000) -> dict[str, bytes]:
    body = blob[512:] if blob[:11] == b"ClamAV-VDB:" else blob
    try:
        tar_bytes = gzip.decompress(body)
    except (OSError, EOFError):
        tar_bytes = body  # already a plain tar
    out: dict[str, bytes] = {}
    total = 0
    with tarfile.open(fileobj=io.BytesIO(tar_bytes), mode="r:") as tf:
        for m in tf.getmembers():
            if not m.isfile():
                continue
            total += m.size
            if total > max_bytes:
                raise RuntimeError("CVD archive exceeds extraction cap (zip-bomb guard)")
            fh = tf.extractfile(m)
            if fh is not None:
                out[os.path.basename(m.name)] = fh.read()
    return out


def _parse_clamav_hash(content: bytes) -> tuple[set, set, set]:
    """Parse .hsb/.hdb lines `hash:size:name` -> (sha256, sha1, md5) sets."""
    sha256, sha1, md5 = set(), set(), set()
    for line in content.decode("utf-8", "replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        h = line.split(":", 1)[0].strip().lower()
        if not h or not all(c in "0123456789abcdef" for c in h):
            continue
        if len(h) == 64:
            sha256.add(h)
        elif len(h) == 40:
            sha1.add(h)
        elif len(h) == 32:
            md5.add(h)
    return sha256, sha1, md5


_SHA256_TOKEN_RX = re.compile(rb"\b[0-9a-fA-F]{64}\b")


def _harvest_sha256(blob: bytes, max_bytes: int = 2_000_000_000) -> set:
    """Pull all SHA256 tokens out of a text/CSV blob, or a zip of such files."""
    out: set = set()
    if blob[:2] == b"PK":  # zip archive
        with zipfile.ZipFile(io.BytesIO(blob)) as z:
            total = 0
            for info in z.infolist():
                total += info.file_size
                if total > max_bytes:
                    raise RuntimeError("zip export exceeds extraction cap (zip-bomb guard)")
                with z.open(info) as fh:
                    data = fh.read()
                out |= {m.group(0).decode().lower() for m in _SHA256_TOKEN_RX.finditer(data)}
    else:
        out |= {m.group(0).decode().lower() for m in _SHA256_TOKEN_RX.finditer(blob)}
    return out


# -- per-feed handlers: return {kind: set(indicators)} ---------------------- #
def _fetch_clamav(feed: Feed, authkey: str) -> dict:
    blob = _http_fetch(feed.url, {"User-Agent": _CLAMAV_UA}, feed.size_cap)
    members = _unpack_cvd(blob)
    sha256, sha1, md5, ndb = set(), set(), set(), set()
    for name, content in members.items():
        if name.endswith((".hsb", ".hdb", ".msb", ".mdb")):
            s2, s1, m = _parse_clamav_hash(content)
            sha256 |= s2
            sha1 |= s1
            md5 |= m
        elif name.endswith(".ndb"):     # body-based signatures (P4)
            for line in content.decode("utf-8", "replace").splitlines():
                line = line.strip()
                if line and not line.startswith("#") and line.count(":") >= 3:
                    ndb.add(line)
    return {"sha256": sha256, "sha1": sha1, "md5": md5, "ndb": ndb}


def _fetch_threatfox(feed: Feed, authkey: str) -> dict:
    body = json.dumps({"query": "get_iocs", "days": _THREATFOX_DAYS}).encode()
    raw = _http_fetch(feed.url,
                      {"Auth-Key": authkey, "Content-Type": "application/json"},
                      feed.size_cap, data=body)
    obj = json.loads(raw.decode("utf-8", "replace"))
    if obj.get("query_status") != "ok":
        raise RuntimeError(f"threatfox query_status={obj.get('query_status')!r}")
    out = {"sha256": set(), "md5": set(), "url": set(), "domain": set(), "ip": set()}
    for d in obj.get("data", []):
        t, v = d.get("ioc_type"), (d.get("ioc") or "").strip()
        if not v:
            continue
        if t == "sha256_hash":
            out["sha256"].add(v.lower())
        elif t == "sha1_hash":
            out.setdefault("sha1", set()).add(v.lower())
        elif t == "md5_hash":
            out["md5"].add(v.lower())
        elif t == "url":
            out["url"].add(v)
        elif t == "domain":
            out["domain"].add(v.lower())
        elif t in ("ip:port", "ip"):
            out["ip"].add(v.rsplit(":", 1)[0])
    return out


def _fetch_malwarebazaar(feed: Feed, authkey: str) -> dict:
    body = urllib.parse.urlencode({"query": "get_recent", "selector": "time"}).encode()
    raw = _http_fetch(
        feed.url,
        {"Auth-Key": authkey,
         "Content-Type": "application/x-www-form-urlencoded"},
        feed.size_cap, data=body)
    obj = json.loads(raw.decode("utf-8", "replace"))
    if obj.get("query_status") != "ok":
        raise RuntimeError(f"malwarebazaar query_status={obj.get('query_status')!r}")
    sha256, md5 = set(), set()
    for d in obj.get("data", []):
        if d.get("sha256_hash"):
            sha256.add(d["sha256_hash"].lower())
        if d.get("md5_hash"):
            md5.add(d["md5_hash"].lower())
    return {"sha256": sha256, "md5": md5}


def _fetch_kev(feed: Feed, authkey: str) -> dict:
    """CISA Known Exploited Vulnerabilities → CVE-id set. A dependency advisory
    matching a KEV CVE is escalated to CRITICAL (actively exploited)."""
    raw = _http_fetch(feed.url, {}, feed.size_cap)
    obj = json.loads(raw.decode("utf-8", "replace"))
    cves = {str(v.get("cveID", "")).strip()
            for v in obj.get("vulnerabilities", []) if v.get("cveID")}
    return {"kev": cves}


def _fetch_urlhaus(feed: Feed, authkey: str) -> dict:
    """URLhaus online malware-URL dump (plain text, '#' comments)."""
    raw = _http_fetch(feed.url, {}, feed.size_cap)
    urls = {ln.strip() for ln in raw.decode("utf-8", "replace").splitlines()
            if ln.strip() and not ln.lstrip().startswith("#")
            and ln.strip().lower().startswith(("http://", "https://"))}
    return {"url": urls}


def _fetch_openphish(feed: Feed, authkey: str) -> dict:
    """OpenPhish community feed — one phishing URL per line, '#' comments. URL-injection L1."""
    raw = _http_fetch(feed.url, {}, feed.size_cap)
    urls = {ln.strip() for ln in raw.decode("utf-8", "replace").splitlines()
            if ln.strip() and not ln.lstrip().startswith("#")
            and ln.strip().lower().startswith(("http://", "https://"))}
    return {"url": urls}


def _fetch_firehol(feed: Feed, authkey: str) -> dict:
    """FireHOL netset — one IP or CIDR per line, '#' comments. Bare addresses go to
    the exact IP set; CIDR ranges go to the CIDR set (containment-matched). L1."""
    ips: set[str] = set()
    cidrs: set[str] = set()
    raw = _http_fetch(feed.url, {}, feed.size_cap)
    for ln in raw.decode("utf-8", "replace").splitlines():
        s = ln.strip()
        if not s or s.startswith("#"):
            continue
        try:
            if "/" in s:
                net = ipaddress.ip_network(s, strict=False)
                # a /32 (or /128) is just an exact address
                if net.num_addresses == 1:
                    ips.add(str(net.network_address))
                else:
                    cidrs.add(str(net))
            else:
                ipaddress.ip_address(s)
                ips.add(s)
        except ValueError:
            continue
    return {"ip": ips, "ipcidr": cidrs}


def _redact(text: str, secret: str) -> str:
    return text.replace(secret, "***") if secret else text


def _fetch_mb_full(feed: Feed, authkey: str) -> dict:
    # The full dump (all hashes, regenerated hourly) is exposed by more than one
    # endpoint depending on account/era. Try each, first that yields hashes wins.
    # Only 64-hex tokens (= sha256 column) are harvested; imphash/tlsh/telfhash are
    # 32/70+ hex and never match the \b[0-9a-f]{64}\b boundary.
    cfg = load_config()
    key = urllib.parse.quote(authkey, safe="")
    auth_hdr = {"Auth-Key": authkey}
    if cfg.get("malwarebazaar_full_url"):
        candidates = [(cfg["malwarebazaar_full_url"].format(key=key), auth_hdr)]
    else:
        candidates = [
            ("https://bazaar.abuse.ch/export/csv/full/", auth_hdr),
            (f"https://mb-api.abuse.ch/v2/files/exports/{key}/full.csv", {}),
            (f"https://mb-api.abuse.ch/downloads/csv/full/", auth_hdr),
        ]
    errors = []
    for url, hdrs in candidates:
        try:
            blob = _http_fetch(url, hdrs, feed.size_cap)
        except (urllib.error.HTTPError, urllib.error.URLError, RuntimeError) as e:
            errors.append(f"{_redact(url, authkey)}: {e}")
            continue
        sha = _harvest_sha256(blob, max_bytes=feed.size_cap * 4)
        if sha:
            return {"sha256": sha}
        errors.append(f"{_redact(url, authkey)}: 200 but 0 sha256 in {len(blob)}B")
    raise RuntimeError("no working full-export endpoint — tried: " + " | ".join(errors))


