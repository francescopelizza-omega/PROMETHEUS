def _url_host(url: str) -> str:
    try:
        # WHATWG: browsers/curl treat backslashes as forward slashes, so normalize them
        # BEFORE parsing. Otherwise "https://evil.com\@trusted.com/x" parses to
        # host=trusted.com here while a real client fetches evil.com — a trust-bypass
        # that would let a malicious URL survive `defang --keep trusted`.
        normalized = url.replace("\\", "/")
        return (urllib.parse.urlsplit(normalized).hostname or "").lower()
    except ValueError:
        return ""


