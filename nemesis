# Remediation
# --------------------------------------------------------------------------- #
_COMMENT_HASH = {".py", ".sh", ".bash", ".zsh", ".rb", ".pl", ".yaml", ".yml",
                 ".toml", ".cfg", ".ini", ".r", ".tcl", ".ps1", ""}
_COMMENT_SLASH = {".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx", ".c", ".h",
                  ".cpp", ".cc", ".hpp", ".java", ".go", ".rs", ".php", ".swift",
                  ".kt", ".scala", ".cs"}


def _comment_prefix(path: str) -> str:
    ext = os.path.splitext(path)[1].lower()
    if ext in _COMMENT_SLASH:
        return "// "
    return "# "


class Remediator:
    def __init__(self, quarantine_dir: str, dry_run: bool = True) -> None:
        self.quarantine_dir = quarantine_dir
        self.dry_run = dry_run
        self.neutralized: list[tuple[str, int]] = []
        self.quarantined: list[str] = []
        self.erased: list[str] = []
        self.skipped: list[str] = []          # report-only / deliberate no-ops
        self.errors: list[str] = []           # attempted but FAILED (io errors)
        self.manifest: list[dict] = []

    def apply(self, findings: list[Finding]) -> None:
        self.apply_decisions(findings, {})

    def apply_decisions(self, findings: list[Finding],
                        decisions: dict[tuple, str]) -> None:
        """Apply per-finding actions. `decisions` maps (path, rule_id, line) to one
        of erase|quarantine|neutralize|report|skip and overrides the rule's preset
        action; findings without a decision fall back to rule.action. erase wins
        over quarantine wins over neutralize when one file has mixed actions."""
        def act(f: Finding) -> str:
            return decisions.get((f.path, f.rule.rid, f.line), f.rule.action)

        by_file: dict[str, list[Finding]] = {}
        for f in findings:
            by_file.setdefault(f.path, []).append(f)

        for path, items in by_file.items():
            # logical archive-member paths ("arc.zip!member") do not exist on
            # disk — they cannot be remediated in place. Record as an explicit
            # failure so they are never mistaken for "resolved".
            if "!" in path:
                self.errors.append(f"{path}: in-archive finding — "
                                   f"cannot remediate member in place")
                continue
            actions = {act(f) for f in items}
            if "erase" in actions:
                self._erase(path, items)
                continue
            if "quarantine" in actions:
                self._quarantine(path, items)
                continue
            neutral = [f for f in items if act(f) == "neutralize"]
            if neutral:
                self._neutralize(path, neutral)
            else:
                self.skipped.append(path)  # report-only / skip

    # -- erase ----------------------------------------------------------- #
    def _erase(self, path: str, items: list[Finding]) -> None:
        """Permanent delete. Unlike quarantine there is no vault copy and no
        restore — only a manifest audit record (sha256 + rules) survives."""
        if self.dry_run:
            self.erased.append(path)
            return
        try:
            digest = _sha256_file(path)
        except OSError:
            digest = None
        try:
            os.remove(path)
        except OSError as e:
            self.errors.append(f"{path}: erase failed: {e}")
            return
        rec = {
            "id": f"{int(time.time()*1000):x}_{hashlib.sha1(path.encode()).hexdigest()[:8]}",
            "kind": "erased",
            "original_path": os.path.abspath(path),
            "sha256": digest,
            "erased_at": datetime.now(timezone.utc).isoformat(),
            "rules": sorted({f.rule.rid for f in items}),
        }
        self.manifest.append(rec)
        self.erased.append(path)
        try:
            os.makedirs(self.quarantine_dir, exist_ok=True)
            _append_manifest(self.quarantine_dir, rec)
        except OSError:
            pass  # the delete already happened; audit record is best-effort

    # -- quarantine ----------------------------------------------------- #
    def _quarantine(self, path: str, items: list[Finding]) -> None:
        if self.dry_run:
            self.quarantined.append(path)
            return
        os.makedirs(self.quarantine_dir, exist_ok=True)
        qid = f"{int(time.time()*1000):x}_{hashlib.sha1(path.encode()).hexdigest()[:8]}"
        dest = os.path.join(self.quarantine_dir, qid + ".gz")
        try:
            with open(path, "rb") as src, gzip.open(dest, "wb") as dst:
                shutil.copyfileobj(src, dst)
            orig_digest = _sha256_file(path)
            os.remove(path)
        except OSError as e:
            self.errors.append(f"{path}: quarantine failed: {e}")
            return
        rec = {
            "id": qid,
            "original_path": os.path.abspath(path),
            "vault_file": dest,
            "sha256": orig_digest,
            "quarantined_at": datetime.now(timezone.utc).isoformat(),
            "rules": sorted({f.rule.rid for f in items}),
        }
        self.manifest.append(rec)
        self.quarantined.append(path)
        _append_manifest(self.quarantine_dir, rec)

    # -- neutralize ----------------------------------------------------- #
    def _neutralize(self, path: str, items: list[Finding]) -> None:
        fname = os.path.basename(path)
        if fname == "package.json":
            leftover = self._neutralize_package_json(path, items)
            if leftover is not None and not leftover:
                return                   # everything handled JSON-aware
            # declined (None) or partial coverage: line-comment ALL findings —
            # the JSON rewrite would shift line numbers under the leftover ones
        lines_to_kill = sorted({f.line for f in items})
        if self.dry_run:
            for ln in lines_to_kill:
                self.neutralized.append((path, ln))
            return
        # read bytes and pick a round-trip-safe codec: strict utf-8 when valid,
        # else latin-1 (byte-preserving) — errors='replace' would corrupt the
        # untouched lines of a non-UTF8 source on rewrite.
        try:
            with open(path, "rb") as fh:
                raw = fh.read()
        except OSError as e:
            self.errors.append(f"{path}: {e}")
            return
        try:
            text = raw.decode("utf-8")
            codec = "utf-8"
        except UnicodeDecodeError:
            text = raw.decode("latin-1")
            codec = "latin-1"
        lines = text.splitlines(keepends=True)
        _backup(path)
        prefix = _comment_prefix(path)
        date = datetime.now(timezone.utc).date()
        bakname = os.path.basename(path) + ".nemesis.bak"
        rids_by_line: dict[int, set] = {}
        for f in items:
            rids_by_line.setdefault(f.line, set()).add(f.rule.rid)
        for ln in lines_to_kill:
            idx = ln - 1
            if 0 <= idx < len(lines):
                # Replace the offending line's *content* (not just comment it) so a
                # re-scan confirms the threat is gone. Original is preserved in .bak.
                indent = lines[idx][: len(lines[idx]) - len(lines[idx].lstrip())]
                rids = ",".join(sorted(rids_by_line.get(ln, {"?"})))
                lines[idx] = (f"{indent}{prefix}NEMESIS-NEUTRALIZED {date}: "
                              f"removed {rids} (original in {bakname})\n")
            self.neutralized.append((path, ln))
        try:
            with open(path, "w", encoding=codec) as fh:
                fh.writelines(lines)
        except OSError as e:
            self.errors.append(f"{path}: write failed: {e}")

    def _neutralize_package_json(self, path: str,
                                 items: list[Finding]) -> Optional[list[Finding]]:
        """JSON-aware removal of dangerous lifecycle scripts. Returns None when
        this path does not apply (caller line-comments everything), else the
        findings NOT covered by the lifecycle removal (may be empty)."""
        try:
            with open(path, "r", encoding="utf-8") as fh:
                raw_text = fh.read()
            data = json.loads(raw_text)
        except (OSError, json.JSONDecodeError):
            return None  # fall back to line commenting
        scripts = data.get("scripts")
        if not isinstance(scripts, dict):
            return None
        danger = {"preinstall", "install", "postinstall"}
        hit = [k for k in list(scripts) if k in danger]
        if not hit:
            return None
        # findings on the lifecycle lines are resolved by the key removal; any
        # other finding in the file still needs the line treatment
        lifecycle_lines = set()
        for k in hit:
            pos = raw_text.find(f'"{k}"')
            if pos >= 0:
                lifecycle_lines.add(raw_text.count("\n", 0, pos) + 1)
        covered = [f for f in items if f.line in lifecycle_lines]
        leftover = [f for f in items if f.line not in lifecycle_lines]
        if leftover:
            # partial coverage: rewriting JSON would shift the leftover findings'
            # line numbers — let the caller line-comment everything instead
            return leftover
        if self.dry_run:
            for f in covered:
                self.neutralized.append((path, f.line))
            return leftover
        _backup(path)
        removed = {k: scripts.pop(k) for k in hit}
        data.setdefault("_nemesis_removed_scripts", {}).update(removed)
        try:
            with open(path, "w", encoding="utf-8") as fh:
                json.dump(data, fh, indent=2)
                fh.write("\n")
        except OSError as e:
            self.errors.append(f"{path}: write failed: {e}")
            return leftover
        for f in covered:
            self.neutralized.append((path, f.line))
        return leftover


def _sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def _digests_bytes(data: bytes) -> tuple[str, str, str]:
    """(md5, sha1, sha256) hexdigests of an in-memory buffer."""
    return (
        hashlib.md5(data).hexdigest(),
        hashlib.sha1(data).hexdigest(),
        hashlib.sha256(data).hexdigest(),
    )


def _digests_file(path: str) -> tuple[str, str, str]:
    """(md5, sha1, sha256) hexdigests computed in a single streaming pass."""
    md5, sha1, sha256 = hashlib.md5(), hashlib.sha1(), hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 16), b""):
            md5.update(chunk)
            sha1.update(chunk)
            sha256.update(chunk)
    return md5.hexdigest(), sha1.hexdigest(), sha256.hexdigest()


def _backup(path: str) -> str:
    bak = path + ".nemesis.bak"
    if not os.path.exists(bak):
        shutil.copy2(path, bak)
    return bak


# --------------------------------------------------------------------------- #
# URL defang / wipe (URL-injection safeguard) — render an artifact URL-INERT
#
# "If there is no URL, there is nothing to rug-pull, cloak, or fetch-and-act on."
# Independent of the verdict (safe OR dangerous): excise EVERY dereferenceable URL
# from every text file so an installed plugin / skill / repo can never make an agent
# call out. Two modes: `star` replaces each URL character with `*` (keeps the line +
# its length, kills any callback/revival), `remove` deletes the whole line. The
# original is always preserved in <file>.nemesis.bak (reversible). Obfuscated URLs
# (charcode/escape/concat, base64/hex blobs) are neutralised at the SPAN that
# produced them. Binaries are not rewritten (would corrupt) — they are reported.
# --------------------------------------------------------------------------- #
_DEFANG_STAR = "*"

# Curated official AI-vendor doc / API domains + common dev infra. A literal URL on
# one of these hosts is the kind a skill legitimately needs (and that prometheus
# re-verifies offline every startup) — `defang --keep trusted` spares them while
# still wiping everything else. Obfuscated/encoded URLs are NEVER spared (an
# official doc link is never base64-hidden). User-extend via ~/.nemesis/trusted_domains.txt.
_BUILTIN_TRUSTED_DOMAINS = frozenset({
    # Anthropic / Claude
    "anthropic.com", "docs.anthropic.com", "console.anthropic.com", "api.anthropic.com",
    "claude.ai", "claude.com",
    # OpenAI
    "openai.com", "platform.openai.com", "api.openai.com", "help.openai.com",
    "cookbook.openai.com",
    # Google / Gemini
