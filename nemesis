def _load_hashes(path: str) -> None:
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            h = line.strip().lower().split()[0] if line.strip() else ""
            if not h or not all(c in "0123456789abcdef" for c in h):
                continue
            if len(h) == 64:
                HASH_BLOCKLIST.add(h)
            elif len(h) == 40:
                HASH_BLOCKLIST_SHA1.add(h)
            elif len(h) == 32:
                HASH_BLOCKLIST_MD5.add(h)


def _error_verdict(target: str, msg: str) -> dict:
    return {
        "schema": "nemesis.verdict/1", "tool": "nemesis", "tool_version": __version__,
        "target": target, "verdict": "error", "exit_code": 2,
        "recommendation": f"FAIL-CLOSED: {msg}", "error": msg,
        "scanned_at": datetime.now(timezone.utc).isoformat(),
    }


def _rescan_full(scanner: Scanner, root: str, opts: ArchiveOpts,
                 no_tree: bool = False) -> list[Finding]:
    """A fresh scan that mirrors the original: same config AND the in-tree archive
    pass, so residual checks can actually see inside vendored archives."""
    s = scanner.clone()
    out = s.scan(root)
    if os.path.isdir(root) and not no_tree:
        out += scan_tree_archives(s, root, opts)
    return out


def _disinfect_path(scanner: Scanner, root: str, findings: list[Finding],
                    opts: ArchiveOpts) -> None:
    """Disinfect a directory/file in place: remediate → re-scan → mark resolved.
    The residual scan is archive-aware, and findings inside archives (which the
    Remediator cannot touch member-by-member) count as UNRESOLVED, never resolved."""
    qdir = os.path.join(root if os.path.isdir(root) else os.path.dirname(root) or ".",
                        "__nemesis_quarantine__")
    rem = Remediator(qdir, dry_run=False)
    rem.apply(findings)
    residual = _rescan_full(scanner, root, opts)
    residual_ids = {(f.path, f.rule.rid, f.line) for f in residual}
    # in-archive findings can never be resolved in place — force them to residual
    in_archive = [f for f in findings if "!" in f.path]
    resolved = [f for f in findings
                if "!" not in f.path
                and (f.path, f.rule.rid, f.line) not in residual_ids]
    unresolved_rids = sorted({f.rule.rid for f in residual}
                             | {f.rule.rid for f in in_archive})
    scanner.last_archive_disinfection = {
        "applied": True,
        "neutralized_lines": len(rem.neutralized),
        "quarantined_files": len(rem.quarantined),
        "resolved_rules": sorted({f.rule.rid for f in resolved}),
        "unresolved_rules": unresolved_rids,
        "errors": rem.errors[:20],
    }
    if opts.out and os.path.isdir(root):
        _copy_clean(root, opts.out)
        scanner.last_archive_disinfection["output"] = os.path.abspath(opts.out)


class _ScanTimeout(BaseException):
    """Watchdog expiry. BaseException so the per-file/decoder `except Exception`
    handlers cannot swallow it — it must reach _scan_with_timeout."""


def _fail_closed(args, msg: str) -> int:
    """Emit the contracted fail-closed result for a scan that died unexpectedly.
    Gate mode: JSON error verdict + exit per policy on_error ('block' → 20,
    anything else → 2). Human mode: stderr + 2. Never a bare traceback."""
    if getattr(args, "gate", False):
        v = _error_verdict(getattr(args, "path", "?"), msg)
        policy = load_policy(getattr(args, "policy", None))
        if policy.get("on_error", "block") == "block":
            v["exit_code"] = _VERDICT_EXIT["block"]
            v["recommendation"] += "  (policy on_error=block)"
        print(json.dumps(v, indent=2))
        return v["exit_code"]
    print(_c(f"  scan failed: {msg}", _SEV_COLOR["HIGH"]), file=sys.stderr)
    return 2


def _scan_with_timeout(args) -> int:
    """Run run_scan under a SIGALRM watchdog (--timeout) and a fail-closed
    exception net. Note: a blocking C call (e.g. inside libarchive) is only
    interrupted when it returns to Python."""
    t = int(getattr(args, "timeout", 0) or 0)
    use_alarm = t > 0 and hasattr(signal, "SIGALRM")
    if t > 0 and not use_alarm:
        print(_c(f"  warning: --timeout {t}s requested but SIGALRM is unavailable "
                 f"on this platform — the scan runs with NO time limit",
                 _SEV_COLOR["MEDIUM"]), file=sys.stderr)

    def _alrm(signum, frame):
        raise _ScanTimeout(f"scan exceeded --timeout {t}s")

    old = signal.signal(signal.SIGALRM, _alrm) if use_alarm else None
    if use_alarm:
        signal.alarm(t)
    try:
        return run_scan(args)
    except _ScanTimeout as e:
        return _fail_closed(args, str(e))
    except KeyboardInterrupt:
        raise
    except Exception as e:  # noqa: BLE001 — the gate contract forbids tracebacks
        if os.environ.get("NEMESIS_DEBUG"):
            raise
        return _fail_closed(args, f"internal error: {e.__class__.__name__}: {e}")
    finally:
        if use_alarm:
            signal.alarm(0)
            signal.signal(signal.SIGALRM, old)


def run_scan(args) -> int:
    global _OSV_ONLINE, _LAST_EXTRACT_TIER
    _OSV_ONLINE = getattr(args, "osv_online", False)
    _LAST_EXTRACT_TIER = "none"
    gate = getattr(args, "gate", False)
    spec = args.path
    policy = load_policy(getattr(args, "policy", None))
    # URL-injection L1: fail-closed blind-ceiling on the install gate (a policy
    # file may still override it explicitly); plain `scan` keeps allow semantics.
    policy.setdefault("url_blind_ceiling", gate)
    allow_unscan = getattr(args, "allow_unscannable", False)
    if allow_unscan:
        policy["allow_unscannable"] = True
    disinfect = getattr(args, "disinfect", False)
    out = getattr(args, "out", None)

    is_remote = spec == "-" or _looks_like_repo(spec)
    if getattr(args, "offline", False):
        args.osv_online = False
        _OSV_ONLINE = False
        if is_remote and spec != "-":
            msg = "--offline: remote targets need the network — refused"
            if gate:
                print(json.dumps(_error_verdict(spec, msg), indent=2))
            else:
                print(_c(f"  {msg}", _SEV_COLOR["HIGH"]), file=sys.stderr)
            return 2
    if not is_remote and not os.path.exists(spec):
        if gate:
            print(json.dumps(_error_verdict(spec, "path not found"), indent=2))
            return 2
        print(_c(f"path not found: {spec}", _SEV_COLOR["HIGH"]), file=sys.stderr)
        return 2

    if is_remote and disinfect and not (out or getattr(args, "keep_clone", False)):
        msg = ("remote --disinfect needs --out DIR or --keep-clone — otherwise "
               "the disinfected snapshot is deleted after the scan")
        if gate:
            print(json.dumps(_error_verdict(spec, msg), indent=2))
        else:
            print(_c(f"  {msg}", _SEV_COLOR["HIGH"]), file=sys.stderr)
        return 2

    keep = getattr(args, "keep_clone", False) or getattr(args, "fix", False)
    cleanup = lambda: None
    label, root = spec, spec
    if is_remote:
        if not gate:
            print(_c(f"  fetching {spec} …", _DIM))
        try:
            root, cleanup, label, _ = materialize_target(spec, ref=getattr(args, "ref", None), keep=keep)
        except RuntimeError as e:
            if gate:
                print(json.dumps(_error_verdict(spec, f"fetch failed: {e}"), indent=2))
                return 2
            print(_c(f"fetch failed: {e}", _SEV_COLOR["HIGH"]), file=sys.stderr)
            return 2
        if not gate:
            print(_c(f"  scanning snapshot of {label}", _DIM))

    try:
        if getattr(args, "hashes", None):
            try:
                _load_hashes(args.hashes)
            except OSError as e:
                if gate:
                    print(json.dumps(_error_verdict(spec, f"cannot read hashes: {e}"), indent=2))
                else:
                    print(f"cannot read hashes: {e}", file=sys.stderr)
                return 2
        db_health = None
        if not getattr(args, "no_feeds", False):
            db_dir = getattr(args, "db_dir", _DEFAULT_DB_DIR)
            load_db(db_dir)
            db_health = _db_health(db_dir)
            if not gate:
                if not db_health["seeded"]:
                    print(_c("  warning: signature DB empty — hash/IOC/CVE layers "
                             "inactive. Seed with: nemesis update", _SEV_COLOR["MEDIUM"]),
                          file=sys.stderr)
                elif db_health["stale"]:
                    print(_c(f"  warning: signature DB is {db_health['age_days']:.0f} "
                             f"days old — refresh with: nemesis update",
                             _SEV_COLOR["MEDIUM"]), file=sys.stderr)

        sandbox = getattr(args, "sandbox", "auto")
        scanner = Scanner(
            skip_dirs=set() if getattr(args, "scan_vcs", False) else None,
            excludes=getattr(args, "exclude", []) or [],
            text_max=int(getattr(args, "max_text_mb", _TEXT_MAX / 1e6) * 1e6),
            flag_embedded_exe=not getattr(args, "no_exe_check", False),
        )
        sast_mode = getattr(args, "sast", "full") or "full"
        scanner.sast_mode = sast_mode
        if sast_mode == "off":
            scanner.rules = [r for r in scanner.rules if r.klass != "vuln"]
        elif sast_mode == "lite":
            scanner.rules = [r for r in scanner.rules
                             if r.klass != "vuln" or r.severity in ("CRITICAL", "HIGH")]
        is_archive = (os.path.isfile(root) and detect_archive(root) is not None
                      and sandbox != "off")
        passwords = list(getattr(args, "password", []) or [])
        pf = getattr(args, "password_file", None)
        if pf and os.path.exists(pf):
            try:
                with open(pf, encoding="utf-8") as fh:
                    passwords += [ln.strip() for ln in fh if ln.strip()]
            except OSError:
                pass
        aopts = ArchiveOpts(
            sandbox=sandbox,
            disinfect=disinfect or (is_archive and getattr(args, "fix", False)),
            out=out, allow_unscannable=allow_unscan,
            keep_extract=getattr(args, "keep_extract", False),
            max_depth=getattr(args, "max_depth", 2),
            max_ratio=getattr(args, "max_ratio", 100.0),
            passwords=tuple(passwords),
            jail=getattr(args, "jail", "auto"),
        )
        target_kind = "archive" if is_archive else ("dir" if os.path.isdir(root) else "file")

        # Verdict cache: a stable key over (file sha256 + DB/ruleset/policy/flags).
        # Used to short-circuit the gate hot path; human `scan` always re-renders.
        sign = getattr(args, "sign", False)
        use_cache = (not getattr(args, "no_cache", False) and not disinfect
                     and not is_remote and not _OSV_ONLINE
                     and not getattr(args, "fix", False))
        # external-engine DB version (clamscan/yara) is part of the cache key only
        # when engines are active — a freshclam/yara-rules update must invalidate a
        # cached verdict, since a cache hit skips re-running them.
        ext_sig = ("" if getattr(args, "no_ext_engines", False)
                   else _ext_engine_db_sig(load_config()))
        pw_sig = (hashlib.sha256("\x00".join(passwords).encode()).hexdigest()[:12]
                  if passwords else "")
        excl_sig = (hashlib.sha256("\x00".join(
            sorted(getattr(args, "exclude", []) or [])).encode()).hexdigest()[:8]
            if getattr(args, "exclude", None) else "")
        opts_sig = "|".join(str(x) for x in (
            sandbox, allow_unscan, getattr(args, "no_ext_engines", False),
            getattr(args, "no_feeds", False), aopts.max_depth, aopts.max_ratio,
            pw_sig, aopts.jail, getattr(args, "max_text_mb", ""),
            getattr(args, "scan_vcs", False), getattr(args, "no_exe_check", False),
            sast_mode, getattr(args, "hashes", None) or "", excl_sig,
            getattr(args, "no_tree_archives", False),
            ext_sig))
        ckey = _cache_key(root, policy, opts_sig) if use_cache else None
        if gate and ckey:
            hit = _cache_get(ckey)
            if hit is not None:
                if hit.get("target") != root:   # same content, different path
                    hit["target"] = root
                    hit.pop("signature", None)  # old signature covered the old path
                if sign and "signature" not in hit:
                    hit = sign_verdict(hit)
                if getattr(args, "json", None):
                    try:
                        with open(args.json, "w", encoding="utf-8") as fh:
                            json.dump(hit, fh, indent=2)
                    except OSError:
                        pass
                print(json.dumps(hit, indent=2))
                return hit.get("exit_code", 2)

        t0 = time.time()
        if is_archive:
            findings = scan_archive(scanner, root, aopts)
        else:
            no_tree = getattr(args, "no_tree_archives", False)
            findings = scanner.scan(root)
            if os.path.isdir(root) and not no_tree:
                findings += scan_tree_archives(scanner, root, aopts)
            if disinfect and findings:
                _disinfect_path(scanner, root, findings, aopts)
                # archive-aware residual so in-archive malware can't vanish
                findings = _rescan_full(scanner, root, aopts, no_tree)
        # P9c: external engines (clamscan/yara) when installed — auto, opt-out.
        if not getattr(args, "no_ext_engines", False):
            findings += _engine_findings(root, load_config())
        # operator-accepted findings (interactive [i]gnore / ignores.json)
        findings, n_ignored = filter_ignored(findings)
        findings.sort(key=lambda f: (_SEV_RANK[f.rule.severity], f.path, f.line))
        elapsed = time.time() - t0

        display_target = label if is_remote else root
        scanner.db_health = db_health
        scanner.findings_ignored = n_ignored
        verdict = build_verdict(findings, scanner, display_target, target_kind, policy, elapsed)
        if sign:
            verdict = sign_verdict(verdict)
        if ckey:
            _cache_put(ckey, verdict)

        if getattr(args, "json", None):
            if gate:
                try:
                    with open(args.json, "w", encoding="utf-8") as fh:
                        json.dump(verdict, fh, indent=2)
                except OSError:
                    pass  # side-write is best-effort; stdout JSON is the contract
            else:
                write_json(findings, scanner, root, args.json)

        if gate:
            print(json.dumps(verdict, indent=2))
            return verdict["exit_code"]

        print_report(findings, scanner, root, elapsed)
        if n_ignored:
            print(_c(f"  ({n_ignored} finding(s) suppressed by your ignore list — "
                     f"see: nemesis ignore --list)", _DIM))
        if is_remote:
            print(_c(f"  source: {label}", _DIM))
        ke = getattr(scanner, "last_extract_path", None)
        if ke:
            print(_c(f"  extraction kept at {ke}  (--keep-extract)", _DIM))
        d = scanner.last_archive_disinfection
        if d:
            line = (f"  disinfection: neutralized {d.get('neutralized_lines', 0)} · "
                    f"quarantined {d.get('quarantined_files', 0)} · "
                    f"resolved {d.get('resolved_rules')} · unresolved {d.get('unresolved_rules')}")
            if d.get("output"):
                line += f" · clean copy -> {d['output']}"
            print(_c(line, _DIM))

        # interactive per-threat remediation (scan --interactive / nemesis ui)
        if findings and getattr(args, "interactive", False) and not is_archive:
            if not sys.stdin.isatty():
                print(_c("  --interactive needs a terminal (stdin is not a TTY) — "
                         "report only", _SEV_COLOR["MEDIUM"]), file=sys.stderr)
            elif is_remote and not keep:
                print(_c("  --interactive on a remote target needs --keep-clone "
                         "(the snapshot would vanish) — report only",
                         _SEV_COLOR["MEDIUM"]), file=sys.stderr)
            else:
                qdir = getattr(args, "quarantine_dir", None) or os.path.join(
                    root if os.path.isdir(root) else os.path.dirname(root) or ".",
                    "__nemesis_quarantine__")
                interactive_remediate(scanner, root, findings, qdir)
                # re-render the verdict over what is left on disk
                residual = scanner.scan(root)
                if os.path.isdir(root) and not getattr(args, "no_tree_archives", False):
                    residual += scan_tree_archives(scanner, root, aopts)
                residual, _ = filter_ignored(residual)
                verdict = build_verdict(residual, scanner, display_target,
                                        target_kind, policy, elapsed)
                print_verdict_line(verdict)
                return _SCAN_EXIT.get(verdict["verdict"], 1) if residual else 0

        # legacy in-place remediation for dirs (--fix without --disinfect)
        if findings and getattr(args, "fix", False) and not is_archive and not disinfect:
            qdir = getattr(args, "quarantine_dir", None) or os.path.join(
                root if os.path.isdir(root) else os.path.dirname(root) or ".",
                "__nemesis_quarantine__")
            rem = Remediator(qdir, dry_run=False)
            rem.apply(findings)
            print(_c("\n  remediation: ", _BOLD) + _c("APPLIED", _SEV_COLOR["HIGH"]))
            print(_c(f"    neutralize: {len(rem.neutralized)} line(s)  ·  "
                     f"quarantine: {len(rem.quarantined)} file(s)  ·  "
                     f"report-only: {len(rem.skipped)}", _DIM))

        # findings-but-not-fixing: show what remediation WOULD do (makes the
        # advertised dry-run default real instead of dead code)
        if findings and not disinfect and not getattr(args, "fix", False) \
                and not getattr(args, "interactive", False):
            prev = Remediator("(dry-run)", dry_run=True)
            prev.apply(findings)
            print(_c(f"  dry-run: --fix would neutralize {len(prev.neutralized)} "
                     f"line(s) and quarantine {len(prev.quarantined)} file(s); "
                     f"decide per threat with --interactive", _DIM))

        print_verdict_line(verdict)
        # exit: 0 clean · 1 findings (warn tier) · 3 blocking threats · 2 error
        if not findings:
            return 0
        return _SCAN_EXIT.get(verdict["verdict"], 1)
    finally:
        if is_remote:
            if keep and not gate:
                print(_c(f"  snapshot kept at {root}", _DIM))
            elif not keep:
                cleanup()


def cmd_urlscan(args) -> int:
    """L0 URL extraction as a JSON service. Lists every dereferenceable URL (literal,
    de-obfuscated, base64/hex-decoded) with its syntactic context + an offline L1
    reputation tag. The fetch-proxy (Studio) and prometheus' per-fetch path consume
    this to know what an installed source could make an agent fetch."""
    spec = args.path
    feeds_loaded = False
    if not getattr(args, "no_feeds", False):
        load_db(getattr(args, "db_dir", _DEFAULT_DB_DIR))
        feeds_loaded = bool(URL_BLOCKLIST or DOMAIN_BLOCKLIST)

    def _read(path: str) -> tuple[str, str]:
        try:
            with open(path, "rb") as fh:
                data = fh.read(_TEXT_MAX)
        except OSError:
            return "", ""
        if b"\x00" in data[:4096]:
            return "", ""
        return data.decode("utf-8", "replace"), os.path.splitext(path)[1].lower()

    items: list[tuple[str, str, str]] = []   # (label, text, ext)
    if spec == "-":
        items.append(("<stdin>", sys.stdin.read(), ""))
    elif os.path.isdir(spec):
        sc = Scanner()
        for fp in sc._iter_files(spec):
            txt, ext = _read(fp)
            if txt:
                items.append((fp, txt, ext))
    elif os.path.isfile(spec):
        txt, ext = _read(spec)
        items.append((spec, txt, ext))
    else:
        print(json.dumps(_error_verdict(spec, "path not found"), indent=2))
        return 2

    all_refs: list[dict] = []
    opaque_total = 0
    for label, text, ext in items:
        refs, opaque = _extract_urls(text, ext)
        opaque_total += opaque
        for r in refs:
            d = r.to_dict()
            d["source_file"] = label
            if r.url in URL_BLOCKLIST:
                d["reputation"] = "known_malicious_url"
            elif r.host and r.host in DOMAIN_BLOCKLIST:
                d["reputation"] = "known_malicious_domain"
            else:
                d["reputation"] = "unknown"     # absence of a hit is NOT "safe"
            all_refs.append(d)

    out = {
        "schema": "nemesis.urlscan/1",
        "tool": "nemesis", "tool_version": __version__,
        "target": spec,
        "scanned_at": datetime.now(timezone.utc).isoformat(),
        "urls": all_refs,
        "url_count": len(all_refs),
        "opaque_blobs": opaque_total,
        "exec_context_urls": sum(1 for d in all_refs if d["context_kind"] == "exec"),
        "feeds_loaded": feeds_loaded,
        "feeds_blind": not feeds_loaded,
        "note": ("A 'unknown' reputation is NOT a safety guarantee — only a feed hit "
                 "moves the verdict. URLs may rug-pull or cloak after this scan."),
    }
    print(json.dumps(out, indent=2))
    return 0


def _render_defang_preview(res: dict, spec: str) -> None:
    """CLI-076: render a dry-run PREVIEW — an aligned would-change table (path · URLs · mode ·
    scope · status) with a totals footer, then a per-file unified diff (capped, with a '… N more'
    tail). Symlink-refusal and binary-skip rows appear too, so preview == the real run. Uses only
    the file's _c/_DIM/_SEV_COLOR helpers (no raw escapes)."""
    files = res.get("files", [])
    rows: list[tuple[str, str, str]] = []  # (status, path, url-count)
    for f in files:
        if f.get("binary"):
            rows.append(("SKIP binary", f["path"], str(f.get("count", 0))))
        elif f.get("error"):
            rows.append(("SKIP", f["path"], "-"))
        elif f.get("changed"):
            rows.append(("CHANGE", f["path"], str(f.get("count", 0))))
        elif f.get("kept_count"):
            rows.append(("keep-only", f["path"], "0"))
    print(_c(f"\n  [dry-run] defang preview  ·  {spec}", _BOLD))
    if rows:
        wpath = min(60, max(len(r[1]) for r in rows))
        print(_c(f"    {'STATUS':<12} {'FILE':<{wpath}} {'URLs':>5}  MODE  SCOPE", _DIM))
        for st, p, cnt in rows:
            pp = p if len(p) <= wpath else "…" + p[-(wpath - 1):]
            color = _SEV_COLOR["LOW"] if st == "CHANGE" else _SEV_COLOR["MEDIUM"]
            print(_c(f"    {st:<12} {pp:<{wpath}} {cnt:>5}  {res['mode']:<4}  {res['scope']}", color))
    print(_c(f"  totals: {res['files_changed']} file(s), {res['urls_neutralized']} URL(s) would "
             f"change  ·  {res['binaries_skipped']} binary skipped", _DIM))
    for f in files:
        if not (f.get("changed") and f.get("diff")):
            continue
        print(_c(f"\n  ── {f['path']} ──", _DIM))
        for ln in f["diff"][:_DEFANG_DIFF_RENDER]:
            col = (_SEV_COLOR["LOW"] if ln.startswith("+") else
                   _SEV_COLOR["MEDIUM"] if ln.startswith("-") else _DIM)
            print(_c("    " + ln, col))
        rest = len(f["diff"]) - _DEFANG_DIFF_RENDER
        if rest > 0:
            print(_c(f"    … {rest} more diff line(s)", _DIM))


def cmd_defang(args) -> int:
    """Render an artifact URL-INERT: wipe every dereferenceable URL from every text
    file (independent of the verdict — safe OR dangerous). Originals are preserved in
    <file>.nemesis.bak. With --rescan, gate before+after so the operator sees the
    URL findings disappear ('the repo cannot call out anymore')."""
    spec = args.path
    if not os.path.exists(spec):
        msg = "path not found"
        if getattr(args, "json", False):
            print(json.dumps(_error_verdict(spec, msg), indent=2))
        else:
            print(_c(f"  {msg}: {spec}", _SEV_COLOR["HIGH"]), file=sys.stderr)
        return 2
    scope = getattr(args, "scope", "urls")
    if scope == "all" and not getattr(args, "no_feeds", False):
        load_db(getattr(args, "db_dir", _DEFAULT_DB_DIR))
    extra_keep = list(getattr(args, "keep_domain", []) or [])
    keep_trusted = (getattr(args, "keep", "none") == "trusted") or bool(extra_keep)

    before = None
    if getattr(args, "rescan", False):
        before, _ = _quick_url_finding_count(spec)

    # In-place rewrite is destructive (reversible via .nemesis.bak). On a real TTY run, PREVIEW
    # first (CLI-076): a dry-run pass computes the exact table + per-file diff, we show it, THEN
    # the operator confirms — no longer a blind confirm. --yes/--json/non-TTY keep the old path.
    # Fire the preview+confirm whenever a human is watching (stdout is a TTY) — stdin may be piped
    # (`echo n |` → decline) so the confirm is CI-declinable; a fully non-TTY stdout is automation
    # and keeps today's no-preview write path (use --yes/--json for scripted runs).
    interactive = (not getattr(args, "dry_run", False) and not getattr(args, "yes", False)
                   and not getattr(args, "json", False)
                   and sys.stdout.isatty())
    if interactive:
        preview = defang_tree(spec, mode=args.mode, scope=scope, dry_run=True,
                              keep_trusted=keep_trusted, extra_keep=extra_keep)
        _render_defang_preview(preview, spec)
        print(_c(f"\n  defang will WIPE every URL in {spec} (mode={args.mode}, "
                 f"scope={scope}). Originals kept in *.nemesis.bak.", _SEV_COLOR["MEDIUM"]))
        try:
            answer = input("  type 'defang' to proceed: ").strip().lower()
        except EOFError:
            answer = ""  # empty/closed stdin (CI pipe) → treat as an abort, never a traceback
        if answer != "defang":
            print("  aborted", file=sys.stderr)
            return 2

    res = defang_tree(spec, mode=args.mode, scope=scope,
                      dry_run=getattr(args, "dry_run", False),
                      keep_trusted=keep_trusted, extra_keep=extra_keep)

    after = None
    after_oversized = 0
    if getattr(args, "rescan", False) and not getattr(args, "dry_run", False):
        after, after_oversized = _quick_url_finding_count(spec)
        res["url_findings_before"] = before
        res["url_findings_after"] = after
        # CLI-077: additive honesty flag — an oversized (>8MiB) text file was NOT fully scanned, so
        # `after == 0` alone does NOT mean INERT. prometheus.py reads the existing keys; this is new.
        res["url_findings_oversized"] = after_oversized
        res["inert"] = (after == 0 and after_oversized == 0)

    if getattr(args, "json", False):
        res["schema"] = "nemesis.defang/1"
        res["tool"] = "nemesis"
        res["tool_version"] = __version__
        print(json.dumps(res, indent=2))
        return 0

    # CLI-076: a dry run is a PREVIEW (table + per-file diff), never the terse write-summary.
    if res["dry_run"]:
        _render_defang_preview(res, spec)
        return 0

    head = "[dry-run] " if res["dry_run"] else ""
    print(_c(f"\n  {head}defang  ·  {spec}", _BOLD))
    keep_note = (f"  ·  {res.get('urls_kept_trusted', 0)} trusted URL(s) KEPT"
                 if res.get("keep_trusted") else "")
    print(_c(f"  mode={res['mode']} scope={res['scope']}  ·  "
             f"{res['files_changed']} file(s), {res['urls_neutralized']} URL(s) neutralised"
             f"{keep_note}  ·  {res['binaries_skipped']} binary file(s) skipped", _DIM))
    for f in res["files"][:200]:
        if f.get("binary"):
            print(_c(f"    ! {f['path']}: URL(s) in a BINARY — not rewritten; quarantine it",
                     _SEV_COLOR["MEDIUM"]))
            continue
        if f.get("error"):
            print(_c(f"    ! {f['path']}: {f['error']}", _SEV_COLOR["HIGH"]))
            continue
        if f.get("changed"):
            print(_c(f"    ✓ {f['path']}  ({f['count']} URL(s) → {res['mode']}; "
                     f"original {os.path.basename(f['backup'])})", _SEV_COLOR["LOW"]))
            for n in f.get("neutralized", [])[:6]:
                print(_c(f"        L{n['line']} [{n['kind']}] {n['original'][:70]}", _DIM))
        for k in f.get("kept", [])[:6]:
            print(_c(f"        L{k['line']} KEPT (trusted) {k['url'][:70]}", _SEV_COLOR["LOW"]))
    if before is not None and after is not None:
        # CLI-077: INERT requires BOTH zero URLs left AND zero oversized (un-fully-scanned) files —
        # an artifact with a file past the 8MiB window is never auto-trusted as inert.
        inert = (after == 0 and after_oversized == 0)
        if inert:
            note = "INERT — no URL left to dereference"
        elif after_oversized:
            note = (f"some remain / {after_oversized} oversized file(s) not fully scanned "
                    f"(>{_TEXT_MAX // (1024 * 1024)}MiB — cannot claim INERT)")
        else:
            note = "some remain"
        print(_c(f"\n  URL findings: {before} → {after} ({note})",
                 _SEV_COLOR["LOW"] if inert else _SEV_COLOR["MEDIUM"]))
    if not res["dry_run"] and res["files_changed"]:
        print(_c("  originals preserved in *.nemesis.bak (revert manually: `mv FILE.nemesis.bak FILE`)", _DIM))
    return 0


def _quick_url_finding_count(spec: str) -> tuple[int, int]:
    """Count the literal dereferenceable URLs left across a target + how many text files were TOO
    LARGE to fully scan (on-disk size > _TEXT_MAX). An oversized file can hide a URL PAST the scan
    window, so it can never back an 'INERT' claim (CLI-077 honesty). Returns (urls, oversized)."""
    sc = Scanner()
    files = [spec] if os.path.isfile(spec) else list(sc._iter_files(spec))
    n = 0
    oversized = 0
    for fp in files:
        if fp.endswith(".nemesis.bak"):
            continue
        try:
            size = os.path.getsize(fp)
            with open(fp, "rb") as fh:
                raw = fh.read(_TEXT_MAX)
        except OSError:
            continue
        if b"\x00" in raw[:4096]:
            continue
        # key the truncation off ON-DISK bytes vs the byte window actually read — a multibyte file
        # isn't falsely cleared, and only text (non-binary) files count toward the INERT claim.
        if size > _TEXT_MAX:
            oversized += 1
        n += len(_URL_SCAN_RX.findall(raw.decode("utf-8", "replace")))
    return n, oversized


