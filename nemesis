# --------------------------------------------------------------------------- #
# Terminal styling
# --------------------------------------------------------------------------- #
_USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

SEVERITIES = ("CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO")
_SEV_RANK = {s: i for i, s in enumerate(SEVERITIES)}
_SEV_COLOR = {
    "CRITICAL": "\033[1;97;41m",  # white on red
    "HIGH": "\033[1;31m",         # bright red
    "MEDIUM": "\033[1;33m",       # yellow
    "LOW": "\033[0;36m",          # cyan
    "INFO": "\033[0;90m",         # grey
}
_RESET = "\033[0m"
_BOLD = "\033[1m"
_DIM = "\033[0;90m"


def _c(text: str, code: str) -> str:
    return f"{code}{text}{_RESET}" if _USE_COLOR else text


def _sev(s: str) -> str:
    return _c(f" {s} ", _SEV_COLOR.get(s, "")) if _USE_COLOR else f"[{s}]"


# --------------------------------------------------------------------------- #
# Data model
# --------------------------------------------------------------------------- #
@dataclass(frozen=True)
class Rule:
    rid: str
    name: str
    category: str
    severity: str
    pattern: str
    description: str
    remediation: str
    action: str = "neutralize"          # neutralize | quarantine | report
    klass: str = "malware"              # malware | secret | vuln | sca | container
    flags: int = re.MULTILINE
    globs: tuple[str, ...] = ()          # restrict to filenames (fnmatch); () = any
    _rx: re.Pattern = field(default=None, repr=False, compare=False)  # type: ignore

    def compiled(self) -> re.Pattern:
        return self._rx or re.compile(self.pattern, self.flags)


@dataclass
class Finding:
    path: str
    line: int
    column: int
    rule: Rule
    snippet: str

    def to_dict(self) -> dict:
        return {
            "path": self.path,
            "line": self.line,
            "column": self.column,
            "rule_id": self.rule.rid,
            "rule": self.rule.name,
            "category": self.rule.category,
            "severity": self.rule.severity,
            "class": self.rule.klass,
            "action": self.rule.action,
            "description": self.rule.description,
            "remediation": self.rule.remediation,
            "snippet": self.snippet,
        }


