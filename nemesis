# Verdict / decision engine (final assessment + machine contract)
# --------------------------------------------------------------------------- #
_SEV_WEIGHT = {"CRITICAL": 100, "HIGH": 40, "MEDIUM": 10, "LOW": 2, "INFO": 0}

# Categories where even a single HIGH finding is decisive (block).
# "archive" removed: structural container findings (links/perm/bomb/devnode) warn
# instead of single-handedly blocking; the genuinely dangerous ones are CRITICAL
# rules (ARC-SLIP, ARC-LINK-ESCAPE) and still block via block_on_critical.
_HIGH_BLOCK_CATEGORIES = ["reverse_shell", "exfiltration", "signature", "dropper",
                          "ioc", "git_weaponize", "implant"]

_DEFAULT_POLICY = {
    "block_on_critical": True,
    "high_block_categories": _HIGH_BLOCK_CATEGORIES,
    "high_block_count": 3,
    "block_score": 70,
    "on_error": "block",
    "allow_unscannable": False,
    # Class-aware gating: malware + live secrets can hard-block; vulns warn; CVEs warn
    # unless critical. (Approved policy: warn on vuln/SCA, block only on critical.)
    "block_classes": ["malware", "secret"],
    "sca_block_critical": True,   # block only on CRITICAL (KEV / CVSS≥9) dependency CVEs
    "vuln_block": False,          # SAST vulns never hard-block by default
    # URL-injection L1 "url_blind_ceiling": deliberately ABSENT from the default so
    # run_scan can setdefault() it to True on the `gate` path only (install
    # decisions) while a policy FILE may still set it explicitly either way. When a
    # gated source carries dereferenceable URLs but the URL feed DB is blind, an
    # otherwise-allow verdict drops to warn — absence of a hit is not safety.
}

_VERDICT_EXIT = {"allow": 0, "warn": 10, "block": 20, "error": 2}
# human `scan` exit: clean 0 · findings 1 · blocking threats 3 (error stays 2)
_SCAN_EXIT = {"allow": 0, "warn": 1, "block": 3}


def load_policy(path: Optional[str] = None) -> dict:
    policy = dict(_DEFAULT_POLICY)
    candidate = path or os.path.join(_NEMESIS_HOME, "policy.json")
    if os.path.exists(candidate):
        try:
            with open(candidate, encoding="utf-8") as fh:
                policy.update(json.load(fh))
        except (OSError, json.JSONDecodeError):
            pass
    return policy


def _ruleset_sha() -> str:
    h = hashlib.sha256()
    for r in RULES:
        h.update(f"{r.rid}|{r.pattern}|{r.severity}|{r.action}|{r.klass}|"
                 f"{r.flags}|{','.join(r.globs)};".encode())
    return h.hexdigest()[:12]


# --------------------------------------------------------------------------- #
# Non-executable DOC suppression (verdict only — findings are still SHOWN).
# A shell-exec HEURISTIC (curl|bash dropper, an exfil command shape, a reverse-shell
# string) that lives in a NON-EXECUTABLE DOC — README / CHANGELOG / LICENSE / *.md /
# *.rst / *.txt — is documentation (install instructions or an example), NOT an
# executed action, so it must not BLOCK an install. It stays in the report as a LOW/
# advisory note. Agent-targeting classes (ioc / indirect prompt-injection) and
# high-confidence signature (known-malware hash) are DELIBERATELY excluded from this
# suppression: those are dangerous — or authoritative — even inside a doc.
_DOC_SUPPRESS_CATEGORIES = frozenset({"dropper", "exfiltration", "reverse_shell"})
_DOC_EXTS = frozenset({".md", ".markdown", ".mdx", ".rst", ".txt", ".adoc", ".rdoc"})
# EXTENSIONLESS canonical doc filenames only (README, LICENSE, CHANGELOG…). ANCHORED with NO
# optional suffix on purpose: an earlier version allowed `<name>[.-_]<anything>`, which matched
# `security.py` / `readme.sh` / `license.py` — an allowlist BYPASS that let a dropper named
# `readme.sh` masquerade as a doc and skip the block. A file with ANY extension must go through
# the _DOC_EXTS check below; the regex now only whitelists truly extensionless doc files.
_DOC_NAME_RX = re.compile(
    r"^(readme|changelog|changes|history|news|license|licence|copying|notice|"
    r"contributing|code_of_conduct|authors|maintainers)$", re.I)


def _is_nonexec_doc(path: str) -> bool:
    """True ONLY for real documentation files that are never executed on install:
    a recognised doc EXTENSION (.md/.rst/.txt/…), or an EXTENSIONLESS canonical doc name
    (README/LICENSE/CHANGELOG). Anything carrying a code/script extension (.py/.sh/.js/…) —
    including `security.py`, `readme.sh` — is NOT a doc and its findings still block."""
    base = (path or "").replace("\\", "/").lower().rsplit("/", 1)[-1]
    ext = os.path.splitext(base)[1]
    if ext in _DOC_EXTS:
        return True
    return ext == "" and bool(_DOC_NAME_RX.search(base))


def _doc_suppressed(f: Finding) -> bool:
    """A shell-exec heuristic sitting in a non-executable doc → advisory, not blocking."""
    return f.rule.category in _DOC_SUPPRESS_CATEGORIES and _is_nonexec_doc(f.path)


def build_verdict(findings: list[Finding], scanner: Scanner, target: str,
                  target_kind: str, policy: dict, elapsed: float) -> dict:
    counts = {s: sum(1 for f in findings if f.rule.severity == s) for s in SEVERITIES}
    class_counts: dict = {}
    for f in findings:
        class_counts[f.rule.klass] = class_counts.get(f.rule.klass, 0) + 1
    score = min(100, sum(_SEV_WEIGHT[f.rule.severity] for f in findings))
    # hard blind spot (whole archive unreadable) blocks; a member-level encrypted
    # blind spot warns — the rest of the archive WAS scanned (plan §8).
    unscannable_hard = any(f.rule.rid == "ARC-UNSCANNABLE" for f in findings)
    unscannable_soft = any(f.rule.rid == "ARC-ENCRYPTED" for f in findings)
    unscannable = unscannable_hard or unscannable_soft
    hb = set(policy.get("high_block_categories", []))
    block_classes = set(policy.get("block_classes", ["malware", "secret"]))

    def _blocks(f: Finding) -> bool:
        # a shell-exec heuristic in a non-executable doc (README/CHANGELOG/*.md) is prose,
        # not an executed action — advisory only, never a block (ioc/signature still block).
        if _doc_suppressed(f):
            return False
        k = f.rule.klass
        if k == "vuln":
            return bool(policy.get("vuln_block", False)) and f.rule.severity in ("CRITICAL", "HIGH")
        if k == "sca":
            return f.rule.severity == "CRITICAL" and policy.get("sca_block_critical", True)
        if k == "secret":
            # live keys block — but only while 'secret' stays a block class
            return "secret" in block_classes and f.rule.severity in ("CRITICAL", "HIGH")
        if k not in block_classes:
            return False
        if f.rule.severity == "CRITICAL" and policy.get("block_on_critical", True):
            return True
        return f.rule.severity == "HIGH" and f.rule.category in hb

    blocking = [f for f in findings if _blocks(f)]
    reasons: list[str] = [f"{f.rule.rid} @ {f.path}" for f in blocking]
    # accumulation rule: MANY high-severity findings in block classes block even
    # when no single one does (previously counted only already-blocking finds).
    # Doc-suppressed heuristics (curl|bash in a README) do NOT accumulate.
    high_n = sum(1 for f in findings
                 if f.rule.severity == "HIGH" and f.rule.klass in block_classes
                 and not _doc_suppressed(f))
    if high_n >= policy.get("high_block_count", 3):
        reasons.append(f"{high_n} HIGH findings in blockable classes")
    # risk-score accumulation: only CRITICAL/HIGH findings in block classes feed
    # it — MEDIUM/LOW (e.g. an example JWT, a generic-credential hit) belong to
    # the warn tier and must not single-handedly force a block. Doc-suppressed
    # shell-exec heuristics are excluded (documentation is not executed).
    block_score_sum = min(100, sum(_SEV_WEIGHT[f.rule.severity] for f in findings
                                   if f.rule.klass in block_classes
                                   and f.rule.severity in ("CRITICAL", "HIGH")
                                   and not _doc_suppressed(f)))
    if block_score_sum >= policy.get("block_score", 70):
        reasons.append(f"risk score {block_score_sum} ≥ {policy.get('block_score', 70)}")
    if unscannable_hard and not policy.get("allow_unscannable", False):
        reasons.append("unscannable blind spot")
    seen: set = set()
    reasons = [r for r in reasons if not (r in seen or seen.add(r))][:12]

    # warn iff there is any non-INFO finding (an INFO-only result — e.g. just
    # ARC-ENCRYPTED-OK after a successful decrypt — is clean) or a blind spot.
    non_info = any(counts[s] for s in SEVERITIES if s != "INFO")
    verdict = "block" if reasons else ("warn" if (non_info or unscannable) else "allow")
    disinf = scanner.last_archive_disinfection
    _HARD_MALWARE_RIDS = {"HASH-HIT", "CLAMAV-NDB", "EXT-CLAMAV", "EXT-YARA", "HEUR-EXE"}
    # a quarantined hard-malware artifact never makes the source trustworthy:
    # floor at warn regardless of what the de-escalation below would do.
    if (disinf and disinf.get("applied")
            and set(disinf.get("resolved_rules") or []) & _HARD_MALWARE_RIDS
            and verdict == "allow"):
        verdict = "warn"
        reasons = ["hard malware was quarantined — source still hostile"]
    if disinf and disinf.get("applied") and not disinf.get("unresolved_rules") and verdict != "allow":
        # everything solvable was solved → de-escalate. But quarantining a known
        # hard-malware artifact does not make the SOURCE trustworthy: cap at warn.
        hard_resolved = set(disinf.get("resolved_rules") or []) & _HARD_MALWARE_RIDS
        if hard_resolved:
            verdict = "warn"
            reasons = [r + " (quarantined by disinfection — source still hostile)"
                       for r in reasons]
        elif non_info:
            # findings still present on disk after disinfection — cannot claim allow
            verdict = "warn"
            reasons = [r + " (partially resolved — findings remain)" for r in reasons]
        else:
            verdict = "warn" if unscannable else "allow"
            reasons = [r + " (resolved by disinfection)" for r in reasons]

    # URL-injection L1 blind-ceiling: a clean gate verdict over a source that
    # carries URLs we could not vet (URL feed not loaded) is downgraded to warn —
    # absence of a feed hit is not evidence the URL is safe (fail-closed).
    url_seen = getattr(scanner, "url_seen", 0)
    feeds_blind = not URL_BLOCKLIST
    if policy.get("url_blind_ceiling") and url_seen and feeds_blind and verdict == "allow":
        verdict = "warn"
        reasons = ["URLs present but the threat-feed URL DB is blind — could not vet "
                   "what the agent may fetch (fail-closed; run `nemesis update`)"]

    safe = verdict == "allow"
    cautious = verdict == "warn"
    safe_to = {
        "install": safe,
        "run_plug_and_play": safe,
        "use_as_ai_cli_agent": safe,
    }
    rec = {
        "allow": "SAFE to install / run / use as an AI CLI agent. No known threats.",
        "warn": "CAUTION — review findings before installing; proceed only if you trust the source.",
        "block": "DO NOT install or run. Blocking threats present.",
    }[verdict]
    if disinf and disinf.get("applied"):
        rec += (f"  Disinfected: resolved {disinf.get('resolved_rules')}, "
                f"unresolved {disinf.get('unresolved_rules')}.")

    return {
        "schema": "nemesis.verdict/1",
        "tool": "nemesis", "tool_version": __version__,
        "target": target, "target_kind": target_kind,
        "target_sha256": _sha256_file(target) if os.path.isfile(target) else None,
        "scanned_at": datetime.now(timezone.utc).isoformat(),
        "duration_s": round(elapsed, 3),
        "verdict": verdict, "risk_score": score, "exit_code": _VERDICT_EXIT[verdict],
        "severity_counts": counts, "class_counts": class_counts,
        # full per-class finding lists (capped) — consumers see every SCA CVE and
        # secret even when malware findings crowd out top_findings[:15]
        "findings_by_class": {
            k: [f.to_dict() for f in findings if f.rule.klass == k][:25]
            for k in sorted(class_counts)
        },
        "safe_to": safe_to, "recommendation": rec,
        "blocking_reasons": reasons,
        "top_findings": [f.to_dict() for f in findings[:15]],
        "unscannable": unscannable,
        "disinfection": disinf,
        "provenance": {
            "ruleset_sha": _ruleset_sha(),
            "indicators_loaded": {
                "sha256": len(HASH_BLOCKLIST), "sha1": len(HASH_BLOCKLIST_SHA1),
                "md5": len(HASH_BLOCKLIST_MD5), "domains": len(DOMAIN_BLOCKLIST),
                "urls": len(URL_BLOCKLIST), "ips": len(IP_BLOCKLIST),
                "ip_cidrs": len(IP_CIDR_BLOCKLIST),
                "clamav_ndb": len(_NDB_SIGS), "kev_cves": len(KEV_SET),
            },
            "url_layer": {
                "urls_seen": url_seen,
                "feeds_blind": feeds_blind,
                "blind_ceiling_applied": bool(
                    policy.get("url_blind_ceiling") and url_seen and feeds_blind),
            },
            "db": getattr(scanner, "db_health", None),
            "findings_ignored": getattr(scanner, "findings_ignored", 0),
            "files_scanned": scanner.files_scanned,
            "sca_unscanned_ecosystems": sorted(getattr(scanner, "sca_unscanned", set())),
            "extract_tier": _LAST_EXTRACT_TIER,
        },
        "policy": "default" if policy == _DEFAULT_POLICY else "custom",
        "host": sys.platform,
    }


def print_verdict_line(v: dict) -> None:
    color = {"allow": _SEV_COLOR["LOW"], "warn": _SEV_COLOR["MEDIUM"],
             "block": _SEV_COLOR["CRITICAL"], "error": _SEV_COLOR["HIGH"]}[v["verdict"]]
    c = v["severity_counts"]
    sev = "  ".join(f"{c[s]} {s.lower()}" for s in SEVERITIES if c[s]) or "clean"
    print(_c(f"\n  VERDICT: {v['verdict'].upper()}", color)
          + _c(f"   risk {v['risk_score']}/100   {v['target']}", _BOLD))
    print(_c(f"    {sev}", _DIM))
    if v["blocking_reasons"]:
        print(_c("    reasons: " + "; ".join(v["blocking_reasons"][:5]), _DIM))
    print(_c("    " + v["recommendation"], _DIM))


# --------------------------------------------------------------------------- #
# Verdict cache (skip re-scanning an unchanged file) + signed verdicts
# --------------------------------------------------------------------------- #
# A gate is often re-run on the same artifact (e.g. prometheus calling nemesis as
# a subprocess repeatedly). We memoize the verdict keyed by the target's sha256
# *and* a fingerprint of the loaded detection state, so a DB/ruleset/policy/flag
# change invalidates it. Only single-file/archive targets are cached (dirs and
# remote repos have no stable content hash here).
def _cache_dir() -> str:
    return os.path.join(_NEMESIS_HOME, "cache")


def _db_fingerprint() -> str:
    h = hashlib.sha256()
    h.update(_ruleset_sha().encode())
    # stat-fingerprint of the DB files actually loaded (set by load_db; "none" when
    # --no-feeds skipped it) — content changes flip it even at equal set sizes
    h.update(b"|dbsig:")
    h.update((_LOADED_DB_SIG or "none").encode())
    # set lengths still included: they catch --hashes extra loads
    for s in (HASH_BLOCKLIST, HASH_BLOCKLIST_SHA1, HASH_BLOCKLIST_MD5,
              URL_BLOCKLIST, DOMAIN_BLOCKLIST, IP_BLOCKLIST, ALLOWLIST):
        h.update(b"|")
        h.update(str(len(s)).encode())
    # per-finding ignore store: an edit must invalidate cached verdicts
    try:
        st = os.stat(_ignores_path())
        h.update(f"|ign:{st.st_size}|{int(st.st_mtime)}".encode())
    except OSError:
        h.update(b"|ign:absent")
    return h.hexdigest()[:16]


def _cache_key(target: str, policy: dict, opts_sig: str) -> Optional[str]:
    if not os.path.isfile(target):
        return None
    try:
        tsha = _sha256_file(target)
    except OSError:
        return None
    h = hashlib.sha256()
    for part in (tsha, _db_fingerprint(), json.dumps(policy, sort_keys=True),
                 opts_sig, __version__):
        h.update(part.encode())
        h.update(b"\x00")
    return h.hexdigest()


def _cache_get(key: Optional[str]) -> Optional[dict]:
    if not key:
        return None
    try:
        with open(os.path.join(_cache_dir(), key + ".json"), encoding="utf-8") as fh:
            v = json.load(fh)
        v["cached"] = True
        return v
    except (OSError, json.JSONDecodeError):
        return None


def _cache_put(key: Optional[str], verdict: dict) -> None:
    if not key:
        return
    try:
        os.makedirs(_cache_dir(), exist_ok=True)
        p = os.path.join(_cache_dir(), key + ".json")
        tmp = p + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(verdict, fh)
        os.replace(tmp, p)
        try:
            os.chmod(p, 0o600)
        except OSError:
            pass
    except OSError:
        pass


def _cache_clear() -> int:
    d = _cache_dir()
    n = 0
    if os.path.isdir(d):
        for fn in os.listdir(d):
            if fn.endswith(".json"):
                try:
                    os.remove(os.path.join(d, fn))
                    n += 1
                except OSError:
                    pass
    return n


# -- signed verdicts -------------------------------------------------------- #
# HMAC-SHA256 over the canonical verdict. This gives integrity for a verdict that
# travels through an untrusted channel (a cache file, a pipe, another host). It is
# NOT protection against a same-uid attacker, who can read the key — documented.
def _gate_key_path() -> str:
    return os.path.join(_NEMESIS_HOME, "gate.key")


def _gate_key(create: bool = False) -> Optional[bytes]:
    try:
        with open(_gate_key_path(), "rb") as fh:
            k = fh.read().strip()
        if k:
            return k
    except OSError:
        pass
    if not create:
        return None
    k = secrets.token_hex(32).encode()
    try:
        os.makedirs(_NEMESIS_HOME, exist_ok=True)
        with open(_gate_key_path(), "wb") as fh:
            fh.write(k)
        os.chmod(_gate_key_path(), 0o600)
    except OSError:
        return None
    return k


def _verdict_canonical(v: dict) -> bytes:
    d = {k: v[k] for k in v if k not in ("signature", "cached")}
    return json.dumps(d, sort_keys=True, separators=(",", ":")).encode()


def sign_verdict(v: dict) -> dict:
    key = _gate_key(create=True)
    if not key:
        return v
    sig = hmac.new(key, _verdict_canonical(v), hashlib.sha256).hexdigest()
    v["signature"] = {"alg": "HMAC-SHA256", "value": sig,
                      "key_id": hashlib.sha256(key).hexdigest()[:12]}
    return v


def verify_verdict(v: dict) -> bool:
    sig = v.get("signature")
    key = _gate_key(create=False)
    if not sig or not key:
        return False
    expect = hmac.new(key, _verdict_canonical(v), hashlib.sha256).hexdigest()
    return hmac.compare_digest(expect, str(sig.get("value", "")))


