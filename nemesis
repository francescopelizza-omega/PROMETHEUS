_OSV_ONLINE = False                  # set by run_scan when --osv-online is passed
_OSV_ONLINE_CACHE: dict = {}
_LOADED_DB_SIG: Optional[str] = None  # stat-fingerprint of the DB files load_db read

_LOCKFILE_ECO = {
    "requirements.txt": "PyPI", "pipfile.lock": "PyPI", "poetry.lock": "PyPI",
    "package-lock.json": "npm", "npm-shrinkwrap.json": "npm", "yarn.lock": "npm",
    "pnpm-lock.yaml": "npm",
    "cargo.lock": "crates.io", "gemfile.lock": "RubyGems", "composer.lock": "Packagist",
    "go.sum": "Go", "go.mod": "Go",
    "pom.xml": "Maven", "build.gradle": "Maven", "build.gradle.kts": "Maven",
}


def _lockfile_eco(fname: str) -> Optional[str]:
    base = os.path.basename(fname).lower()
    eco = _LOCKFILE_ECO.get(base)
    if not eco and base.startswith("requirements") and base.endswith(".txt"):
        eco = "PyPI"                      # requirements-dev.txt / requirements_test.txt …
    return eco

_SCA_RULES = {
    sev: Rule(f"SCA-OSV-{sev}", "Vulnerable dependency (OSV)", "dependency", sev, "",
              "A pinned dependency version matches a known vulnerability advisory (OSV).",
              "Upgrade to the fixed version; review the advisory.",
              action="report", klass="sca", flags=0)
    for sev in ("CRITICAL", "HIGH", "MEDIUM", "LOW")
}


# Pre-release tag ordering (PEP440 + semver). dev < alpha < beta < rc < final < post.
_PRE_ORDER = {"dev": 0, "alpha": 1, "a": 1, "beta": 2, "b": 2,
              "rc": 3, "c": 3, "pre": 3, "preview": 3}


def _prerelease_key(suffix: str) -> tuple:
    """Order key for a version's trailing suffix. A plain release (no suffix) ranks
    above any pre-release; a `.postN` ranks above the plain release."""
    s = suffix.strip(".-_+")
    if not s:
        return (1,)                                  # final release
    mp = re.search(r"(?:^|[.\-_])post\.?(\d+)", s)   # PEP440 post-release
    if mp:
        return (2, int(mp.group(1)))
    mt = re.match(r"[.\-_]?([a-z]+)\.?(\d*)", s)      # named pre-release
    if mt and mt.group(1) in _PRE_ORDER:
        return (0, _PRE_ORDER[mt.group(1)], int(mt.group(2) or 0))
    return (0, 9, 0)                                  # unknown suffix → treat as pre


def _parse_version(v: str) -> tuple:
    """Best-effort PEP440/semver parse → (epoch, release_tuple, prerelease_key).
    Build metadata (`+…`) is ignored; epochs (`N!…`) and pre/post tags are honored."""
    s = str(v).strip().lower().lstrip("v").split("+", 1)[0]
    epoch = 0
    if "!" in s:
        e, _, s = s.partition("!")
        try:
            epoch = int(e)
        except ValueError:
            epoch = 0
    m = re.match(r"(\d+(?:[._]\d+)*)(.*)", s)
    if not m:
        return (epoch, (0,), (1,))
    rel = tuple(int(x) for x in re.split(r"[._]", m.group(1)))
    return (epoch, rel, _prerelease_key(m.group(2)))


def _vercmp(a: str, b: str) -> int:
    ea, ra, pa = _parse_version(a)
    eb, rb, pb = _parse_version(b)
    if ea != eb:
        return -1 if ea < eb else 1
    n = max(len(ra), len(rb))
    ra = ra + (0,) * (n - len(ra))
    rb = rb + (0,) * (n - len(rb))
    if ra != rb:
        return -1 if ra < rb else 1
    if pa != pb:
        return -1 if pa < pb else 1
    return 0


_GIT_SHA_RX = re.compile(r"^[0-9a-f]{12,40}$", re.IGNORECASE)
_HEX_LETTER_RX = re.compile(r"[a-f]", re.IGNORECASE)


def _sha_like(v) -> bool:
    """True for values that look like git commit SHAs, not versions. Requires at
    least one hex letter so an all-digit version (e.g. a 14-digit timestamp like
    '20240101120000') is NOT misread as a commit and dropped."""
    s = str(v)
    return (bool(v) and _GIT_SHA_RX.match(s) is not None
            and _HEX_LETTER_RX.search(s) is not None)


def _version_affected(ver: str, adv: dict, eco: str) -> bool:
    if ver in adv.get("versions", []):
        return True
    for r in adv.get("ranges", []):
        intro = r.get("introduced", "0")
        fixed = r.get("fixed")
        last = r.get("last_affected")
        # GIT-type ranges carry commit SHAs, not versions — comparing them as
        # versions yields garbage matches. Index building filters them, but be
        # defensive against old/foreign indexes too.
        if _sha_like(fixed) or _sha_like(last) or (intro != "0" and _sha_like(intro)):
            continue
        if _vercmp(ver, intro) >= 0:
            if fixed:
                if _vercmp(ver, fixed) < 0:
                    return True
            elif last:
                if _vercmp(ver, last) <= 0:
                    return True
            else:
                return True
    return False


def _osv_index_for(eco: str) -> dict:
    if OSV_DIR is None:
        return {}
    if eco in _OSV_CACHE:
        return _OSV_CACHE[eco]
    idx: dict = {}
    p = os.path.join(OSV_DIR, eco.replace("/", "_") + ".json")
    if os.path.exists(p):
        try:
            with open(p, encoding="utf-8") as fh:
                idx = json.load(fh)
        except (OSError, json.JSONDecodeError):
            idx = {}
    _OSV_CACHE[eco] = idx
    return idx


def _parse_deps(fname: str, text: str) -> list:
    f = os.path.basename(fname).lower()
    try:
        if f.startswith("requirements") and f.endswith(".txt"):
            # tolerate extras (`pkg[security]==1.0`) and trailing env markers (`; ...`)
            return re.findall(
                r"(?m)^\s*([A-Za-z0-9][A-Za-z0-9._-]*)(?:\[[^\]]*\])?\s*==\s*([0-9][^\s;#]*)",
                text)
        if f == "pnpm-lock.yaml":
            # v6: "  /name@1.2.3:" or "  /@scope/name@1.2.3(peer):"
            # v9: "  'name@1.2.3':" / "  name@1.2.3:" under packages:/snapshots:
            out = set()
            for m in re.finditer(
                    r"(?m)^\s+/?'?(@?[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)?)@"
                    r"([0-9][A-Za-z0-9.+-]*)['(:]", text):
                out.add((m.group(1), m.group(2)))
            return sorted(out)
        if f == "go.mod":
            # line-based: avoids the quadratic backtracking of overlapping greedy
            # path classes. Each require line is "module/path vX.Y.Z [// indirect]".
            out = set()
            for line in text.splitlines():
                s = line.strip()
                if s.startswith("require "):
                    s = s[len("require "):].strip()
                m = re.match(r"(\S+)\s+v([0-9][\w.+-]*)", s)
                if m and "." in m.group(1):
                    out.add((m.group(1), m.group(2)))
            return sorted(out)
        if f == "pom.xml":
            out = []
            for m in re.finditer(r"(?s)<dependency>(.*?)</dependency>", text):
                blk = m.group(1)
                g = re.search(r"<groupId>\s*([^<\s]+)\s*</groupId>", blk)
                a = re.search(r"<artifactId>\s*([^<\s]+)\s*</artifactId>", blk)
                v = re.search(r"<version>\s*([0-9][^<\s]*)\s*</version>", blk)
                if g and a and v and "${" not in v.group(1):
                    out.append((f"{g.group(1)}:{a.group(1)}", v.group(1)))
            return out
        if f in ("build.gradle", "build.gradle.kts"):
            return [(f"{m.group(1)}:{m.group(2)}", m.group(3)) for m in re.finditer(
                r"(?m)(?:implementation|api|compile(?:Only)?|runtimeOnly|testImplementation)"
                r"\s*[\( ]\s*['\"]([A-Za-z0-9._-]+):([A-Za-z0-9._-]+):([0-9][^'\"]*)['\"]",
                text)]
        if f == "pipfile.lock":
            d = json.loads(text)
            out = []
            for sec in ("default", "develop"):
                for nm, info in (d.get(sec) or {}).items():
                    v = str(info.get("version", "")).lstrip("=")
                    if v:
                        out.append((nm, v))
            return out
        if f == "poetry.lock":
            return [(m.group(1), m.group(2)) for m in re.finditer(
                r'(?s)\[\[package\]\].*?name\s*=\s*"([^"]+)".*?version\s*=\s*"([^"]+)"', text)]
        if f in ("package-lock.json", "npm-shrinkwrap.json"):
            d = json.loads(text)
            out = []
            for k, v in (d.get("packages") or {}).items():
                if k and isinstance(v, dict) and v.get("version"):
                    out.append((k.split("node_modules/")[-1], v["version"]))

            def _walk_v1(deps: dict) -> None:   # lockfile v1 nests transitive deps
                for k, v in (deps or {}).items():
                    if isinstance(v, dict):
                        if v.get("version"):
                            out.append((k, v["version"]))
                        _walk_v1(v.get("dependencies") or {})
            _walk_v1(d.get("dependencies") or {})
            return out
        if f == "yarn.lock":
            # line-based block parse — the previous single mega-regex
            # (`(?:\s+[^\n]*\n)*?`) was catastrophically backtracking on a crafted
            # lockfile. Each top-level "name@range...:" header opens a block; the
            # first indented `version "x"` in it is the resolved version.
            out = []
            cur_name = None
            for line in text.splitlines():
                if line and not line[0].isspace():
                    head = line.strip().strip('"').split(",")[0]
                    # "@scope/pkg@^1.0" / "pkg@^1.0" → strip the LAST @range
                    at = head.rfind("@")
                    cur_name = head[:at] if at > 0 else None
                elif cur_name:
                    vm = re.match(r'\s+version:?\s+"?([0-9][^"\s]*)', line)
                    if vm:
                        out.append((cur_name, vm.group(1)))
                        cur_name = None
            return out
        if f == "cargo.lock":
            return [(m.group(1), m.group(2)) for m in re.finditer(
                r'(?s)\[\[package\]\].*?name\s*=\s*"([^"]+)".*?version\s*=\s*"([^"]+)"', text)]
        if f == "gemfile.lock":
            return re.findall(r"(?m)^\s{4}([A-Za-z0-9._-]+) \(([0-9][^)]*)\)", text)
        if f == "composer.lock":
            d = json.loads(text)
            out = []
            for p in (d.get("packages") or []) + (d.get("packages-dev") or []):
                if p.get("name") and p.get("version"):
                    out.append((p["name"], str(p["version"]).lstrip("v")))
            return out
        if f == "go.sum":
            return list({(m.group(1), m.group(2)) for m in re.finditer(
                r"(?m)^(\S+)\s+v([^\s/]+)", text)})
    except (ValueError, KeyError, json.JSONDecodeError, re.error):
        return []
    return []


_OSV_VULN_CACHE: dict = {}     # vuln id -> {"id": CVE, "sev": ..., "fixed": ...}
_OSV_DETAIL_CAP = 60           # max per-run detail GETs; beyond it: MEDIUM placeholder


def _osv_query_online_batch(eco: str, deps: list) -> dict:
    """Resolve advisories for many (name, ver) pairs via osv.dev querybatch — one
    POST per 500 deps instead of one per dep — then fetch details only for the
    (rare) hits. Server-side version matching, so no local range check needed.
    Fail-open: any network error degrades to no online findings."""
    # dedup (a dep can appear twice in a lockfile) — query each (name,version)
    # once and key results by the pair, not by a positional slot, so duplicates
    # cannot overwrite or drop each other.
    todo = sorted({(n, v) for n, v in deps if (eco, n.lower(), v) not in _OSV_ONLINE_CACHE})
    for i in range(0, len(todo), 500):
        chunk = todo[i:i + 500]
        # query carries its (name,version) so results map back unambiguously
        queries = [{"_key": (n, v), "version": v,
                    "package": {"name": n, "ecosystem": eco}} for n, v in chunk]
        ids_by_key: dict = {(n, v): [] for n, v in chunk}
        # follow per-query next_page_token (capped) — a package with >1 page of
        # advisories would otherwise silently lose the tail
        for _page in range(5):
            payload = json.dumps({"queries": [
                {k: v for k, v in q.items() if k != "_key"} for q in queries]}).encode()
            try:
                raw = _http_fetch("https://api.osv.dev/v1/querybatch",
                                  {"Content-Type": "application/json"},
                                  32 * 1024 * 1024, data=payload, timeout=30)
                results = json.loads(raw).get("results", []) or []
            except (urllib.error.URLError, urllib.error.HTTPError, OSError,
                    ValueError, RuntimeError):
                results = []
            results += [{}] * (len(queries) - len(results))
            again = []
            for q, res in zip(queries, results):
                ids_by_key[q["_key"]] += [x.get("id") for x in ((res or {}).get("vulns") or [])
                                          if x.get("id")]
                tok = (res or {}).get("next_page_token")
                if tok:
                    q2 = dict(q)
                    q2["page_token"] = tok
                    again.append(q2)
            if not again:
                break
            queries = again
        for (n, v), ids in ids_by_key.items():
            _OSV_ONLINE_CACHE[(eco, n.lower(), v)] = ids
    out: dict = {}
    fetched = 0
    for n, v in deps:
        advs = []
        for vid in _OSV_ONLINE_CACHE.get((eco, n.lower(), v), []):
            det = _OSV_VULN_CACHE.get(vid)
            if det is None and fetched < _OSV_DETAIL_CAP:
                fetched += 1
                try:
                    raw = _http_fetch(
                        "https://api.osv.dev/v1/vulns/" + urllib.parse.quote(vid),
                        {}, 16 * 1024 * 1024, timeout=20)
                    adv = json.loads(raw)
                    aliases = adv.get("aliases", [])
                    ident = next((a for a in aliases if a.startswith("CVE-")), vid)
                    fixed = None
                    for aff in adv.get("affected", []):
                        for rg in aff.get("ranges", []):
                            for e in rg.get("events", []):
                                if "fixed" in e:
                                    fixed = fixed or e["fixed"]
                    det = {"id": ident, "sev": _osv_severity(adv), "fixed": fixed,
                           "online": True}
                except (urllib.error.URLError, urllib.error.HTTPError, OSError,
                        ValueError, RuntimeError):
                    det = {"id": vid, "sev": "MEDIUM", "fixed": None, "online": True}
                _OSV_VULN_CACHE[vid] = det
            if det is None:   # detail cap hit — keep the hit, default severity
                det = {"id": vid, "sev": "MEDIUM", "fixed": None, "online": True}
            advs.append(det)
        if advs:
            out[(n.lower(), v)] = advs
    return out


def _sca_scan(name: str, text: str, max_findings: int = 100) -> list[Finding]:
    eco = _lockfile_eco(name)
    if not eco:
        return []
    idx = _osv_index_for(eco)
    if not idx and not _OSV_ONLINE:
        return []
    out: list[Finding] = []
    seen: set = set()
    deps = _parse_deps(name, text)
    online = _osv_query_online_batch(eco, deps) if _OSV_ONLINE else {}
    for pname, pver in deps:
        matched = [adv for adv in idx.get(pname.lower(), [])
                   if _version_affected(pver, adv, eco)]
        matched += online.get((pname.lower(), pver), [])
        for adv in matched:
            key = (pname.lower(), pver, adv.get("id"))
            if key in seen:
                continue
            seen.add(key)
            sev = adv.get("sev", "MEDIUM")
            kev = str(adv.get("id", "")) in KEV_SET
            if kev:
                sev = "CRITICAL"      # actively exploited in the wild → always blockable
            rule = _SCA_RULES.get(sev, _SCA_RULES["MEDIUM"])
            pos = text.find(pname)
            ln = text.count("\n", 0, pos) + 1 if pos >= 0 else 1
            src = " online" if adv.get("online") else ""
            out.append(Finding(name, ln, 1, rule,
                               f"{pname}@{pver} {adv.get('id')} ({sev})"
                               f"{' KEV-listed' if kev else ''}{src} "
                               f"fixed:{adv.get('fixed') or '—'}"))
            if len(out) >= max_findings:
                return out
    return out


def _roundup31(x: float) -> float:
    """CVSS v3.1 spec Roundup: one decimal, with the 1e5 integer-epsilon dance."""
    i = int(round(x * 100000))
    if i % 10000 == 0:
        return i / 100000.0
    return (i // 10000 + 1) / 10.0


def _cvss_from_vector(vec: str) -> Optional[float]:
    """Compute a CVSS v3.x base score from its vector string. None if not v3/parsable."""
    if "CVSS:3" not in vec:
        return None
    m = dict(p.split(":", 1) for p in vec.split("/") if ":" in p)
    scope_c = m.get("S") == "C"
    AV = {"N": 0.85, "A": 0.62, "L": 0.55, "P": 0.2}.get(m.get("AV"))
    AC = {"L": 0.77, "H": 0.44}.get(m.get("AC"))
    PR = ({"N": 0.85, "L": 0.68, "H": 0.5} if scope_c
          else {"N": 0.85, "L": 0.62, "H": 0.27}).get(m.get("PR"))
    UI = {"N": 0.85, "R": 0.62}.get(m.get("UI"))
    imp = {"H": 0.56, "L": 0.22, "N": 0.0}
    Cv, Iv, Av = imp.get(m.get("C")), imp.get(m.get("I")), imp.get(m.get("A"))
    if None in (AV, AC, PR, UI, Cv, Iv, Av):
        return None
    iss = 1 - (1 - Cv) * (1 - Iv) * (1 - Av)
    impact = (7.52 * (iss - 0.029) - 3.25 * (iss - 0.02) ** 15 if scope_c
              else 6.42 * iss)
    if impact <= 0:
        return 0.0
    expl = 8.22 * AV * AC * PR * UI
    raw = min(1.08 * (impact + expl) if scope_c else impact + expl, 10.0)
    return _roundup31(raw)


def _cvss2_score(vec: str) -> Optional[float]:
    """CVSS v2 base score from a vector like AV:N/AC:L/Au:N/C:P/I:P/A:P."""
    m = dict(p.split(":", 1) for p in vec.strip("()").split("/") if ":" in p)
    AV = {"L": 0.395, "A": 0.646, "N": 1.0}.get(m.get("AV"))
    AC = {"H": 0.35, "M": 0.61, "L": 0.71}.get(m.get("AC"))
    Au = {"M": 0.45, "S": 0.56, "N": 0.704}.get(m.get("Au"))
    cia = {"N": 0.0, "P": 0.275, "C": 0.660}
    Cv, Iv, Av = cia.get(m.get("C")), cia.get(m.get("I")), cia.get(m.get("A"))
    if None in (AV, AC, Au, Cv, Iv, Av):
        return None
    impact = 10.41 * (1 - (1 - Cv) * (1 - Iv) * (1 - Av))
    expl = 20 * AV * AC * Au
    f = 0.0 if impact == 0 else 1.176
    return round(((0.6 * impact) + (0.4 * expl) - 1.5) * f, 1)


def _cvss4_score(vec: str) -> Optional[float]:
    """Approximate CVSS v4.0 base score. The official scoring uses a 270-entry
    MacroVector lookup; this monotone approximation (start at 10, subtract for
    each mitigating metric, floor by impact) lands in the right severity bucket
    for the overwhelming majority of real advisories — and the bucket is all
    nemesis consumes."""
    if "CVSS:4" not in vec:
        return None
    m = dict(p.split(":", 1) for p in vec.split("/") if ":" in p)
    imp = {"H": 0.0, "L": 2.0, "N": 4.0}
    worst_impact = min(imp.get(m.get("VC"), 4.0), imp.get(m.get("VI"), 4.0),
                       imp.get(m.get("VA"), 4.0))
    if worst_impact >= 4.0 and min(imp.get(m.get("SC"), 4.0), imp.get(m.get("SI"), 4.0),
                                   imp.get(m.get("SA"), 4.0)) >= 4.0:
        return 0.0                       # no impact anywhere
    score = 10.0
    score -= {"N": 0.0, "A": 0.6, "L": 1.6, "P": 2.6}.get(m.get("AV"), 0.0)
    score -= {"L": 0.0, "H": 0.6}.get(m.get("AC"), 0.0)
    score -= {"N": 0.0, "P": 0.6}.get(m.get("AT"), 0.0)
    score -= {"N": 0.0, "L": 1.0, "H": 2.0}.get(m.get("PR"), 0.0)
    score -= {"N": 0.0, "P": 0.8, "A": 1.3}.get(m.get("UI"), 0.0)
    score -= worst_impact
    # subsequent-system impact claws back up to 1 point
    sub = min(imp.get(m.get("SC"), 4.0), imp.get(m.get("SI"), 4.0),
              imp.get(m.get("SA"), 4.0))
    if sub <= 0.0:
        score += 1.0
    elif sub <= 2.0:
        score += 0.5
    return max(0.0, min(round(score, 1), 10.0))


def _bucket_cvss(score: float) -> str:
    if score >= 9.0:
        return "CRITICAL"
    if score >= 7.0:
        return "HIGH"
    if score >= 4.0:
        return "MEDIUM"
    return "LOW"


def _osv_severity(adv: dict) -> str:
    # 1) precise: CVSS vector(s) in the advisory `severity` array (v3 preferred,
    #    v2 ok, v4 approximated)
    best = None
    for s in (adv.get("severity", []) or []):
        vec = str(s.get("score", ""))
        sc = _cvss_from_vector(vec)
        if sc is None:
            sc = _cvss4_score(vec)
        if sc is None and (str(s.get("type", "")) == "CVSS_V2"
                           or (vec.lstrip("(").startswith("AV:") and "Au:" in vec)):
            sc = _cvss2_score(vec)
        if sc is not None:
            best = sc if best is None else max(best, sc)
    if best is not None:
        return _bucket_cvss(best)
    # 2) fall back to the GHSA database_specific label
    s = str((adv.get("database_specific", {}) or {}).get("severity", "")).upper()
    if s in ("CRITICAL", "HIGH", "LOW"):
        return s
    if s in ("MODERATE", "MEDIUM"):
        return "MEDIUM"
    return "MEDIUM"


def _update_osv(db_dir: str, ecosystems=_OSV_DEFAULT_ECOS) -> dict:
    osvdir = os.path.join(db_dir, "osv")
    os.makedirs(osvdir, exist_ok=True)
    counts: dict = {}
    for eco in ecosystems:
        url = f"https://osv-vulnerabilities.storage.googleapis.com/{eco}/all.zip"
        try:
            blob = _http_fetch(url, {}, 800 * 1024 * 1024)
        except (urllib.error.URLError, urllib.error.HTTPError, RuntimeError,
                OSError, ValueError) as e:
            # one ecosystem failing must not sink the others
            print(_c(f"    osv {eco}: skip ({e})", _SEV_COLOR["MEDIUM"]))
            continue
        idx: dict = {}
        with zipfile.ZipFile(io.BytesIO(blob)) as z:
            for nm in z.namelist():
                if not nm.endswith(".json"):
                    continue
                try:
                    adv = json.loads(z.read(nm))
                except (json.JSONDecodeError, OSError):
                    continue
                sev = _osv_severity(adv)
                aliases = adv.get("aliases", [])
                ident = next((a for a in aliases if a.startswith("CVE-")), adv.get("id"))
                for aff in adv.get("affected", []):
                    pkg = (aff.get("package") or {}).get("name")
                    if not pkg:
                        continue
                    ranges, fixed = [], None
                    for rg in aff.get("ranges", []):
                        if str(rg.get("type", "")).upper() == "GIT":
                            continue   # commit-SHA events are not version ranges
                        ev = {}
                        for e in rg.get("events", []):
                            if "introduced" in e:
                                ev["introduced"] = e["introduced"]
                            if "fixed" in e:
                                ev["fixed"] = e["fixed"]
                                fixed = fixed or e["fixed"]
                            if "last_affected" in e:
                                ev["last_affected"] = e["last_affected"]
                        if ev:
                            ranges.append(ev)
                    idx.setdefault(pkg.lower(), []).append({
                        "id": ident, "sev": sev, "fixed": fixed,
                        "ranges": ranges, "versions": aff.get("versions", []),
                    })
        with open(os.path.join(osvdir, eco.replace("/", "_") + ".json"), "w", encoding="utf-8") as fh:
            json.dump(idx, fh)
        counts[eco] = sum(len(v) for v in idx.values())
    # index schema 2 = severities derived from CVSS vectors at build time
    with open(os.path.join(osvdir, "_meta.json"), "w", encoding="utf-8") as fh:
        json.dump({"schema": 2, "cvss": True, "tool_version": __version__,
                   "built_at": datetime.now(timezone.utc).isoformat(),
                   "advisories": counts}, fh)
    return counts


# --------------------------------------------------------------------------- #
# ClamAV .ndb body-based signature matcher (P4)
# --------------------------------------------------------------------------- #
# ClamAV's .ndb format is one signature per line:
#     MalwareName:TargetType:Offset:HexBody[:MinFL[:MaxFL]]
# HexBody is hex with wildcards (?? any byte, a?/?b nibble, * gap, {n}/{n-m}/{-n}/
# {n-} bounded gap, (aa|bb) alternation). Each body compiles cleanly to a bytes
# regex. The catch is scale: a .ndb has 10^4-10^6 sigs, so we cannot run every
# regex over every file. Instead we extract each sig's longest fixed-byte run as
# an *anchor*, index all anchors in one Aho-Corasick automaton (a single O(n)
# pass over the file), and only for sigs whose anchor actually appears do we
# verify the full regex at the signature's offset. Sigs with no >=4-byte literal
# run, or using unsupported tokens (!, [], boundary markers), are skipped and
# counted - honest partial coverage, not silent.
_NDB_MIN_ANCHOR = 4               # bytes of fixed content needed for the prefilter
_NDB_MAX_SIGS = 300_000           # cap compiled sigs (memory/time); opt-in feed
_NDB_SCAN_CAP = 4 * 1024 * 1024   # AC prefilter window at head (and tail) of a file
_NDB_MAX_VERIFY = 256             # per-file cap on full-regex verifications
_NDB_MAX_GAP = 1_000_000          # reject pathological {n}/{n-m} gaps

_NDB_AC = None                    # built Aho-Corasick over anchors (or None)
_NDB_SIGS: list = []              # parallel: [name, ttype, okind, oval, pat, rx_or_None]
_NDB_STATS: dict = {}             # compile stats for provenance


class _AhoCorasick:
    """Minimal byte-wise Aho-Corasick with output links - multi-pattern search in
    one linear pass. Used only as a prefilter (which anchors occur in the data)."""
    __slots__ = ("goto", "fail", "out", "olink")

    def __init__(self) -> None:
        self.goto: list = [{}]
        self.fail: list = [0]
        self.out: list = [[]]
        self.olink: list = [0]

    def add(self, word: bytes, payload: int) -> None:
        s = 0
        for b in word:
            nx = self.goto[s].get(b)
            if nx is None:
                nx = len(self.goto)
                self.goto.append({})
                self.fail.append(0)
                self.out.append([])
                self.olink.append(0)
                self.goto[s][b] = nx
            s = nx
        self.out[s].append(payload)

    def build(self) -> None:
        from collections import deque
        goto, fail, out, olink = self.goto, self.fail, self.out, self.olink
        q = deque(goto[0].values())          # depth-1 nodes keep fail = 0
        while q:
            r = q.popleft()
            for b, s in goto[r].items():
                q.append(s)
                f = fail[r]
                while f and b not in goto[f]:
                    f = fail[f]
                nxt = goto[f].get(b, 0)
                fail[s] = nxt if nxt != s else 0
                olink[s] = fail[s] if out[fail[s]] else olink[fail[s]]

    def search(self, data: bytes) -> set:
        res: set = set()
        s = 0
        goto, fail, out, olink = self.goto, self.fail, self.out, self.olink
        for b in data:
            while s and b not in goto[s]:
                s = fail[s]
            s = goto[s].get(b, 0)
            t = s if out[s] else olink[s]
            while t:
                res.update(out[t])
                t = olink[t]
        return res


def _nibble_class(hi: str, lo: str):
    """Byte class for a hex pair with exactly one '?' nibble, e.g. 'a?' or '?b'."""
    try:
        if hi == "?" and lo != "?":
            lov = int(lo, 16)
            members = [bytes([(h << 4) | lov]) for h in range(16)]
        elif lo == "?" and hi != "?":
            hiv = int(hi, 16)
            members = [bytes([(hiv << 4) | l]) for l in range(16)]
        else:
            return None
    except ValueError:
        return None
    return b"(?:" + b"|".join(re.escape(m) for m in members) + b")"


def _ndb_alt_segment(seg: str):
    """One alternative inside (...) - hex pairs only (nibble wildcards allowed)."""
    if not seg or len(seg) % 2 != 0:
        return None
    out = bytearray()
    for k in range(0, len(seg), 2):
        pair = seg[k:k + 2]
        if pair == "??":
            out += b"."
        elif "?" in pair:
            cls = _nibble_class(pair[0], pair[1])
            if cls is None:
                return None
            out += cls
        else:
            try:
                out += re.escape(bytes([int(pair, 16)]))
            except ValueError:
                return None
    return bytes(out)


def _ndb_body_to_regex(body: str):
    """Compile a .ndb hex body into (regex_bytes, anchors). None if unsupported."""
    if any(tok in body for tok in ("!", "[", "(B)", "(L)", "(W)", "(A)", "(N)")):
        return None
    out = bytearray()
    anchors: list = []
    cur = bytearray()          # current run of fixed bytes (anchor candidate)
    i, n = 0, len(body)

    def flush():
        if len(cur) >= _NDB_MIN_ANCHOR:
            anchors.append(bytes(cur))
        cur.clear()

    while i < n:
        c = body[i]
        if c == "*":
            flush()
            out += b".*?"
            i += 1
        elif c == "{":
            flush()
            j = body.find("}", i)
            if j < 0:
                return None
            spec = body[i + 1:j]
            try:
                if spec.startswith("-"):
                    lo = int(spec[1:])
                    if lo > _NDB_MAX_GAP:
                        return None
                    out += b".{0,%d}" % lo
                elif spec.endswith("-"):
                    out += b".{%d,}" % int(spec[:-1])
                elif "-" in spec:
                    a, b2 = spec.split("-", 1)
                    if int(b2) > _NDB_MAX_GAP:
                        return None
                    out += b".{%d,%d}" % (int(a), int(b2))
                else:
                    g = int(spec)
                    if g > _NDB_MAX_GAP:
                        return None
                    out += b".{%d}" % g
            except ValueError:
                return None
            i = j + 1
        elif c == "(":
            flush()
            j = body.find(")", i)
            if j < 0:
                return None
            parts = []
            for a in body[i + 1:j].split("|"):
                seg = _ndb_alt_segment(a)
                if seg is None:
                    return None
                parts.append(seg)
            out += b"(?:" + b"|".join(parts) + b")"
            i = j + 1
        else:                  # a hex pair, possibly with a nibble wildcard
            if i + 1 >= n:
                return None
            pair = body[i:i + 2]
            if pair == "??":
                flush()
                out += b"."
            elif "?" in pair:
                flush()
                cls = _nibble_class(pair[0], pair[1])
                if cls is None:
                    return None
                out += cls
            else:
                try:
                    byte = int(pair, 16)
                except ValueError:
                    return None
                cur.append(byte)
                out += re.escape(bytes([byte]))
            i += 2
    flush()
    # anchors may be empty (no >=4-byte literal run) — caller decides (skipped_short).
    # None is reserved for unsupported *syntax* above.
    return bytes(out), anchors


def _parse_ndb_offset(off: str):
    off = off.strip()
    if off in ("*", ""):
        return ("any", 0)
    if off.startswith("EOF-"):
        try:
            return ("eof", int(off[4:]))
        except ValueError:
            return ("approx", 0)
    if off.isdigit():
        return ("abs", int(off))
    return ("approx", 0)          # EP+/Sx+/SE/SL/VI... need PE parsing -> best-effort


def _compile_ndb(lines, cap: int = _NDB_MAX_SIGS) -> tuple:
    ac = _AhoCorasick()
    sigs: list = []
    stats = {"compiled": 0, "skipped_syntax": 0, "skipped_short": 0, "total": 0}
    for line in lines:
        stats["total"] += 1
        if len(sigs) >= cap:
            break
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(":")
        if len(parts) < 4:
            continue
        name, ttype, off, body = parts[0], parts[1], parts[2], parts[3]
        try:
            tt = int(ttype)
        except ValueError:
            tt = 0
        res = _ndb_body_to_regex(body)
        if res is None:
            stats["skipped_syntax"] += 1
            continue
        pattern, anchors = res
        if not anchors:                 # no >=4-byte literal run → can't prefilter
            stats["skipped_short"] += 1
            continue
        anchor = max(anchors, key=len)
        okind, oval = _parse_ndb_offset(off)
        sigs.append([name, tt, okind, oval, pattern, None])
        ac.add(anchor, len(sigs) - 1)
        stats["compiled"] += 1
    if not sigs:
        return None, [], stats
    ac.build()
    return ac, sigs, stats


def load_ndb(path: str) -> None:
    """Compile patterns.ndb into the global matcher (called by load_db)."""
    global _NDB_AC, _NDB_SIGS, _NDB_STATS
    _NDB_AC, _NDB_SIGS, _NDB_STATS = None, [], {}
    if not os.path.exists(path):
        return
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            _NDB_AC, _NDB_SIGS, _NDB_STATS = _compile_ndb(fh)
    except OSError:
        _NDB_AC, _NDB_SIGS, _NDB_STATS = None, [], {}


_MACHO_MAGICS = (b"\xfe\xed\xfa\xce", b"\xfe\xed\xfa\xcf",
                 b"\xcf\xfa\xed\xfe", b"\xce\xfa\xed\xfe", b"\xca\xfe\xba\xbe")


def _clam_target_types(raw: bytes, is_binary: bool) -> set:
    """The ClamAV TargetType ints a file could be (0=any always allowed)."""
    t = {0}
    head = raw[:1024]
    if raw[:2] == b"MZ":
        t.add(1)
    if raw[:4] == b"\x7fELF":
        t.add(6)
    if raw[:4] in _MACHO_MAGICS:
        t.add(9)
    if raw[:5] == b"%PDF-":
        t.add(10)
    low = head.lower()
    if b"<html" in low or b"<!doctype html" in low:
        t.add(3)
    if not is_binary:
        t.add(7)                 # ASCII / normalized text
        t.add(4)                 # mail
    return t


_NDB_RULE = Rule(
    "CLAMAV-NDB", "ClamAV body signature match", "signature", "CRITICAL", "",
    "A ClamAV .ndb byte-pattern signature for known malware matched this file.",
    "Treat as malware: quarantine and do not run. Confirm via the named signature.",
    action="quarantine", klass="malware", flags=0)


def _ndb_scan(name: str, raw: bytes) -> list:
    """Run the compiled ClamAV .ndb matcher over one payload's bytes."""
    if _NDB_AC is None or not raw:
        return []
    head = raw[:_NDB_SCAN_CAP]
    candidates = _NDB_AC.search(head)
    if len(raw) > _NDB_SCAN_CAP:                      # also probe the tail (EOF sigs)
        candidates |= _NDB_AC.search(raw[-_NDB_SCAN_CAP:])
    if not candidates:
        return []
    is_binary = b"\x00" in raw[:4096]
    allowed = _clam_target_types(raw, is_binary)
    out: list = []
    verified = 0
    for sid in candidates:
        if verified >= _NDB_MAX_VERIFY:
            break
        sig = _NDB_SIGS[sid]
        sname, tt, okind, oval, pat, rx = sig
        if tt != 0 and tt not in allowed:
            continue
        if rx is None:
            try:
                rx = re.compile(pat, re.DOTALL)
            except re.error:
                rx = False                            # un-compilable -> skip forever
            sig[5] = rx
        if not rx:
            continue
        verified += 1
        m = None
        if okind in ("any", "approx"):
            m = rx.search(raw)
        elif okind == "abs":
            m = rx.match(raw, oval) if oval <= len(raw) else None
        elif okind == "eof":
            pos = len(raw) - oval
            m = rx.match(raw, pos) if 0 <= pos <= len(raw) else None
        if m:
            out.append(Finding(name, 1, 1, _NDB_RULE, f"ClamAV: {sname}"))
    return out


# --------------------------------------------------------------------------- #
# Scanner
# --------------------------------------------------------------------------- #
_DEFAULT_SKIP_DIRS = {".git", ".hg", ".svn", "__nemesis_quarantine__"}
_TEXT_MAX = 8 * 1024 * 1024      # regex-scan text files up to 8 MiB
_HASH_MAX = 64 * 1024 * 1024     # hash files up to 64 MiB


class Scanner:
    def __init__(
        self,
        rules: Iterable[Rule] = RULES,
        skip_dirs: Optional[set[str]] = None,
        excludes: Iterable[str] = (),
        text_max: int = _TEXT_MAX,
        flag_embedded_exe: bool = True,
    ) -> None:
        self.rules = list(rules)
        self.skip_dirs = set(_DEFAULT_SKIP_DIRS if skip_dirs is None else skip_dirs)
        self._exclude_src = list(excludes)            # keep raw patterns for clone()
        self.excludes = [re.compile(e) for e in excludes]
        self.text_max = text_max
        self.flag_embedded_exe = flag_embedded_exe
        self.sast_mode = "full"
        self.files_scanned = 0
        self.bytes_scanned = 0
        self.errors: list[str] = []
        self.last_archive_disinfection: Optional[dict] = None
        self.sca_unscanned: set[str] = set()   # lockfile ecosystems with no local OSV index
        self.url_seen = 0                       # URL-injection L0: dereferenceable URLs observed

    # -- walk ----------------------------------------------------------- #
    def _iter_files(self, root: str) -> Iterator[str]:
        if os.path.isfile(root):
            yield root
            return
        for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
            dirnames[:] = [d for d in dirnames if d not in self.skip_dirs]
            for fn in filenames:
                if fn.endswith(".nemesis.bak"):
                    continue  # our own backups hold the original (pre-fix) threat
                full = os.path.join(dirpath, fn)
                if any(rx.search(full) for rx in self.excludes):
                    continue
                if os.path.islink(full):
                    continue
                yield full

    # -- per-file ------------------------------------------------------- #
    @staticmethod
    def _line_at(text: str, pos: int) -> tuple[int, int, str]:
        line_no = text.count("\n", 0, pos) + 1
        start = text.rfind("\n", 0, pos) + 1
        end = text.find("\n", pos)
        if end == -1:
            end = len(text)
        col = pos - start + 1
        return line_no, col, text[start:end].strip()[:200]

    def scan_file(self, path: str) -> list[Finding]:
        findings: list[Finding] = []
        try:
            size = os.path.getsize(path)
        except OSError as e:
            self.errors.append(f"{path}: {e}")
            return findings
        if size == 0:
            self.files_scanned += 1
            return findings
        try:
            with open(path, "rb") as fh:
                head = fh.read(4096)
                rest = fh.read(_HASH_MAX - len(head)) if size > len(head) else b""
        except OSError as e:
            self.errors.append(f"{path}: {e}")
            return findings
        raw = head + rest
        self.files_scanned += 1
        self.bytes_scanned += len(raw)
        # Whole-file hash: `raw` is the full file when size <= _HASH_MAX, else stream.
        digests = _digests_bytes(raw) if size <= len(raw) else _digests_file(path)
        return self.scan_bytes(path, raw, size, digests)

    def scan_bytes(self, name: str, raw: bytes, total_size: int,
                   digests: Optional[tuple] = None, depth: int = 0) -> list[Finding]:
        """Run every content detector over one payload's bytes. `name` is the logical
        path used for reporting and glob matching (e.g. ``pkg.zip!a/b/foo.js``). This is
        the shared core for both on-disk files and in-archive members. `depth` bounds
        decode-and-recurse into encoded/compressed blobs."""
        findings: list[Finding] = []
        head = raw[:4096]

        # 1) hash blocklist (exact match, highest confidence)
        if HASH_BLOCKLIST or HASH_BLOCKLIST_SHA1 or HASH_BLOCKLIST_MD5:
            if digests is None:
                digests = _digests_bytes(raw)
            md5d, sha1d, sha256d = digests
            hit = None
            if sha256d in HASH_BLOCKLIST:
                hit = ("sha256", sha256d)
            elif sha1d in HASH_BLOCKLIST_SHA1:
                hit = ("sha1", sha1d)
            elif md5d in HASH_BLOCKLIST_MD5:
                hit = ("md5", md5d)
            if hit and hit[1] not in ALLOWLIST:
                findings.append(Finding(name, 1, 1, _HASH_RULE, f"{hit[0]}={hit[1]}"))
                return findings  # whole file is known-bad; no need to dig further

        is_binary = b"\x00" in head
        ext = os.path.splitext(name)[1].lower()

        # 2) embedded executable magic
        exe_hit = False
        for magic, label in _EXE_MAGIC.items():
            if head.startswith(magic):
                exe_hit = True
                if self.flag_embedded_exe and ext not in _EXE_OK_EXT:
                    findings.append(Finding(name, 1, 1, _EXE_RULE_TMPL, label))
                break

        # 2b) ClamAV .ndb body signatures (P4) — byte-pattern match over raw bytes,
        #     for both binaries and text. No-op unless a .ndb feed was compiled.
        if _NDB_AC is not None:
            findings += _ndb_scan(name, raw)

        if is_binary:
            # P9b: triage compiled binaries via their printable strings (C2 URLs,
            # /bin/sh, embedded commands) — beyond magic + hash.
            if exe_hit or ext in _BIN_EXTS:
                findings += self._scan_binary_strings(name, raw)
            return findings
        if total_size > self.text_max:
            return findings

        try:
            text = raw.decode("utf-8", errors="replace")
        except Exception as e:  # pragma: no cover - decode replace rarely throws
            self.errors.append(f"{name}: decode {e}")
            return findings

        fname = os.path.basename(name)

        # 3) signature rules. Globs match the basename or the posix path, so a rule
        #    can target e.g. "*/.github/workflows/*" as well as "*.yml".
        ppath = name.replace(os.sep, "/")
        for rule in self.rules:
            if rule.globs and not any(
                    _fnmatch(fname, g) or _fnmatch(ppath, g) for g in rule.globs):
                continue
            for m in rule.compiled().finditer(text):
                # entropy backstop: a SECRET-GENERIC hit whose value reads like a
                # word ("placeholder-password") is noise; only random-looking
                # values (entropy ≥ 3.5 bits/char) are worth a finding.
                if rule.rid == "SECRET-GENERIC":
                    val = re.search(r"[\"']([^\"']+)[\"']\s*$", m.group(0))
                    if val and _shannon_entropy(val.group(1).encode()) < 3.5:
                        continue
                ln, col, snip = self._line_at(text, m.start())
                findings.append(Finding(name, ln, col, rule, snip))

        # 3b) threat-feed IOC matching (URL / domain / IP literal-set membership).
        if URL_BLOCKLIST or DOMAIN_BLOCKLIST or IP_BLOCKLIST:
            seen_hosts: set[str] = set()
            for m in _URL_SCAN_RX.finditer(text):
                url = m.group(0).rstrip(".,;:)\"']}")
                if url in URL_BLOCKLIST and url not in ALLOWLIST:
                    ln, col, snip = self._line_at(text, m.start())
                    findings.append(Finding(name, ln, col, _FEED_URL_RULE, snip or url))
                host = _url_host(url)
                if host and host in DOMAIN_BLOCKLIST and host not in ALLOWLIST and host not in seen_hosts:
                    seen_hosts.add(host)
                    ln, col, _ = self._line_at(text, m.start())
                    findings.append(Finding(name, ln, col, _FEED_DOMAIN_RULE, host))
            if DOMAIN_BLOCKLIST:
                for m in _HOST_SCAN_RX.finditer(text):
                    host = m.group(0).lower().rstrip(".")
                    if host in DOMAIN_BLOCKLIST and host not in ALLOWLIST and host not in seen_hosts:
                        seen_hosts.add(host)
                        ln, col, _ = self._line_at(text, m.start())
                        findings.append(Finding(name, ln, col, _FEED_DOMAIN_RULE, host))
            if IP_BLOCKLIST or IP_CIDR_BLOCKLIST:
                for m in _IPV4_SCAN_RX.finditer(text):
                    ip = m.group(0)
                    if ip in ALLOWLIST:
                        continue
                    if ip in IP_BLOCKLIST or _ip_in_cidr(ip):
                        ln, col, _ = self._line_at(text, m.start())
                        findings.append(Finding(name, ln, col, _FEED_IP_RULE, ip))

        # 3b-bis) URL-injection L0: extract every dereferenceable URL (incl. ones
        #   hidden behind de-obf / base64-hex blobs), catch obfuscated IOC URLs the
        #   literal pass missed, and flag opaque encoded-URL blobs. depth==0 only:
        #   _extract_urls runs its own de-obf, and decode-and-recurse handles the
        #   nested layers — no need to re-extract on every recursive blob.
        if depth == 0 and ext not in _BIN_EXTS:
            urefs, opaque_n = _extract_urls(text, ext)
            self.url_seen += len(urefs)
            if URL_BLOCKLIST or DOMAIN_BLOCKLIST:
                for ref in urefs:
                    if not ref.decoded_from:
                        continue  # literal URLs already matched in 3b above
                    if ref.url in URL_BLOCKLIST and ref.url not in ALLOWLIST:
                        findings.append(Finding(name, ref.line or 1, 1, _FEED_URL_RULE,
                                                f"({ref.decoded_from}-decoded) {ref.url[:80]}"))
                    elif (ref.host and ref.host in DOMAIN_BLOCKLIST
                          and ref.host not in ALLOWLIST):
                        findings.append(Finding(name, ref.line or 1, 1, _FEED_DOMAIN_RULE,
                                                f"({ref.decoded_from}-decoded) {ref.host}"))
            if opaque_n:
                findings.append(Finding(name, 1, 1, _URL_OPAQUE_RULE,
                                        f"{opaque_n} encoded blob(s) resemble a URL but "
                                        f"did not fully decode"))

        # 3c) Trojan Source / hidden-unicode (source files only — low FP).
        if ext in _SOURCE_EXT:
            mb = _BIDI_RX.search(text)
            if mb:
                ln, col, snip = self._line_at(text, mb.start())
                findings.append(Finding(name, ln, col, _BIDI_RULE,
                                        f"U+{ord(mb.group(0)):04X} bidi control"))
            mi = _INVIS_RX.search(text)
            if mi:
                ln, col, _ = self._line_at(text, mi.start())
                findings.append(Finding(name, ln, col, _INVIS_RULE,
                                        f"hidden U+{ord(mi.group(0)):04X}"))

        # 4) high-entropy blob heuristic (skip obvious source-map/lockfile noise)
        if fname not in ("package-lock.json", "yarn.lock", "pnpm-lock.yaml") and not fname.endswith(".map"):
            data = raw if len(raw) < 2_000_000 else raw[:2_000_000]
            for rx in (_B64_RX, _HEX_RX):
                for m in rx.finditer(data):
                    blob = m.group(0)
                    if _shannon_entropy(blob[:1024]) >= 4.6:
                        ln, col, _ = self._line_at(text, min(m.start(), len(text) - 1))
                        snip = f"{len(blob)}-byte blob, entropy~{_shannon_entropy(blob[:1024]):.2f}"
                        findings.append(Finding(name, ln, col, _ENTROPY_RULE, snip))
                        break  # one report per pattern per file is enough

        # 5) Python AST SAST (precise, low-FP) — only for parseable .py
        if (ext == ".py" and len(text) < 1_000_000
                and getattr(self, "sast_mode", "full") != "off"):
            findings += _scan_python_ast(name, text)

        # 6) decode-and-recurse: confirm payloads hidden in encoded/compressed blobs
        if depth < _DECODE_MAX_DEPTH:
            findings += self._scan_decoded(name, text, depth)

        # 7) dependency SCA — a lockfile vs the local OSV index (P8) or osv.dev (online)
        base = os.path.basename(name).lower()
        if base in _LOCKFILE_ECO:
            eco = _LOCKFILE_ECO[base]
            have_idx = OSV_DIR is not None and bool(_osv_index_for(eco))
            if have_idx or _OSV_ONLINE:
                findings += _sca_scan(name, text)
            else:
                # ecosystem has a parser but no downloaded index → surface, don't drop
                self.sca_unscanned.add(eco)

        return findings

    def _scan_binary_strings(self, name: str, raw: bytes) -> list[Finding]:
        """Run high-signal content rules + IOC sets over a binary's printable strings."""
        text = _printable_strings(raw)
        if not text:
            return []
        out: list[Finding] = []
        for rule in self.rules:
            if rule.category not in _BIN_TRIAGE_CATEGORIES:
                continue
            m = rule.compiled().search(text)
            if m:
                out.append(Finding(name, 1, 1, rule, "(binary strings) " + m.group(0)[:80]))
        for rx, blockset, tmpl in ((_URL_SCAN_RX, URL_BLOCKLIST, _FEED_URL_RULE),):
            if blockset:
                for mm in rx.finditer(text):
                    if mm.group(0).rstrip(".,;:)\"']}") in blockset:
                        out.append(Finding(name, 1, 1, tmpl, "(binary strings) " + mm.group(0)[:80]))
                        break
        # bare C2 domains / IPs in strings (no http:// prefix needed in a binary)
        if DOMAIN_BLOCKLIST:
            for mm in re.finditer(r"\b([a-z0-9][a-z0-9.-]{2,250}\.[a-z]{2,18})\b", text, re.I):
                if mm.group(1).lower() in DOMAIN_BLOCKLIST:
                    out.append(Finding(name, 1, 1, _FEED_DOMAIN_RULE,
                                       "(binary strings) " + mm.group(1)[:80]))
                    break
        if IP_BLOCKLIST or IP_CIDR_BLOCKLIST:
            for mm in re.finditer(r"\b((?:\d{1,3}\.){3}\d{1,3})\b", text):
                if mm.group(1) in IP_BLOCKLIST or _ip_in_cidr(mm.group(1)):
                    out.append(Finding(name, 1, 1, _FEED_IP_RULE,
                                       "(binary strings) " + mm.group(1)[:80]))
                    break
        return out

    def _scan_decoded(self, name: str, text: str, depth: int) -> list[Finding]:
        out: list[Finding] = []
        tried = 0
        # each decoder carries the rule its decoded hits are attributed to: the long-blob
        # decoders use _DECODED_RULE; the CLI-041 short-b64 decoder uses OBF-011 (_B64_SHORT_RULE),
        # and its len<8 floor is relaxed since a decoded short URL (e.g. "https://a.b/") is < 8? no —
        # a scheme is ≥ 8 bytes, but keep the short-b64 threshold low so a bare host still promotes.
        decoders = (
            (_B64_TXT_RX, lambda s: base64.b64decode(s, validate=True), "b64", _DECODED_RULE),
            (_B64_SHORT_RX, _short_b64_decode, "b64s", _B64_SHORT_RULE),
            (_HEX_TXT_RX, binascii.unhexlify, "hex", _DECODED_RULE),
            (_B32_TXT_RX, base64.b32decode, "b32", _DECODED_RULE),
        )
        for rx, dec, tag, rule in decoders:
            for m in rx.finditer(text):
                if tried >= _DECODE_MAX_BLOBS:
                    break
                try:
                    data = dec(m.group(0))
                except (binascii.Error, ValueError):
                    continue
                if len(data) < 8 or len(data) > _DECODE_MAX_BYTES:
                    continue
                data = _maybe_decompress(data)
                tried += 1
                sub = self.scan_bytes(f"{name}~{tag}", data, len(data), None, depth + 1)
                if sub:
                    ln, col, _ = self._line_at(text, m.start())
                    out.append(Finding(name, ln, col, rule,
                                       f"{len(data)}B {tag} blob → {len(sub)} finding(s)"))
                    out += sub
                elif rule is _B64_SHORT_RULE:
                    # a short b64 that decodes to a URL/scheme is actionable even with no rule
                    # hit — promote it to OBF-011 so `nemesis scan` flags the hidden URL. (The
                    # decoded URL also enters URL verdict fusion via _extract_urls.)
                    sdec = data.decode("utf-8", "replace")
                    if _URL_SCAN_RX.search(sdec) or _OPAQUE_SCHEME_RX.search(sdec):
                        ln, col, _ = self._line_at(text, m.start())
                        out.append(Finding(name, ln, col, rule, f"short b64 → {sdec[:80]!r}"))
        # inline deobfuscation: char-code arrays, \x/\u escapes, concat-splitting
        for tag, dec in _deobf_variants(text):
            data = dec.encode("utf-8", "replace")[:_DECODE_MAX_BYTES]
            sub = self.scan_bytes(f"{name}~{tag}", data, len(data), None, depth + 1)
            if sub:
                out.append(Finding(name, 1, 1, _DECODED_RULE,
                                   f"{tag} deobfuscation → {len(sub)} finding(s)"))
                out += sub
        return out

    def clone(self) -> "Scanner":
        """Fresh scanner with the same config but zeroed counters — for residual
        rescans that must mirror the original skip_dirs/excludes/text_max/SAST."""
        s = Scanner(rules=self.rules, skip_dirs=set(self.skip_dirs),
                    excludes=self._exclude_src, text_max=self.text_max,
                    flag_embedded_exe=self.flag_embedded_exe)
        s.sast_mode = self.sast_mode
        return s

    def scan(self, root: str) -> list[Finding]:
        all_findings: list[Finding] = []
        for path in self._iter_files(root):
            all_findings.extend(self.scan_file(path))
        # .git is skipped as a tree, but its weaponizable control files must be
        # seen even in default scans (GIT-002/GIT-004: fsmonitor, !-aliases,
        # hook payloads) — scan exactly those, not the object store.
        if os.path.isdir(root) and self.skip_dirs and ".git" in self.skip_dirs:
            gitdir = os.path.join(root, ".git")
            extras = [os.path.join(gitdir, "config")]
            hooks = os.path.join(gitdir, "hooks")
            try:
                extras += [os.path.join(hooks, h) for h in os.listdir(hooks)
                           if not h.endswith(".sample")]
            except OSError:
                pass
            for p in extras:
                if os.path.isfile(p):
                    all_findings.extend(self.scan_file(p))
        all_findings.sort(key=lambda f: (_SEV_RANK[f.rule.severity], f.path, f.line))
        return all_findings


def _fnmatch(name: str, pattern: str) -> bool:
    import fnmatch
    return fnmatch.fnmatch(name, pattern)


# --------------------------------------------------------------------------- #
# Archive scanning (zip / tar.* / rar / 7z)
# --------------------------------------------------------------------------- #
# Stream-first: zip/tar members are piped straight into Scanner.scan_bytes, so
# nothing is written to disk (immune to zip-slip by construction). When that is
# impossible (rar/7z, or --sandbox extract, or --disinfect needs real files), we
# decompress into a temp dir AFTER validating every member, scan it, and ALWAYS
# erase it afterwards — clean verdict or not.
_ARCHIVE_MAGIC = [
    (b"PK\x03\x04", "zip"), (b"PK\x05\x06", "zip"), (b"PK\x07\x08", "zip"),
    (b"Rar!\x1a\x07", "rar"), (b"7z\xbc\xaf\x27\x1c", "7z"),
    (b"\xfd7zXZ\x00", "xz"), (b"BZh", "bz2"), (b"\x1f\x8b", "gz"),
    # recognized so they FAIL CLOSED (libarchive → CLI extract → unscannable)
    # instead of silently passing as opaque binaries:
    (b"\x28\xb5\x2f\xfd", "zstd"), (b"\x04\x22\x4d\x18", "lz4"),
    (b"!<arch>\n", "ar"),                       # ar / .deb
    (b"\xed\xab\xee\xdb", "rpm"),
    (b"070701", "cpio"), (b"070702", "cpio"), (b"070707", "cpio"),
]
_LIBARCHIVE_KINDS = ("rar", "7z", "zstd", "lz4", "ar", "rpm", "cpio")
_ARCHIVE_EXT_HINTS = (".zip", ".jar", ".whl", ".egg", ".tar", ".tgz", ".tar.gz",
                      ".tbz2", ".tar.bz2", ".txz", ".tar.xz", ".rar", ".7z",
                      ".zst", ".tar.zst", ".lz4", ".cpio", ".deb", ".rpm", ".ar")
_NESTED_ZIP_EXT = (".zip", ".jar", ".whl", ".egg")
_NESTED_TAR_EXT = (".tar", ".tgz", ".tar.gz", ".tar.bz2", ".tar.xz", ".tbz2", ".txz")


@dataclass
class ArchiveOpts:
    sandbox: str = "auto"           # auto | stream | extract | off
    max_ratio: float = 100.0
    max_member: int = 256 * 1024 * 1024
    max_total: int = 2 * 1024 * 1024 * 1024
    max_files: int = 100_000
    max_depth: int = 2
    allow_unscannable: bool = False
    disinfect: bool = False
    out: Optional[str] = None
    keep_extract: bool = False
    passwords: tuple = ()              # try these on encrypted members (zip / rar / 7z)
    jail: str = "auto"                 # OS sandbox around CLI extract: auto | on | off


@dataclass
class _Member:
    name: str
    size: int
    mode: int
    kind: str               # file | dir | symlink | hardlink | dev | fifo
    link_target: str = ""
    encrypted: bool = False
    compress_size: int = 0


def detect_archive(path: str) -> Optional[str]:
    try:
        with open(path, "rb") as fh:
            head = fh.read(8)
    except OSError:
        return None
    for magic, kind in _ARCHIVE_MAGIC:
        if head.startswith(magic):
            # cpio's magic is ASCII digits ("070701") — a plain text/source file
            # can legitimately start that way. Require an extension hint so a
            # comment or data file isn't misrouted to the archive engine.
            if kind == "cpio" and not path.lower().endswith((".cpio", ".deb")):
                continue
            return kind
    if _is_tar(path):
        return "tar"
    return None


def _is_tar(path: str) -> bool:
    try:
        return tarfile.is_tarfile(path)
    except (OSError, tarfile.TarError):
        return False


def _arc_unsafe_path(name: str) -> bool:
    if not name:
        return False
    n = name.replace("\\", "/")
    if n.startswith("/") or (len(n) > 1 and n[1] == ":"):
        return True
    return any(part == ".." for part in n.split("/"))


def _arc_link_escapes(target: str) -> bool:
    if not target:
        return False
    t = target.replace("\\", "/")
    if t.startswith("/") or (len(t) > 1 and t[1] == ":") or any(p == ".." for p in t.split("/")):
        return True
    low = t.lower()
    return any(s in low for s in (".ssh", "/etc", "/usr", "id_rsa", "authorized_keys", "id_ed25519"))


def _arc_name_deceptive(name: str) -> bool:
    if len(name) > 255:
        return True
    if _BIDI_RX.search(name) or _INVIS_RX.search(name):
        return True
    if any(ord(c) < 32 for c in name):
        return True
    return name.rsplit("/", 1)[-1].startswith("-")


def _member_structural(arc_name: str, mem: _Member) -> list[Finding]:
    logical = f"{arc_name}!{mem.name}"
    out: list[Finding] = []
    if _arc_unsafe_path(mem.name):
        out.append(Finding(logical, 1, 1, _ARC_SLIP_RULE, mem.name[:120]))
    if _arc_name_deceptive(mem.name):
        out.append(Finding(logical, 1, 1, _ARC_FNAME_RULE, repr(mem.name)[:80]))
    if mem.kind in ("symlink", "hardlink"):
        if _arc_link_escapes(mem.link_target):
            out.append(Finding(logical, 1, 1, _ARC_LINK_ESC_RULE,
                               f"{mem.kind} -> {mem.link_target} (escapes tree)"))
        else:
            out.append(Finding(logical, 1, 1, _ARC_LINK_RULE,
                               f"{mem.kind} -> {mem.link_target}"))
    if mem.kind in ("dev", "fifo"):
        out.append(Finding(logical, 1, 1, _ARC_DEV_RULE, mem.kind))
    if mem.encrypted:
        out.append(Finding(logical, 1, 1, _ARC_ENC_RULE, "encrypted member"))
    if mem.mode and (mem.mode & 0o4000 or mem.mode & 0o2000
                     or ((mem.mode & 0o002) and (mem.mode & 0o111))):
        out.append(Finding(logical, 1, 1, _ARC_PERM_RULE, oct(mem.mode)))
    return out


def _read_member_capped(stream, opts: ArchiveOpts) -> tuple[bytes, tuple, int, bool]:
    md5, sha1, sha256 = hashlib.md5(), hashlib.sha1(), hashlib.sha256()
    buf = bytearray()
    total = 0
    bomb = False
    cap = _HASH_MAX
    try:
        while True:
            chunk = stream.read(65536)
            if not chunk:
                break
            total += len(chunk)
            md5.update(chunk)
            sha1.update(chunk)
            sha256.update(chunk)
            if len(buf) < cap:
                buf.extend(chunk[: cap - len(buf)])
            if total > opts.max_member:
                bomb = True
                break
    finally:
        try:
            stream.close()
        except Exception:
            pass
    return bytes(buf), (md5.hexdigest(), sha1.hexdigest(), sha256.hexdigest()), total, bomb


def _scan_compressed_stream(scanner: "Scanner", src, arc_name: str, kind: str,
                            opts: ArchiveOpts, depth: int,
                            budget: dict) -> tuple[list[Finding], int]:
    """gz/bz2/xz payload: tar inside → _scan_tar; otherwise decompress the single
    plain payload (script.sh.gz, dump.sql.xz, …) capped, and scan its bytes."""
    if isinstance(src, str):
        if _is_tar(src):                      # tar.gz/tbz2/txz: stream from disk
            return _scan_tar(scanner, src, arc_name, opts, depth, budget)
        try:
            with open(src, "rb") as fh:
                data = fh.read(opts.max_member + 1)
        except OSError as e:
            return [Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE, str(e)[:80])], 0
    else:
        data = src.read()
        findings, n = _scan_tar(scanner, io.BytesIO(data), arc_name, opts,
                                depth, budget)
        if not (len(findings) == 1 and findings[0].rule.rid == "ARC-UNSCANNABLE"
                and findings[0].snippet.startswith("bad tar")):
            return findings, n      # it really was a tar (or a real tar error)
    opener = {"gz": lambda b: gzip.GzipFile(fileobj=b),
              "bz2": lambda b: bz2.BZ2File(b),
              "xz": lambda b: lzma.LZMAFile(b)}.get(kind)
    if opener is None:
        return [Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE,
                        f"unknown compression: {kind}")], 0
    inner = re.sub(r"\.(gz|bz2|xz|lzma)$", "", arc_name.rsplit("!", 1)[-1],
                   flags=re.IGNORECASE) or "payload"
    logical = f"{arc_name}!{inner}"
    try:
        with opener(io.BytesIO(data)) as fh:
            raw, dig, real, bomb = _read_member_capped(fh, opts)
    except (OSError, EOFError, lzma.LZMAError, RuntimeError) as e:
        return [Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE, f"bad {kind}: {e}"[:80])], 0
    budget["files"] += 1
    budget["total"] += real
    out: list[Finding] = []
    if bomb:
        out.append(Finding(logical, 1, 1, _ARC_BOMB_RULE, f"member > cap ({real} B)"))
    if real > 1_000_000 and len(data) > 0 and real / len(data) > opts.max_ratio:
        out.append(Finding(logical, 1, 1, _ARC_BOMB_RULE,
                           f"{real / len(data):.0f}x ratio"))
    out += _scan_member_payload(scanner, logical, inner, raw, real, dig,
                                opts, depth, budget)
    return out, real


def _scan_member_payload(scanner: "Scanner", logical: str, member_name: str,
                         raw: bytes, real: int, dig: tuple, opts: ArchiveOpts,
                         depth: int, budget: dict) -> list[Finding]:
    scanner.files_scanned += 1
    scanner.bytes_scanned += real
    out = scanner.scan_bytes(logical, raw, real, dig)
    nested = None
    for magic, k in _ARCHIVE_MAGIC:
        if raw.startswith(magic):
            nested = k
            break
    low = member_name.lower()
    if nested or low.endswith(_ARCHIVE_EXT_HINTS):
        if depth >= opts.max_depth:
            out.append(Finding(logical, 1, 1, _ARC_NESTED_RULE, f"depth > {opts.max_depth}"))
        elif nested == "zip" or low.endswith(_NESTED_ZIP_EXT):
            sub, _ = _scan_zip(scanner, io.BytesIO(raw), logical, opts, depth + 1, budget)
            out += sub
        elif nested in ("gz", "bz2", "xz"):
            sub, _ = _scan_compressed_stream(scanner, io.BytesIO(raw), logical,
                                             nested, opts, depth + 1, budget)
            out += sub
        elif nested == "tar" or low.endswith(_NESTED_TAR_EXT):
            sub, _ = _scan_tar(scanner, io.BytesIO(raw), logical, opts, depth + 1, budget)
            out += sub
        else:
            # rar/7z/zstd/… nested inside zip/tar: scan its members via a temp
            # file + libarchive; fail CLOSED (unscannable) when that is impossible
            out += _scan_nested_blob(scanner, raw, logical, nested, opts,
                                     depth + 1, budget)
    return out


def _scan_nested_blob(scanner: "Scanner", raw: bytes, logical: str,
                      kind: Optional[str], opts: ArchiveOpts,
                      depth: int, budget: dict) -> list[Finding]:
    """Nested binary archive (rar/7z/zstd/lz4/ar/rpm/cpio) extracted from a parent
    member: libarchive needs a real path, so the (already size-capped) bytes go to
    a temp file, get stream-scanned, and the file is erased. No libarchive →
    ARC-UNSCANNABLE, never a silent pass."""
    tmpd = tempfile.mkdtemp(prefix="nemesis_nested_")
    p = os.path.join(tmpd, "blob")
    try:
        with open(p, "wb") as fh:
            fh.write(raw)
        res = _scan_libarchive(scanner, p, logical, opts, depth, budget)
        if res is not None:
            return res
        return [Finding(logical, 1, 1, _ARC_UNSCAN_RULE,
                        f"nested {kind or '?'} archive not scannable in-stream "
                        f"(libarchive unavailable) — blind spot")]
    finally:
        shutil.rmtree(tmpd, ignore_errors=True)


def _scan_zip(scanner: "Scanner", src, arc_name: str, opts: ArchiveOpts,
              depth: int, budget: dict) -> tuple[list[Finding], int]:
    findings: list[Finding] = []
    total_unc = 0
    try:
        zf = zipfile.ZipFile(src)
    except (zipfile.BadZipFile, OSError) as e:
        return [Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE, f"bad zip: {e}")], 0
    with zf:
        for info in zf.infolist():
            mode = (info.external_attr >> 16) & 0xFFFF
            kind = "dir" if info.is_dir() else ("symlink" if stat.S_ISLNK(mode) else "file")
            # a zip symlink stores its TARGET as the member's (small) content —
            # read it so an escaping link is classified ARC-LINK-ESCAPE, not a
            # plain MEDIUM ARC-LINK that auto-passes the gate.
            link_target = ""
            if kind == "symlink" and not (info.flag_bits & 0x1) and info.file_size <= 4096:
                try:
                    link_target = zf.read(info).decode("utf-8", "replace")
                except (zipfile.BadZipFile, OSError, RuntimeError):
                    link_target = ""
            mem = _Member(info.filename, info.file_size, mode & 0o7777, kind,
                          link_target, bool(info.flag_bits & 0x1), info.compress_size)
            structural = _member_structural(arc_name, mem)
            # ARC-ENCRYPTED held back for file members when passwords are supplied:
            # a successful decrypt turns the blind spot into an INFO note instead.
            held_enc = None
            if mem.encrypted and kind == "file" and opts.passwords:
                for i, sf in enumerate(structural):
                    if sf.rule.rid == "ARC-ENCRYPTED":
                        held_enc = structural.pop(i)
                        break
            findings += structural
            total_unc += max(info.file_size, 0)
            if (info.compress_size > 0 and info.file_size > 1_000_000
                    and info.file_size / info.compress_size > opts.max_ratio):
                findings.append(Finding(f"{arc_name}!{info.filename}", 1, 1, _ARC_BOMB_RULE,
                                        f"{info.file_size / info.compress_size:.0f}x ratio"))
            if kind != "file":
                continue
            if mem.encrypted and not opts.passwords:
                continue  # blind spot already reported via ARC-ENCRYPTED (structural)
            budget["files"] += 1
            if budget["files"] > opts.max_files:
                if held_enc is not None:    # member never read → blind spot stands
                    findings.append(held_enc)
                findings.append(Finding(arc_name, 1, 1, _ARC_BOMB_RULE, "too many members"))
                break
            logical = f"{arc_name}!{info.filename}"
            try:
                if mem.encrypted:                       # P11: try supplied passwords
                    raw = dig = None
                    for pw in opts.passwords:
                        try:
                            raw, dig, real, bomb = _read_member_capped(zf.open(info, pwd=pw.encode()), opts)
                            break
                        except (RuntimeError, zipfile.BadZipFile, OSError):
                            raw = None
                    if raw is None:
                        if held_enc is not None:        # wrong password(s) — blind spot stands
                            findings.append(held_enc)
                        continue
                    if held_enc is not None:            # decrypted + scanned: no blind spot
                        findings.append(Finding(held_enc.path, 1, 1, _ARC_ENC_OK_RULE,
                                                "decrypted with supplied password"))
                else:
                    raw, dig, real, bomb = _read_member_capped(zf.open(info), opts)
            except (zipfile.BadZipFile, OSError, RuntimeError) as e:
                findings.append(Finding(logical, 1, 1, _ARC_UNSCAN_RULE, str(e)[:80]))
                continue
            budget["total"] += real
            if bomb:
                findings.append(Finding(logical, 1, 1, _ARC_BOMB_RULE, f"member > cap ({real} B)"))
            if budget["total"] > opts.max_total:
                findings.append(Finding(arc_name, 1, 1, _ARC_BOMB_RULE, "total uncompressed over cap"))
                break
            findings += _scan_member_payload(scanner, logical, info.filename, raw, real, dig,
                                             opts, depth, budget)
    return findings, total_unc


def _scan_tar(scanner: "Scanner", src, arc_name: str, opts: ArchiveOpts,
              depth: int, budget: dict) -> tuple[list[Finding], int]:
    findings: list[Finding] = []
    total_unc = 0
    try:
        tf = tarfile.open(name=src, mode="r:*") if isinstance(src, str) \
            else tarfile.open(fileobj=src, mode="r:*")
    except (tarfile.TarError, OSError) as e:
        return [Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE, f"bad tar: {e}")], 0
    with tf:
        for m in tf.getmembers():
            if m.isdir():
                kind = "dir"
            elif m.issym():
                kind = "symlink"
            elif m.islnk():
                kind = "hardlink"
            elif m.ischr() or m.isblk():
                kind = "dev"
            elif m.isfifo():
                kind = "fifo"
            else:
                kind = "file"
            mem = _Member(m.name, m.size, m.mode & 0o7777, kind, m.linkname or "", False, 0)
            findings += _member_structural(arc_name, mem)
            total_unc += max(m.size, 0)
            if kind != "file":
                continue
            budget["files"] += 1
            if budget["files"] > opts.max_files:
                findings.append(Finding(arc_name, 1, 1, _ARC_BOMB_RULE, "too many members"))
                break
            logical = f"{arc_name}!{m.name}"
            try:
                ex = tf.extractfile(m)
                if ex is None:
                    continue
                raw, dig, real, bomb = _read_member_capped(ex, opts)
            except (tarfile.TarError, OSError, RuntimeError) as e:
                findings.append(Finding(logical, 1, 1, _ARC_UNSCAN_RULE, str(e)[:80]))
                continue
            budget["total"] += real
            if bomb:
                findings.append(Finding(logical, 1, 1, _ARC_BOMB_RULE, f"member > cap ({real} B)"))
            if budget["total"] > opts.max_total:
                findings.append(Finding(arc_name, 1, 1, _ARC_BOMB_RULE, "total uncompressed over cap"))
                break
            findings += _scan_member_payload(scanner, logical, m.name, raw, real, dig,
                                             opts, depth, budget)
    return findings, total_unc


# -- safe extraction (validate-before-write) + always-erase ----------------- #
def _limits_factory(opts: ArchiveOpts):
    def _set():
        try:
            import resource
            resource.setrlimit(resource.RLIMIT_CPU, (120, 120))
            fs = min(opts.max_total, 4 * 1024 * 1024 * 1024)
            resource.setrlimit(resource.RLIMIT_FSIZE, (fs, fs))
        except Exception:
            pass
    return _set


def _within(base: str, target: str) -> bool:
    rt = os.path.realpath(target)
    return rt == base or rt.startswith(base + os.sep)


def _extract_zip_safe(path: str, dest: str, opts: ArchiveOpts) -> bool:
    base = os.path.realpath(dest)
    written = total = 0
    try:
        zf = zipfile.ZipFile(path)
    except (zipfile.BadZipFile, OSError):
        return False
    with zf:
        for info in zf.infolist():
            mode = (info.external_attr >> 16) & 0xFFFF
            if info.is_dir() or stat.S_ISLNK(mode):
                continue
            if _arc_unsafe_path(info.filename):
                continue
            target = os.path.join(dest, info.filename)
            if not _within(base, target):
                continue
            encrypted = bool(info.flag_bits & 0x1)
            if encrypted and not opts.passwords:
                continue
            written += 1
            if written > opts.max_files:
                break
            os.makedirs(os.path.dirname(target) or dest, exist_ok=True)
            # encrypted member: try the supplied passwords (parity with streaming)
            sources = ([lambda pw=pw: zf.open(info, pwd=pw.encode())
                        for pw in opts.passwords] if encrypted
                       else [lambda: zf.open(info)])
            for open_src in sources:
                try:
                    member_bytes = 0
                    with open_src() as srcf, open(target, "wb") as dst:
                        while True:
                            chunk = srcf.read(65536)
                            if not chunk:
                                break
                            total += len(chunk)
                            member_bytes += len(chunk)
                            if total > opts.max_total or member_bytes > opts.max_member:
                                raise RuntimeError("size cap")
                            dst.write(chunk)
                    os.chmod(target, 0o600)
                    break
                except (OSError, RuntimeError, zipfile.BadZipFile):
                    try:
                        os.remove(target)
                    except OSError:
                        pass
                    continue
    return True


def _extract_tar_safe(path: str, dest: str, opts: ArchiveOpts) -> bool:
    base = os.path.realpath(dest)
    written = total = 0
    try:
        tf = tarfile.open(path, "r:*")
    except (tarfile.TarError, OSError):
        return False
    with tf:
        for m in tf.getmembers():
            if not m.isfile() or _arc_unsafe_path(m.name):
                continue
            target = os.path.join(dest, m.name)
            if not _within(base, target):
                continue
            written += 1
            if written > opts.max_files:
                break
            os.makedirs(os.path.dirname(target) or dest, exist_ok=True)
            try:
                srcf = tf.extractfile(m)
                if srcf is None:
                    continue
                member_bytes = 0
                with open(target, "wb") as dst:
                    while True:
                        chunk = srcf.read(65536)
                        if not chunk:
                            break
                        total += len(chunk)
                        member_bytes += len(chunk)
                        if total > opts.max_total or member_bytes > opts.max_member:
                            raise RuntimeError("size cap")
                        dst.write(chunk)
                os.chmod(target, 0o600)
            except (OSError, RuntimeError, tarfile.TarError):
                pass
    return True


def _sanitize_tree(root: str) -> None:
    for dp, dirs, files in os.walk(root):
        for n in list(dirs) + files:
            full = os.path.join(dp, n)
            try:
                if os.path.islink(full):
                    os.unlink(full)
                    continue
                st = os.lstat(full)
                if stat.S_ISREG(st.st_mode):
                    os.chmod(full, st.st_mode & 0o666)
            except OSError:
                pass


_LAST_EXTRACT_TIER = "none"      # records the strongest jail actually used (for provenance)


def _macos_sandbox_profile(dest: str) -> Optional[str]:
    """A sandbox-exec profile: read anywhere, write only under dest+temp, NO network."""
    prof = (
        "(version 1)\n(deny default)\n"
        "(allow process*)\n(allow sysctl-read)\n(allow mach-lookup)\n"
        "(allow file-read*)\n"
        f'(allow file-write* (subpath "{os.path.realpath(dest)}")'
        ' (subpath "/private/tmp") (subpath "/private/var/folders")'
        ' (subpath "/tmp") (literal "/dev/null") (literal "/dev/random")'
        ' (literal "/dev/urandom"))\n'
        "(deny network*)\n"
    )
    try:
        fd, p = tempfile.mkstemp(prefix="nemesis_sbx_", suffix=".sb")
        with os.fdopen(fd, "w") as fh:
            fh.write(prof)
        return p
    except OSError:
        return None


def _jail_cmd(cmd: list, dest: str, mode: str, ro_paths: tuple = ()) -> tuple:
    """Wrap an extractor in the best available OS sandbox (network-denied, FS-scoped).
    `ro_paths` are re-exposed read-only inside the jail — needed because the bwrap
    tmpfs over /tmp would otherwise hide an archive that lives there. Returns
    (wrapped_cmd, tier_name, cleanup_path). Tier 'rlimit' = no OS jail."""
    if mode == "off":
        return cmd, "rlimit", None
    if sys.platform == "darwin" and shutil.which("sandbox-exec"):
        prof = _macos_sandbox_profile(dest)
        if prof:
            return ["sandbox-exec", "-f", prof, *cmd], "sandbox-exec+rlimit", prof
    elif sys.platform.startswith("linux"):
        if shutil.which("bwrap"):
            ro = []
            for p in ro_paths:
                rp = os.path.realpath(p)
                ro += ["--ro-bind", rp, rp]
            return (["bwrap", "--ro-bind", "/", "/", "--dev", "/dev",
                     "--tmpfs", "/tmp", *ro, "--bind", dest, dest,
                     "--unshare-net", "--die-with-parent", *cmd],
                    "bwrap+rlimit", None)
        if shutil.which("firejail"):
            # no --private-tmp: it would hide /tmp-resident archives and dest
            return (["firejail", "--quiet", "--net=none", *cmd],
                    "firejail+rlimit", None)
    return cmd, "rlimit", None


def _extract_cli(path: str, dest: str, opts: ArchiveOpts) -> bool:
    """rar/7z via an external libarchive/7z/unar backend, run with rlimits and —
    when available — an OS sandbox (sandbox-exec / bwrap / firejail) that denies
    network and scopes writes to `dest`. Jailed attempt first, then a plain rlimit
    fallback (unless `--jail on`, which refuses to run unsandboxed)."""
    global _LAST_EXTRACT_TIER
    if shutil.which("bsdtar"):
        base = ["bsdtar", "-x", "--no-same-permissions", "--no-same-owner", "-f", path, "-C", dest]
        pw_flag = "--passphrase"
    elif shutil.which("7z") or shutil.which("7za"):
        base = [shutil.which("7z") or shutil.which("7za"), "x", "-y", "-bd", "-o" + dest, path]
        pw_flag = "-p"
    elif shutil.which("unar"):
        base = ["unar", "-q", "-D", "-o", dest, path]
        pw_flag = "-p"
    else:
        return False

    # passwordless first; then one variant per password (encrypted rar/7z fallback)
    variants: list = [base]
    for pw in getattr(opts, "passwords", ()) or ():
        if pw_flag == "-p" and base[0].endswith(("7z", "7za")):
            variants.append(base + [pw_flag + pw])      # 7z wants -pPASS glued
        else:
            variants.append(base + [pw_flag, pw])

    mode = getattr(opts, "jail", "auto")
    attempts: list = []
    cleanup: Optional[str] = None
    if mode != "off":
        # one jail prefix (one sandbox profile) reused across all variants
        prefix, tier, cleanup = _jail_cmd([], dest, mode, ro_paths=(path,))
        if tier != "rlimit":
            attempts += [(prefix + var, tier) for var in variants]
    if mode == "on" and not attempts:
        return False                       # strict jail requested but none available
    if mode != "on":
        attempts += [(var, "rlimit") for var in variants]  # unjailed fallback

    try:
        for cmd, tier in attempts:
            for entry in os.scandir(dest):       # clean slate per attempt
                (shutil.rmtree if entry.is_dir(follow_symlinks=False)
                 else os.remove)(entry.path)
            try:
                subprocess.run(cmd, timeout=300,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               preexec_fn=_limits_factory(opts) if os.name == "posix" else None)
            except (OSError, subprocess.SubprocessError):
                continue
            # success only if the extractor actually produced something
            if any(os.scandir(dest)):
                _LAST_EXTRACT_TIER = tier
                _sanitize_tree(dest)
                return True
    finally:
        if cleanup:
            try:
                os.remove(cleanup)
            except OSError:
                pass
    return False


def _extract_to(path: str, kind: str, dest: str, opts: ArchiveOpts) -> bool:
    if kind == "zip":
        return _extract_zip_safe(path, dest, opts)
    if kind in ("rar", "7z"):
        return _extract_cli(path, dest, opts)
    if kind in ("gz", "bz2", "xz", "tar", "") or _is_tar(path):
        return _extract_tar_safe(path, dest, opts)
    return False


def _structural_prepass(path: str, kind: str, arc_name: str,
                        opts: ArchiveOpts) -> tuple[list[Finding], bool]:
    findings: list[Finding] = []
    members: list[_Member] = []
    try:
        if kind == "zip":
            with zipfile.ZipFile(path) as zf:
                for info in zf.infolist():
                    mode = (info.external_attr >> 16) & 0xFFFF
                    k = "dir" if info.is_dir() else ("symlink" if stat.S_ISLNK(mode) else "file")
                    lt = ""
                    if k == "symlink" and not (info.flag_bits & 0x1) and info.file_size <= 4096:
                        try:
                            lt = zf.read(info).decode("utf-8", "replace")
                        except (zipfile.BadZipFile, OSError, RuntimeError):
                            lt = ""
                    members.append(_Member(info.filename, info.file_size, mode & 0o7777, k,
                                           lt, bool(info.flag_bits & 0x1), info.compress_size))
        elif kind in ("gz", "bz2", "xz", "tar", "") or _is_tar(path):
            with tarfile.open(path, "r:*") as tf:
                for m in tf.getmembers():
                    if m.isdir():
                        k = "dir"
                    elif m.issym():
                        k = "symlink"
                    elif m.islnk():
                        k = "hardlink"
                    elif m.ischr() or m.isblk():
                        k = "dev"
                    elif m.isfifo():
                        k = "fifo"
                    else:
                        k = "file"
                    members.append(_Member(m.name, m.size, m.mode & 0o7777, k, m.linkname or "", False, 0))
        else:
            # rar/7z & friends: stdlib cannot pre-read, but a libarchive
            # header-only pass can — validate-before-write even unjailed.
            la = _libarchive_headers(path, opts)
            if la is None:
                return findings, False  # no reader: extraction tool's own defaults apply
            members = la
    except (zipfile.BadZipFile, tarfile.TarError, OSError):
        return findings, False
    for mem in members:
        findings += _member_structural(arc_name, mem)
        if (_arc_unsafe_path(mem.name) or mem.kind in ("dev", "fifo")
                or (mem.kind in ("symlink", "hardlink") and _arc_link_escapes(mem.link_target))):
            return findings, True  # extraction-blocking member present
    return findings, False


def _libarchive_headers(path: str, opts: ArchiveOpts) -> Optional[list]:
    """Header-only member listing via libarchive (no data read). None when the
    library is unavailable or the archive cannot be opened."""
    lib = _load_libarchive()
    if lib is None:
        return None
    import ctypes
    a = lib.archive_read_new()
    if not a:
        return None
    lib.archive_read_support_filter_all(a)
    lib.archive_read_support_format_all(a)
    members: list[_Member] = []
    entry = ctypes.c_void_p()
    try:
        if lib.archive_read_open_filename(a, path.encode(), 1 << 16) != 0:
            return None
        for _ in range(opts.max_files + 1):
            r = lib.archive_read_next_header(a, ctypes.byref(entry))
            if r == 1:        # EOF
                break
            if r <= -25:      # FATAL — partial listing is unsafe to trust
                return None
            pn = lib.archive_entry_pathname(entry)
            name = pn.decode("utf-8", "replace") if pn else ""
            ft = lib.archive_entry_filetype(entry) & _AE_IFMT
            kind = ("dir" if ft == _AE_IFDIR
                    else "symlink" if ft == _AE_IFLNK
                    else "dev" if ft in (_AE_IFCHR, _AE_IFBLK)
                    else "fifo" if ft == _AE_IFIFO
                    else "file")
            link = ""
            if kind == "symlink":
                lt = lib.archive_entry_symlink(entry)
                link = lt.decode("utf-8", "replace") if lt else ""
            mode = (int(lib.archive_entry_perm(entry)) & 0o7777
                    if hasattr(lib, "archive_entry_perm") else 0)
            members.append(_Member(name, max(int(lib.archive_entry_size(entry)), 0),
                                   mode, kind, link, False, 0))
            lib.archive_read_data_skip(a)
    except Exception:
        return None
    finally:
        try:
            lib.archive_read_free(a)
        except Exception:
            pass
    return members


def _copy_clean(src: str, dst: str) -> None:
    if os.path.exists(dst):
        shutil.rmtree(dst, ignore_errors=True)

    def _ignore(d, names):
        return [n for n in names if n == "__nemesis_quarantine__" or n.endswith(".nemesis.bak")]

    shutil.copytree(src, dst, ignore=_ignore)


def _scan_via_extract(scanner: "Scanner", path: str, arc_name: str, kind: str,
                      opts: ArchiveOpts) -> list[Finding]:
    findings, blocking = _structural_prepass(path, kind, arc_name, opts)
    if blocking:
        findings.append(Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE,
                                "extraction refused: unsafe members present"))
        scanner.last_archive_disinfection = None
        return findings  # never write a malicious tree to disk
    tmp = tempfile.mkdtemp(prefix="nemesis_extract_")
    disinf = None
    try:
        if not _extract_to(path, kind, tmp, opts):
            findings.append(Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE,
                                    "no safe backend / extraction failed (install libarchive/bsdtar/unar for rar/7z)"))
            return findings
        tree = scanner.scan(tmp)            # disk paths
        if opts.disinfect:
            rem = Remediator(os.path.join(tmp, "__nemesis_quarantine__"), dry_run=False)
            rem.apply(tree)
            residual = scanner.clone().scan(tmp)
            residual_ids = {(f.path, f.rule.rid, f.line) for f in residual}
            resolved = [f for f in tree if (f.path, f.rule.rid, f.line) not in residual_ids]
            disinf = {
                "applied": True,
                "neutralized_lines": len(rem.neutralized),
                "quarantined_files": len(rem.quarantined),
                "resolved_rules": sorted({f.rule.rid for f in resolved}),
                "unresolved_rules": sorted({f.rule.rid for f in residual}),
                "errors": rem.errors[:20],
            }
            if opts.out:
                _copy_clean(tmp, opts.out)
                disinf["output"] = os.path.abspath(opts.out)
            tree = residual                  # report post-disinfection state
        for f in tree:
            f.path = f"{arc_name}!{os.path.relpath(f.path, tmp)}"
        findings += tree
    finally:
        scanner.last_archive_disinfection = disinf
        if opts.keep_extract:
            scanner.last_extract_path = tmp
        else:
            shutil.rmtree(tmp, ignore_errors=True)  # ALWAYS erased, clean or not
    return findings


# -- libarchive (ctypes): in-process rar/7z reader (P11), no external CLI ----- #
_UNSET = object()
_LIBARCHIVE = _UNSET
_AE_IFMT = 0o170000
_AE_IFREG, _AE_IFLNK, _AE_IFDIR = 0o100000, 0o120000, 0o040000
_AE_IFCHR, _AE_IFBLK, _AE_IFIFO = 0o020000, 0o060000, 0o010000


def _load_libarchive():
    global _LIBARCHIVE
    if _LIBARCHIVE is not _UNSET:
        return _LIBARCHIVE
    lib = None
    try:
        import ctypes
        import ctypes.util
        cands = [ctypes.util.find_library("archive")]
        cands += ["libarchive.so.13", "libarchive.so", "libarchive.dylib",
                  "/usr/lib/libarchive.dylib", "archive.dll", "libarchive-13.dll"]
        for c in cands:
            if not c:
                continue
            try:
                lib = ctypes.CDLL(c)
                break
            except OSError:
                continue
        if lib is not None:
            c64, cvp, ccp, ci = ctypes.c_int64, ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int
            lib.archive_read_new.restype = cvp
            lib.archive_entry_pathname.restype = ccp
            lib.archive_entry_pathname.argtypes = [cvp]
            lib.archive_entry_symlink.restype = ccp
            lib.archive_entry_symlink.argtypes = [cvp]
            lib.archive_entry_size.restype = c64
            lib.archive_entry_size.argtypes = [cvp]
            lib.archive_entry_filetype.restype = ctypes.c_uint
            lib.archive_entry_filetype.argtypes = [cvp]
            if hasattr(lib, "archive_entry_perm"):
                lib.archive_entry_perm.restype = ctypes.c_uint
                lib.archive_entry_perm.argtypes = [cvp]
            if hasattr(lib, "archive_entry_hardlink"):
                lib.archive_entry_hardlink.restype = ccp
                lib.archive_entry_hardlink.argtypes = [cvp]
            lib.archive_read_data.restype = ctypes.c_ssize_t
            lib.archive_read_data.argtypes = [cvp, cvp, ctypes.c_size_t]
            lib.archive_read_open_filename.argtypes = [cvp, ccp, ctypes.c_size_t]
            lib.archive_read_next_header.argtypes = [cvp, ctypes.POINTER(cvp)]
            for fn in ("archive_read_support_filter_all", "archive_read_support_format_all",
                       "archive_read_data_skip", "archive_read_free", "archive_read_close"):
                getattr(lib, fn).argtypes = [cvp]
            if hasattr(lib, "archive_read_add_passphrase"):
                lib.archive_read_add_passphrase.argtypes = [cvp, ccp]
            if hasattr(lib, "archive_entry_is_encrypted"):
                lib.archive_entry_is_encrypted.argtypes = [cvp]
    except Exception:
        lib = None
    _LIBARCHIVE = lib
    return lib


def _scan_libarchive(scanner, path, arc_name, opts, depth, budget):
    """Stream rar/7z/etc members via libarchive. Returns findings, or None if the
    library is unavailable or the archive could not be opened (caller falls back)."""
    lib = _load_libarchive()
    if lib is None:
        return None
    import ctypes
    a = lib.archive_read_new()
    if not a:
        return None
    lib.archive_read_support_filter_all(a)
    lib.archive_read_support_format_all(a)
    if hasattr(lib, "archive_read_add_passphrase"):
        for pw in opts.passwords:
            try:
                lib.archive_read_add_passphrase(a, pw.encode())
            except Exception:
                pass
    findings: list[Finding] = []
    bufsize = 1 << 16
    buf = ctypes.create_string_buffer(bufsize)
    entry = ctypes.c_void_p()
    truncated = False        # broke out before EOF due to a libarchive error → fail-closed
    try:
        if lib.archive_read_open_filename(a, path.encode(), bufsize) != 0:
            return None  # cannot open (e.g. encrypted 7z header) → let caller fall back
        while True:
            r = lib.archive_read_next_header(a, ctypes.byref(entry))
            if r == 1:            # ARCHIVE_EOF
                break
            if r <= -25:          # ARCHIVE_FAILED / FATAL — archive ends here unscanned
                truncated = True
                break
            pn = lib.archive_entry_pathname(entry)
            name = pn.decode("utf-8", "replace") if pn else ""
            ft = lib.archive_entry_filetype(entry) & _AE_IFMT
            size = max(int(lib.archive_entry_size(entry)), 0)
            kind = ("dir" if ft == _AE_IFDIR
                    else "symlink" if ft == _AE_IFLNK
                    else "dev" if ft in (_AE_IFCHR, _AE_IFBLK)
                    else "fifo" if ft == _AE_IFIFO
                    else "file")
            link = ""
            if kind == "symlink":
                lt = lib.archive_entry_symlink(entry)
                link = lt.decode("utf-8", "replace") if lt else ""
            elif kind == "file" and hasattr(lib, "archive_entry_hardlink"):
                hl = lib.archive_entry_hardlink(entry)
                if hl:
                    kind = "hardlink"
                    link = hl.decode("utf-8", "replace")
            mode = (int(lib.archive_entry_perm(entry)) & 0o7777
                    if hasattr(lib, "archive_entry_perm") else 0)
            enc = bool(lib.archive_entry_is_encrypted(entry)) if hasattr(lib, "archive_entry_is_encrypted") else False
            findings += _member_structural(arc_name, _Member(name, size, mode, kind, link, enc, 0))
            if kind != "file" or (enc and not opts.passwords):
                lib.archive_read_data_skip(a)
                continue
            budget["files"] += 1
            if budget["files"] > opts.max_files:
                findings.append(Finding(arc_name, 1, 1, _ARC_BOMB_RULE, "too many members"))
                break
            md5, sha1, sha256 = hashlib.md5(), hashlib.sha1(), hashlib.sha256()
            raw = bytearray()
            total = 0
            bomb = False
            read_err = False
            while True:
                n = lib.archive_read_data(a, buf, bufsize)
                if n < 0:            # decompression error → member tail unread (fail-closed)
                    read_err = True
                    break
                if n == 0:           # end of this member's data
                    break
                seg = buf.raw[:n]
                total += n
                md5.update(seg)
                sha1.update(seg)
                sha256.update(seg)
                if len(raw) < _HASH_MAX:
                    raw.extend(seg[: _HASH_MAX - len(raw)])
                if total > opts.max_member:
                    bomb = True
                    break
            logical = f"{arc_name}!{name}"
            budget["total"] += total
            if read_err:
                findings.append(Finding(logical, 1, 1, _ARC_UNSCAN_RULE,
                                        "member read error — content only partially scanned"))
            if bomb:
                findings.append(Finding(logical, 1, 1, _ARC_BOMB_RULE, f"member > cap ({total} B)"))
            if budget["total"] > opts.max_total:
                findings.append(Finding(arc_name, 1, 1, _ARC_BOMB_RULE, "total uncompressed over cap"))
                break
            findings += _scan_member_payload(
                scanner, logical, name, bytes(raw), total,
                (md5.hexdigest(), sha1.hexdigest(), sha256.hexdigest()), opts, depth, budget)
        if truncated:
            # libarchive bailed mid-archive: any members past this point were never
            # inspected. Match the zip/tar readers — surface a fail-closed blind spot
            # instead of silently returning a (possibly clean-looking) partial result.
            findings.append(Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE,
                                    "libarchive aborted before end-of-archive — archive only partially scanned"))
    finally:
        try:
            lib.archive_read_free(a)
        except Exception:
            pass
    return findings


def scan_archive(scanner: "Scanner", path: str, opts: ArchiveOpts) -> list[Finding]:
    """Top-level archive scan. Returns findings; sets scanner.last_archive_disinfection."""
    arc_name = os.path.basename(path)
    kind = detect_archive(path) or ""
    scanner.last_archive_disinfection = None
    budget = {"total": 0, "files": 0}
    if opts.disinfect or opts.sandbox == "extract":
        return _scan_via_extract(scanner, path, arc_name, kind, opts)

    def _total_ratio_check(findings: list, total_unc: int) -> list:
        try:
            csize = os.path.getsize(path)
        except OSError:
            return findings
        if csize > 0 and total_unc > 10_000_000 and total_unc / csize > opts.max_ratio:
            findings.append(Finding(arc_name, 1, 1, _ARC_BOMB_RULE,
                                    f"{total_unc / csize:.0f}x total expansion"))
        return findings

    if kind == "zip":
        findings, total_unc = _scan_zip(scanner, path, arc_name, opts, 0, budget)
        return _total_ratio_check(findings, total_unc)
    if kind in ("gz", "bz2", "xz"):
        # may be tar.gz/tbz2/txz OR a plain compressed payload (script.sh.gz)
        findings, total_unc = _scan_compressed_stream(scanner, path, arc_name, kind,
                                                      opts, 0, budget)
        return _total_ratio_check(findings, total_unc)
    if kind == "tar" or _is_tar(path):
        findings, total_unc = _scan_tar(scanner, path, arc_name, opts, 0, budget)
        return _total_ratio_check(findings, total_unc)
    if kind in _LIBARCHIVE_KINDS:
        # P11: stream in-process via libarchive (no CLI). Fall back to CLI extract —
        # unless --sandbox stream demands no disk write, which then fails closed.
        res = _scan_libarchive(scanner, path, arc_name, opts, 0, budget)
        if res is not None:
            return res
        if opts.sandbox == "stream":
            return [Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE,
                            f"--sandbox stream: libarchive unavailable for {kind}, "
                            f"refusing disk extraction")]
        return _scan_via_extract(scanner, path, arc_name, kind, opts)
    # unknown: try libarchive (it reads many formats), then extract, then unscannable.
    # `is not None` (not truthiness): a libarchive scan that found nothing returns an
    # empty list — that is a clean result, not a reason to fall through to "unscannable".
    res = _scan_libarchive(scanner, path, arc_name, opts, 0, budget)
    if res is not None:
        return res
    if opts.sandbox == "stream":
        return [Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE,
                        "--sandbox stream: no in-process reader for this format, "
                        "refusing disk extraction")]
    if not opts.allow_unscannable and not os.path.isdir(path):
        return [Finding(arc_name, 1, 1, _ARC_UNSCAN_RULE, f"unsupported archive kind: {kind or 'unknown'}")]
    return _scan_via_extract(scanner, path, arc_name, kind, opts)


_TREE_ARCHIVE_CAP = 40
_TREE_ARCHIVE_EXTS = _ARCHIVE_EXT_HINTS + (".gz", ".bz2", ".xz", ".tbz", ".lzma")


def scan_tree_archives(scanner: "Scanner", root: str,
                       opts: ArchiveOpts) -> list[Finding]:
    """Open archives found INSIDE a scanned directory tree and scan their
    members — a vendored payload.zip is a classic repo-malware hiding spot.
    Read-only: disinfection/extraction options are stripped for the inner scans."""
    inner_opts = replace(opts, disinfect=False, out=None, keep_extract=False)
    saved_disinf = scanner.last_archive_disinfection
    out: list[Finding] = []
    n = 0
    for path in scanner._iter_files(root):
        if not path.lower().endswith(_TREE_ARCHIVE_EXTS):
            continue
        if detect_archive(path) is None:
            continue
        n += 1
        if n > _TREE_ARCHIVE_CAP:
            out.append(Finding(root, 1, 1, _ARC_NESTED_RULE,
                               f"tree holds > {_TREE_ARCHIVE_CAP} archives — "
                               f"remainder not opened (scan them directly)"))
            break
        rel = os.path.relpath(path, root)
        base = os.path.basename(path)
        for f in scan_archive(scanner, path, inner_opts):
            # scan_archive labels findings with the archive basename; re-anchor
            # them to the tree-relative path so the report points into the tree.
            if f.path == base or f.path.startswith(base + "!"):
                f.path = rel + f.path[len(base):]
            out.append(f)
    scanner.last_archive_disinfection = saved_disinf
    return out


