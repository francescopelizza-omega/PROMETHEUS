def _shannon_entropy(data: bytes) -> float:
    if not data:
        return 0.0
    counts = [0] * 256
    for b in data:
        counts[b] += 1
    n = len(data)
    ent = 0.0
    for cnt in counts:
        if cnt:
            p = cnt / n
            ent -= p * math.log2(p)
    return ent  # bits/byte, 0..8


# -- Python AST SAST (precise) ---------------------------------------------- #
_SECRET_NAME_RX = re.compile(r"(?i)(secret|password|passwd|api[_-]?key|access[_-]?token|auth[_-]?token)")


def _ast_dotted(node) -> str:
    parts = []
    while isinstance(node, ast.Attribute):
        parts.append(node.attr)
        node = node.value
    if isinstance(node, ast.Name):
        parts.append(node.id)
    return ".".join(reversed(parts))


def _scan_python_ast(name: str, text: str) -> list[Finding]:
    out: list[Finding] = []
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError, RecursionError, MemoryError):
        return out  # not valid Python (or too deep) — regex pass already ran
    src = text.splitlines()

    def snip(node) -> str:
        ln = getattr(node, "lineno", 0)
        return src[ln - 1].strip()[:200] if 0 < ln <= len(src) else ""

    def col(node) -> int:
        return (getattr(node, "col_offset", 0) or 0) + 1

    for node in ast.walk(tree):
        if isinstance(node, ast.Call):
            fn = _ast_dotted(node.func)
            if fn in ("subprocess.run", "subprocess.Popen", "subprocess.call",
                      "subprocess.check_output", "subprocess.check_call"):
                shell_true = any(k.arg == "shell" and isinstance(k.value, ast.Constant)
                                 and k.value.value is True for k in node.keywords)
                cmd0 = node.args[0] if node.args else None
                if shell_true and cmd0 is not None and not isinstance(cmd0, ast.Constant):
                    out.append(Finding(name, node.lineno, col(node), _AST_SHELL_RULE, snip(node)))
            elif fn in ("os.system", "os.popen", "subprocess.getoutput",
                        "subprocess.getstatusoutput", "getoutput", "getstatusoutput",
                        "commands.getoutput", "commands.getstatusoutput"):
                # These always run the argument through a shell. A non-constant arg means
                # the command was assembled at runtime — OS command injection, and the way
                # a 'curl URL | sh' dropper is split across variables to dodge line-regex.
                cmd0 = node.args[0] if node.args else None
                if cmd0 is not None and not isinstance(cmd0, ast.Constant):
                    out.append(Finding(name, node.lineno, col(node), _AST_OSCMD_RULE, snip(node)))
            elif fn in ("eval", "exec", "compile") and node.args and not isinstance(node.args[0], ast.Constant):
                out.append(Finding(name, node.lineno, col(node), _AST_EVAL_RULE, snip(node)))
            elif fn in ("pickle.loads", "pickle.load", "cPickle.loads", "cPickle.load",
                        "marshal.loads", "marshal.load"):
                out.append(Finding(name, node.lineno, col(node), _AST_DESERIAL_RULE, snip(node)))
            elif fn == "yaml.load" and not any(k.arg in ("Loader", "SafeLoader") for k in node.keywords):
                out.append(Finding(name, node.lineno, col(node), _AST_DESERIAL_RULE, snip(node)))
        elif isinstance(node, ast.Assign):
            for tgt in node.targets:
                tname = (tgt.id if isinstance(tgt, ast.Name)
                         else tgt.attr if isinstance(tgt, ast.Attribute) else "")
                if (tname and _SECRET_NAME_RX.search(tname)
                        and isinstance(node.value, ast.Constant)
                        and isinstance(node.value.value, str) and len(node.value.value) >= 8):
                    out.append(Finding(name, node.lineno, col(node), _AST_SECRET_RULE, snip(node)))
                    break
    return out


# -- decode-and-recurse ----------------------------------------------------- #
# Bounded so the match is a STANDALONE token, not a 40-char slice of a longer alnum run
# (a JWT, a git OID list, a minified-JS identifier) — which otherwise produced spurious
# blob decodes / opaque flags.
_B64_TXT_RX = re.compile(r"(?<![A-Za-z0-9+/=])[A-Za-z0-9+/]{40,}={0,2}(?![A-Za-z0-9+/])")
_HEX_TXT_RX = re.compile(r"(?:[0-9a-fA-F]{2}){20,}")
_B32_TXT_RX = re.compile(r"\b(?:[A-Z2-7]{8}){4,}={0,6}\b")
_DECODE_MAX_DEPTH = 2
_DECODE_MAX_BLOBS = 6
_DECODE_MAX_BYTES = 4 * 1024 * 1024


def _maybe_decompress(data: bytes) -> bytes:
    try:
        if data[:2] == b"\x1f\x8b":
            return gzip.decompress(data)[:_DECODE_MAX_BYTES]
        if data[:1] == b"\x78":  # zlib
            return zlib.decompress(data)[:_DECODE_MAX_BYTES]
    except (OSError, zlib.error, EOFError):
        pass
    return data


# -- short base64 (CLI-041): catch sub-40-char b64 payloads that slip the {40,} floor.
#    A SEPARATE regex + a strict entropy/charset/decode gate — do NOT lower _B64_TXT_RX's floor
#    (shared by 4 call sites; a naive drop floods clean repos with FPs from identifiers/hashes).
_B64_SHORT_RX = re.compile(r"(?<![A-Za-z0-9+/=])[A-Za-z0-9+/]{24,39}={0,2}(?![A-Za-z0-9+/])")
_HEX_ONLY_RX = re.compile(r"\A[0-9a-fA-F]+\Z")
_SHORT_B64_ENTROPY_FLOOR = 4.2  # hex(≤4.0 bits/char) below; base64 URLs (~4.5+) above → FP firewall


def _short_b64_decode(s: str) -> bytes:
    """Gate + decode a SHORT (24-39 char) base64 candidate. RAISES ValueError to reject anything
    that is not a genuine encoded payload — a git SHA / MD5 / SHA256 hex hash (single-case, hex
    charset), a UUID segment, or a low-entropy identifier — so the shared decode loop's existing
    `except (binascii.Error, ValueError)` skips it and the clean-repo delta stays 0. Returns the
    decoded bytes ONLY for a high-entropy, mixed-case-plus-digit run (what real base64 looks like)."""
    run = s.rstrip("=")
    if len(run) % 4 == 1:                       # 1 (mod 4) is never a valid base64 length
        raise ValueError("bad b64 length")
    if _HEX_ONLY_RX.match(run):                 # git SHA / MD5 / SHA256 hex — never base64
        raise ValueError("hex, not b64")
    if not (any(c.islower() for c in run) and any(c.isupper() for c in run)
            and any(c.isdigit() for c in run)):
        raise ValueError("not mixed-case+digit")  # single-case hash / lowercase identifier
    if _shannon_entropy(run.encode()) < _SHORT_B64_ENTROPY_FLOOR:
        raise ValueError("entropy too low")
    padded = run + "=" * (-len(run) % 4)        # re-pad an unpadded run before validate=True decode
    data = base64.b64decode(padded, validate=True)  # raises binascii.Error on any junk char
    if not data or len(data) > _DECODE_MAX_BYTES:
        raise ValueError("empty/oversized decode")
    return data


# -- inline deobfuscation: turn encoded source back into readable text so the
#    rule engine sees the real payload. Attackers hide keywords (eval, /dev/tcp,
#    require) behind char-code arrays, \x / \u escapes and string-concat splits;
#    each variant below is re-scanned with the full ruleset. -----------------
_CHARCODE_RX = re.compile(r"fromCharCode\s*\(([0-9a-fA-FxX,\s+]{8,})\)")
_NUMARR_RX = re.compile(r"\[\s*((?:0[xX][0-9a-fA-F]{1,4}|\d{1,7})"
                        r"(?:\s*,\s*(?:0[xX][0-9a-fA-F]{1,4}|\d{1,7})){7,})\s*\]")
_HEXESC_RX = re.compile(r"(?:\\x[0-9a-fA-F]{2}){4,}")
_UNIESC_RX = re.compile(r"(?:\\u[0-9a-fA-F]{4}){4,}")
_CHRJOIN_RX = re.compile(r"(?:chr\(\s*\d{1,7}\s*\)\s*\+?\s*){4,}")
_DEOBF_MAX_VARIANTS = 12


def _nums_to_text(blob: str) -> str:
    out = []
    for tok in re.split(r"[,\s+]+", blob.strip()):
        if not tok:
            continue
        try:
            n = int(tok, 16) if tok.lower().startswith("0x") else int(tok)
        except ValueError:
            return ""
        if 0 <= n <= 0x10FFFF:
            out.append(chr(n))
        if len(out) > _DECODE_MAX_BYTES:
            break
    return "".join(out)


def _deobf_variants(text: str):
    """Yield (tag, decoded_text) for each obfuscation primitive found in `text`."""
    n = 0
    # 1) String.fromCharCode(72,101,...) and bare numeric arrays [72,101,...]
    for rx, tag in ((_CHARCODE_RX, "charcode"), (_NUMARR_RX, "numarray")):
        for m in rx.finditer(text):
            if n >= _DEOBF_MAX_VARIANTS:
                return
            dec = _nums_to_text(m.group(1))
            if len(dec) >= 6 and sum(c.isprintable() for c in dec) > len(dec) * 0.7:
                n += 1
                yield tag, dec
    # 2) \xHH and \uHHHH escape runs
    for rx, tag in ((_HEXESC_RX, "hexesc"), (_UNIESC_RX, "uniesc")):
        for m in rx.finditer(text):
            if n >= _DEOBF_MAX_VARIANTS:
                return
            try:
                dec = m.group(0).encode("ascii").decode("unicode_escape")
            except (UnicodeDecodeError, ValueError):
                continue
            if len(dec) >= 4:
                n += 1
                yield tag, dec
    # 3) Python chr(110)+chr(101)+... joins
    for m in _CHRJOIN_RX.finditer(text):
        if n >= _DEOBF_MAX_VARIANTS:
            return
        dec = _nums_to_text(re.sub(r"chr\(|\)|\+", " ", m.group(0)))
        if len(dec) >= 4:
            n += 1
            yield "chrjoin", dec
    # 4) string-concat splitting: 'ev'+'al' -> 'eval', "req"+"uire" -> "require",
    #    and mixed-quote splits: 'ev'+"al" / "ev"+'al'
    collapsed = re.sub(r"['\"]\s*\+\s*['\"]", "", text)
    if collapsed != text and n < _DEOBF_MAX_VARIANTS:
        yield "concat", collapsed


# -- L0: URL extraction & normalization (URL-injection safeguard) ----------- #
# Find every URL the agent could dereference, including ones hidden behind
# de-obfuscation primitives or base64/hex blobs, and classify the syntactic
# context (exec / config / comment / doc) so later layers can weight by how the
# agent would use it. Pure-offline; reuses the de-obf + decode machinery above.
@dataclass
class URLRef:
    url: str
    host: str
    context_kind: str            # exec | config | comment | doc
    decoded_from: str            # "" = literal, else a tag (charcode/b64/hex/concat/…)
    line: int                    # 1-based; 0 when only known post-decode

    def to_dict(self) -> dict:
        return {"url": self.url, "host": self.host, "context_kind": self.context_kind,
                "decoded_from": self.decoded_from, "line": self.line}


# Tokens that mean "a program will FETCH and very likely ACT on this URL" — the
# high-impact exec context (curl|bash, package installs, agent HTTP fetchers).
_EXEC_CTX_RX = re.compile(
    r"(curl|wget|fetch\b|fetch\(|iwr\b|invoke-webrequest|requests\.get|urlopen|"
    r"urlretrieve|http\.get|https\.get|axios|got\(|\bnpx?\s+install|pip\s+install|"
    r"npm\s+install|yarn\s+add|pnpm\s+add|go\s+get|gem\s+install|add-apt-repository|"
    r"git\s+clone|source\s*<|\|\s*(ba|z|da)?sh\b|>\s*\S+\s*&&)", re.I)
_COMMENT_PREFIX_RX = re.compile(r"^\s*(#|//|/\*|\*|--|;|<!--|\"\"\"|''')")
_URL_CTX_CONFIG_EXTS = {".json", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".env",
                        ".conf", ".lock", ".properties"}
# A mangled scheme that survives obfuscation — "h t t p://", "h.t.t.p : / /" …
# REQUIRES the "://" authority marker (with small gaps): the old version made the
# colon optional, so an "h..t..t..p" run in random decoded bytes matched and flagged a
# benign base64/hex blob as URL-OPAQUE (clean file → warn). A real obfuscated URL keeps
# its "://".
_OPAQUE_SCHEME_RX = re.compile(r"h\W{0,2}t\W{0,2}t\W{0,2}p\W{0,2}s?\W{0,2}:\W{0,2}/\W{0,2}/", re.I)
_URL_EXTRACT_CAP = 256           # bound the per-file URLRef list


def _classify_url_ctx(line_text: str, ext: str) -> str:
    if _EXEC_CTX_RX.search(line_text):
        return "exec"
    if _COMMENT_PREFIX_RX.match(line_text):
        return "comment"
    if ext in _URL_CTX_CONFIG_EXTS:
        return "config"
    return "doc"


def _extract_urls(text: str, ext: str = "") -> tuple[list[URLRef], int]:
    """Return (urlrefs, opaque_count).

    urlrefs   — every dereferenceable URL: literal, plus any surfaced by the
                de-obf variants and by base64/hex blob decoding.
    opaque    — count of encoded blobs that decoded to a URL *scheme fragment*
                but not to a parseable URL (→ a synthetic URL-OPAQUE finding, so
                "could not fully decode" never silently means "nothing here")."""
    refs: list[URLRef] = []
    seen: set[str] = set()
    lines = text.split("\n")

    def _line_no(pos: int) -> int:
        return text.count("\n", 0, pos) + 1

    def _add(url: str, ctx: str, tag: str, line: int) -> None:
        url = url.rstrip(".,;:)\"']}")
        if not url or url in seen or len(refs) >= _URL_EXTRACT_CAP:
            return
        seen.add(url)
        refs.append(URLRef(url, _url_host(url), ctx, tag, line))

    # 1) literal URLs, with syntactic context from their own line
    for m in _URL_SCAN_RX.finditer(text):
        ln = _line_no(m.start())
        line_text = lines[ln - 1] if 0 <= ln - 1 < len(lines) else ""
        _add(m.group(0), _classify_url_ctx(line_text, ext), "", ln)

    # 2) URLs revealed by de-obfuscation (charcode arrays, \x/\u escapes, concat)
    #    — anything an attacker assembled at runtime is treated as exec context.
    for tag, dec in _deobf_variants(text):
        for m in _URL_SCAN_RX.finditer(dec):
            _add(m.group(0), "exec", tag, 0)

    # 3) base64 / hex blobs: decode → real URLs, or flag as opaque when a scheme
    #    fragment survives but no clean URL can be recovered.
    opaque = 0
    decoders = (
        (_B64_TXT_RX, lambda s: base64.b64decode(s, validate=True), "b64"),
        (_B64_SHORT_RX, _short_b64_decode, "b64"),  # CLI-041: sub-40-char b64 URLs → URL fusion
        (_HEX_TXT_RX, binascii.unhexlify, "hex"),
    )
    tried = 0
    for rx, dec_fn, tag in decoders:
        for m in rx.finditer(text):
            if tried >= _DECODE_MAX_BLOBS:
                break
            try:
                data = dec_fn(m.group(0))
            except (binascii.Error, ValueError):
                continue
            if not data or len(data) > _DECODE_MAX_BYTES:
                continue
            tried += 1
            sdec = _maybe_decompress(data).decode("utf-8", "replace")
            hits = list(_URL_SCAN_RX.finditer(sdec))
            if hits:
                for mm in hits:
                    _add(mm.group(0), "exec", tag, _line_no(m.start()))
            elif _OPAQUE_SCHEME_RX.search(sdec):
                opaque += 1
    return refs, opaque


# -- binary strings triage (P9b) -------------------------------------------- #
_BIN_EXTS = {".so", ".dylib", ".exe", ".dll", ".bin", ".o", ".node", ".a", ".out"}
_BIN_TRIAGE_CATEGORIES = {"reverse_shell", "dropper", "exfiltration", "miner", "ioc",
                          "persistence"}


def _printable_strings(data: bytes, min_len: int = 6, cap: int = 4_000_000) -> str:
    out: list[str] = []
    cur = bytearray()
    for b in data[:cap]:
        if 32 <= b < 127:
            cur.append(b)
        else:
            if len(cur) >= min_len:
                out.append(cur.decode("ascii", "ignore"))
            cur = bytearray()
    if len(cur) >= min_len:
        out.append(cur.decode("ascii", "ignore"))
    return "\n".join(out)


# -- external engines (P9c): clamscan / yara, auto-used when present --------- #
# Standard ClamAV signature-DB locations (apt / homebrew / source installs). Used
# only to fingerprint the DB version for cache invalidation — exotic locations are
# not tracked (a freshclam there won't invalidate, documented in _ext_engine_db_sig).
_CLAMAV_DB_DIRS = (
    "/var/lib/clamav", "/usr/local/var/lib/clamav", "/opt/homebrew/var/lib/clamav",
    "/usr/share/clamav", "/usr/local/share/clamav",
)


def _ext_engine_db_sig(cfg: dict) -> str:
    """Short fingerprint of the *external* engine signature DBs (clamscan/yara), so a
    `freshclam` / yara-rules update invalidates a cached verdict — on a cache hit the
    engines are not re-run, so the cached result must be keyed to their DB state.
    Stat-only (no subprocess) to keep the gate hot path fast. Returns "" when no engine
    is present, so systems without clamscan/yara see no extra cache churn."""
    parts: list[str] = []
    if shutil.which("clamscan"):
        dirs = list(_CLAMAV_DB_DIRS)
        env_dir = os.environ.get("CLAMAV_DBDIR")
        if env_dir:
            dirs.insert(0, env_dir)
        for dd in dirs:
            try:
                names = sorted(os.listdir(dd))
            except OSError:
                continue
            for fn in names:
                if fn.endswith((".cvd", ".cld", ".cud", ".ndb", ".ldb", ".hdb", ".hsb")):
                    try:
                        st = os.stat(os.path.join(dd, fn))
                    except OSError:
                        continue
                    parts.append(f"{fn}:{st.st_size}:{int(st.st_mtime)}")
    yrules = cfg.get("yara_rules") or _default_yara_rules()
    if yrules and shutil.which("yara"):
        try:
            st = os.stat(yrules)
            parts.append(f"yara:{st.st_size}:{int(st.st_mtime)}")
        except OSError:
            pass
    if not parts:
        return ""
    return hashlib.sha256("|".join(parts).encode()).hexdigest()[:12]


def _default_yara_rules() -> Optional[str]:
    """db/yara/yarahub.yar when the yarahub feed has been pulled (no config needed)."""
    p = os.path.join(_DEFAULT_DB_DIR, "yara", "yarahub.yar")
    return p if os.path.exists(p) else None


def _engine_findings(root: str, cfg: dict) -> list[Finding]:
    out: list[Finding] = []
    if shutil.which("clamscan"):
        cmd = (["clamscan", "-r", "--no-summary", "--infected", root]
               if os.path.isdir(root) else
               ["clamscan", "--no-summary", "--infected", root])
        try:
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
            for line in p.stdout.splitlines():
                if line.rstrip().endswith("FOUND"):
                    path, _, sig = line.rpartition(":")
                    out.append(Finding(path.strip() or root, 1, 1, _CLAMAV_RULE,
                                       sig.replace("FOUND", "").strip()))
        except (OSError, subprocess.SubprocessError):
            pass
    yrules = cfg.get("yara_rules") or _default_yara_rules()
    if yrules and os.path.exists(yrules) and shutil.which("yara"):
        try:
            p = subprocess.run(["yara", "-r", "-w", yrules, root],
                               capture_output=True, text=True, timeout=900)
            for line in p.stdout.splitlines():
                rule_name, _, path = line.partition(" ")
                if rule_name and path:
                    out.append(Finding(path.strip(), 1, 1, _YARA_RULE, rule_name.strip()))
        except (OSError, subprocess.SubprocessError):
            pass
    return out


